---
/**
 * Komponen: LargeOrderNotice
 * Callout notifikasi elegan ketika pemesanan melebihi kapasitas standar (>500 box).
 * Menyediakan tombol CTA langsung ke WhatsApp Admin katering tanpa dialog browser yang kaku.
 */

import { waPhoneNumber } from '../../data/company.ts';
import { buildLargeOrderWhatsAppUrl } from '../../services/whatsapp/largeOrderMessage.ts';

interface Props {
  id: string;
  linkId: string;
  defaultPackageName?: string;
  ctaText?: string;
  customClass?: string;
}

const {
  id,
  linkId,
  defaultPackageName = 'Katering Dzanis',
  ctaText = 'Tanya Admin via WhatsApp (>500 Box)',
  customClass = '',
} = Astro.props;

const defaultWaUrl = buildLargeOrderWhatsAppUrl(waPhoneNumber, {
  packageName: defaultPackageName,
});
---

<div
  id={id}
  class={`hidden rounded-2xl border border-amber-300 bg-amber-50/95 p-3.5 sm:p-4 text-amber-950 shadow-2xs transition-all ${customClass}`}
  role="alert"
  aria-live="polite"
>
  <div class="flex items-start gap-3">
    <div
      class="flex size-9 flex-none items-center justify-center rounded-xl bg-amber-200/80 text-amber-900 shadow-2xs"
      aria-hidden="true"
    >
      <svg class="size-5 text-amber-800 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
    </div>

    <div class="flex-1 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h4 class="text-xs sm:text-sm font-bold text-amber-950">
          Pemesanan Skala Besar (&gt;500 Box)
        </h4>
        <span class="inline-flex items-center rounded-full bg-amber-200/90 px-2.5 py-0.5 text-[11px] font-semibold text-amber-900">
          Layanan Khusus
        </span>
      </div>

      <p class="text-xs sm:text-sm text-amber-900/90 leading-relaxed">
        Untuk pesanan di atas 500 box, silakan langsung konsultasikan dengan Admin katering kami via WhatsApp agar jadwal produksi dapur dan penawaran harga khusus dapat disiapkan dengan optimal.
      </p>

      <div class="pt-1">
        <a
          id={linkId}
          href={defaultWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:bg-accent-700 transition-colors touch-manipulation focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <svg class="size-4.5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span>{ctaText}</span>
        </a>
      </div>
    </div>
  </div>
</div>
