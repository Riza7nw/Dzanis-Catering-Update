---
import { waPhoneNumber } from "../../data/company";
import PetaPicker from "./PetaPicker.astro";

interface Props {
  phoneNumber?: string;
}

const { phoneNumber = waPhoneNumber } = Astro.props;
---

<dialog
  id="order-modal"
  data-phone={phoneNumber}
  class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-lg rounded-[var(--radius-lg)] border border-[var(--color-divider)] bg-[var(--color-bg)] p-0 text-[var(--color-text)] shadow-[var(--shadow-lg)] backdrop:bg-black/50 backdrop:blur-sm focus:outline-none max-h-[92vh] overflow-y-auto dz-scroll"
>
  <div class="relative flex flex-col p-5 sm:p-7">
    <!-- Header -->
    <div
      class="flex items-start justify-between border-b border-[var(--color-divider)] pb-4"
    >
      <div>
        <h3 class="m-0 font-heading text-2xl leading-tight text-neutral-900">
          Form Pemesanan
        </h3>
        <p class="mt-1 text-sm text-neutral-900">
          Lengkapi data untuk membuat format pemesanan WhatsApp otomatis.
        </p>
      </div>
      <button
        type="button"
        id="modal-close-icon"
        class="inline-flex size-8 items-center justify-center rounded-full text-neutral-900 hover:bg-neutral-200 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-accent cursor-pointer"
        aria-label="Tutup form"
      >
        <svg
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Form -->
    <form id="order-form" method="dialog" class="mt-5 flex flex-col gap-4">
      <!-- Paket Terpilih -->
      <div class="rounded-[var(--radius-md)] bg-[var(--color-surface)] p-3.5">
        <label
          class="block text-xs font-semibold uppercase tracking-wider text-neutral-900"
        >
          Paket Terpilih
        </label>
        <div
          id="display-package-name"
          class="mt-0.5 font-heading text-lg font-bold text-accent-700"
        >
          Snack Box Dzanis
        </div>
        <div
          id="display-custom-details"
          class="mt-2 text-xs text-neutral-700 bg-white/80 p-2.5 rounded-lg border border-neutral-200 hidden whitespace-pre-line leading-relaxed font-sans"
        ></div>
        <input
          type="hidden"
          name="packageName"
          id="input-package-name"
          value="Snack Box Dzanis"
        />
        <input
          type="hidden"
          name="customDetails"
          id="input-custom-details"
          value=""
        />
      </div>

      <!-- Nama Pemesan -->
      <div>
        <label
          for="customer-name"
          class="block text-sm font-semibold text-neutral-900"
        >
          Nama Pemesan <span class="text-accent">*</span>
        </label>
        <input
          type="text"
          id="customer-name"
          name="customerName"
          required
          placeholder="Contoh: Ibu Rina / Bpk. Hendra"
          class="mt-1.5 w-full rounded-xl border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
        />
      </div>

      <!-- Grid: Tanggal Acara & Jumlah Porsi -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label
            for="event-date"
            class="block text-sm font-semibold text-neutral-900"
          >
            Tanggal Acara <span class="text-accent">*</span>
          </label>
          <input
            type="date"
            id="event-date"
            name="eventDate"
            required
            class="mt-1.5 w-full rounded-xl border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
          />
        </div>

        <div>
          <label
            for="portion-count"
            class="block text-sm font-semibold text-neutral-900"
          >
            Jumlah Porsi (box) <span class="text-accent">*</span>
          </label>
          <input
            type="number"
            id="portion-count"
            name="portionCount"
            required
            min="20"
            value="20"
            class="mt-1.5 w-full rounded-xl border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
          />
          <span id="portion-min-hint" class="mt-1 block text-xs text-neutral-900">
            Minimal 20 box
          </span>
        </div>
      </div>

      <!-- Alamat Pengantaran & Peta Interaktif Leaflet -->
      <div>
        <label
          for="customer-address"
          class="block text-sm font-semibold text-neutral-900"
        >
          Alamat Pengantaran <span class="text-accent">*</span>
        </label>
        <textarea
          id="customer-address"
          name="customerAddress"
          required
          rows="2"
          placeholder="Tentukan titik di peta di bawah atau ketik alamat lengkap..."
          class="mt-1.5 w-full resize-none rounded-xl border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
        ></textarea>

        <!-- Komponen Leaflet Map Picker -->
        <PetaPicker
          targetTextareaId="customer-address"
          latInputId="delivery-lat"
          lngInputId="delivery-lng"
          modalId="order-modal"
        />
      </div>

      <!-- Catatan Tambahan -->
      <div>
        <label
          for="order-notes"
          class="block text-sm font-semibold text-neutral-900"
        >
          Catatan Tambahan (Opsional)
        </label>
        <textarea
          id="order-notes"
          name="notes"
          rows="2"
          placeholder="Contoh: Request tanpa pedas, dikirim jam 9 pagi, patokan pagar hitam"
          class="mt-1.5 w-full resize-none rounded-xl border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none"
        ></textarea>
      </div>

      <!-- Tombol Aksi -->
      <div
        class="mt-2 flex flex-col-reverse gap-2.5 pt-2 sm:flex-row sm:justify-end"
      >
        <button
          type="button"
          id="modal-cancel-btn"
          class="btn btn-secondary min-h-[44px] text-sm"
        >
          Batal
        </button>
        <button type="submit" class="btn btn-primary min-h-[44px] text-sm">
          Lanjutkan ke WhatsApp &rarr;
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  let orderModalAbortController: AbortController | null = null;

  function setupOrderModal() {
    if (orderModalAbortController) {
      orderModalAbortController.abort();
    }
    orderModalAbortController = new AbortController();
    const { signal } = orderModalAbortController;

    const dialog = document.getElementById(
      "order-modal",
    ) as HTMLDialogElement | null;
    const form = document.getElementById(
      "order-form",
    ) as HTMLFormElement | null;
    const displayPackage = document.getElementById("display-package-name");
    const displayCustomDetails = document.getElementById("display-custom-details");
    const inputPackage = document.getElementById(
      "input-package-name",
    ) as HTMLInputElement | null;
    const inputCustomDetails = document.getElementById(
      "input-custom-details",
    ) as HTMLInputElement | null;
    const eventDateInput = document.getElementById(
      "event-date",
    ) as HTMLInputElement | null;
    const portionInput = document.getElementById(
      "portion-count",
    ) as HTMLInputElement | null;
    const portionMinHint = document.getElementById("portion-min-hint");
    const addressInput = document.getElementById(
      "customer-address",
    ) as HTMLTextAreaElement | null;
    const latInput = document.getElementById("delivery-lat") as HTMLInputElement | null;
    const lngInput = document.getElementById("delivery-lng") as HTMLInputElement | null;

    if (!dialog || !form) return;

    if (eventDateInput) {
      eventDateInput.min = new Date().toISOString().split("T")[0];
    }

    window.addEventListener("open-order-modal", ((
      e: CustomEvent<{
        packageName?: string;
        customDetails?: string;
        portionCount?: number;
        eventDate?: string;
        minOrder?: number;
      }>,
    ) => {
      const pkg = e.detail?.packageName || "Snack Box Dzanis";
      const details = e.detail?.customDetails || "";
      const portions = e.detail?.portionCount;
      const eventDate = e.detail?.eventDate;
      const minOrder = e.detail?.minOrder;

      if (displayPackage) displayPackage.textContent = pkg;
      if (inputPackage) inputPackage.value = pkg;
      if (inputCustomDetails) inputCustomDetails.value = details;

      if (displayCustomDetails) {
        if (details) {
          displayCustomDetails.textContent = details;
          displayCustomDetails.classList.remove("hidden");
        } else {
          displayCustomDetails.textContent = "";
          displayCustomDetails.classList.add("hidden");
        }
      }

      if (portionInput) {
        if (minOrder) {
          portionInput.min = String(minOrder);
          if (portionMinHint) portionMinHint.textContent = `Minimal ${minOrder} box`;
        } else {
          portionInput.min = "20";
          if (portionMinHint) portionMinHint.textContent = "Minimal 20 box";
        }

        if (portions) {
          portionInput.value = String(portions);
        } else if (!portionInput.value || Number(portionInput.value) < Number(portionInput.min)) {
          portionInput.value = portionInput.min;
        }
      }

      if (eventDate && eventDateInput) {
        eventDateInput.value = eventDate;
      }

      if (!dialog.open) {
        if (addressInput) addressInput.value = "";
        if (latInput) latInput.value = "";
        if (lngInput) lngInput.value = "";
        window.dispatchEvent(new CustomEvent("reset-peta-picker"));
        dialog.showModal();
        window.dispatchEvent(new CustomEvent("order-modal-opened"));
      }
    }) as EventListener, { signal });

    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest("[data-order-trigger]");
      if (trigger) {
        e.preventDefault();
        const packageName =
          trigger.getAttribute("data-package-name") || "Snack Box Dzanis";
        window.dispatchEvent(
          new CustomEvent("open-order-modal", { detail: { packageName } }),
        );
      }
    }, { signal });

    const closeModal = () => dialog.open && dialog.close();
    document
      .getElementById("modal-close-icon")
      ?.addEventListener("click", closeModal, { signal });
    document
      .getElementById("modal-cancel-btn")
      ?.addEventListener("click", closeModal, { signal });

    dialog.addEventListener("click", (e) => {
      const r = dialog.getBoundingClientRect();
      if (
        e.clientY < r.top ||
        e.clientY > r.bottom ||
        e.clientX < r.left ||
        e.clientX > r.right
      ) {
        dialog.close();
      }
    }, { signal });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const pkg = String(data.get("packageName") || "Snack Box Dzanis");
      const details = String(data.get("customDetails") || "").trim();
      const name = String(data.get("customerName") || "").trim();
      const date = String(data.get("eventDate") || "");
      const count = Number(data.get("portionCount")) || 20;
      const address = String(data.get("customerAddress") || "").trim();
      const lat = String(data.get("deliveryLat") || "").trim();
      const lng = String(data.get("deliveryLng") || "").trim();
      const notes = String(data.get("notes") || "").trim();

      const lines = [
        "Halo Dzanis Catering, saya ingin memesan:",
        `- Paket: ${pkg}`,
      ];
      if (details) {
        lines.push(`- Pilihan Item / Kustomisasi:\n${details}`);
      }
      lines.push(
        `- Jumlah: ${count} box`,
        `- Tanggal Acara: ${date}`,
        `- Nama Pemesan: ${name}`,
        `- Alamat Pengantaran: ${address || "-"}`,
      );

      if (lat && lng) {
        lines.push(`- Titik Peta: https://www.google.com/maps?q=${lat},${lng}`);
      }

      lines.push(`- Catatan: ${notes || "-"}`);

      const text = lines.join("\n");

      let phone = (dialog.dataset.phone || "6285726331579").replace(/\D/g, "");
      if (phone.startsWith("0")) phone = "62" + phone.slice(1);

      window.open(
        `https://wa.me/${phone}?text=${encodeURIComponent(text)}`,
        "_blank",
        "noopener,noreferrer",
      );

      form.reset();
      if (inputPackage) inputPackage.value = pkg;
      if (inputCustomDetails) inputCustomDetails.value = "";
      if (displayPackage) displayPackage.textContent = pkg;
      if (displayCustomDetails) {
        displayCustomDetails.textContent = "";
        displayCustomDetails.classList.add("hidden");
      }
      if (portionInput) {
        portionInput.value = portionInput.min || "20";
      }
      if (addressInput) addressInput.value = "";
      if (latInput) latInput.value = "";
      if (lngInput) lngInput.value = "";
      window.dispatchEvent(new CustomEvent("reset-peta-picker"));
      dialog.close();
    }, { signal });
  }

  document.addEventListener("astro:page-load", setupOrderModal);
  document.addEventListener("astro:before-swap", () => {
    if (orderModalAbortController) {
      orderModalAbortController.abort();
      orderModalAbortController = null;
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupOrderModal, { once: true });
  } else {
    setupOrderModal();
  }
</script>
