---
import { company } from '../../data/company';

const waGeneral = company.contact.whatsappLink;

const kolomMenu = [
  { label: "Paket nasi kotak", href: "#paket" },
  { label: "Snack box", href: "#snack" },
  { label: "Prasmanan", href: "#layanan" },
  { label: "Booth / food cart", href: "#layanan" },
];

const kolomInformasi = [
  { label: "Cara pesan", href: "#cara" },
  { label: "Area pengantaran", href: "#" },
  { label: "Sering ditanya", href: "#faq" },
];

const judulKolom =
  "font-heading text-[15px] font-semibold uppercase tracking-[0.06em] text-accent-400";
const tautanKolom =
  "text-[15px] text-neutral-300 no-underline transition-colors hover:text-bg";
---

<footer class="bg-neutral-900 text-bg">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-[var(--space-6)] px-[var(--space-4)] py-[var(--space-8)] lg:gap-12 lg:px-14 lg:pt-16 lg:pb-10">
    <div class="flex flex-col gap-[var(--space-6)] lg:grid lg:grid-cols-[1.4fr_1fr_1fr_1.3fr] lg:gap-10">
      <!-- Kolom 1 — Identitas -->
      <div class="flex flex-col gap-[var(--space-4)] lg:gap-4">
        <div class="flex items-center gap-[var(--space-3)]">
          <span class="flex size-[52px] shrink-0 items-center justify-center rounded-full bg-bg lg:size-[46px]">
            <img
              src={company.mark}
              alt={company.name}
              width="44"
              height="44"
              class="size-11 rounded-full object-contain lg:size-[38px]"
            />
          </span>
          <div>
            <div class="font-heading text-[20px] font-semibold lg:text-[22px] lg:tracking-[0.02em] lg:uppercase">
              {company.name}
            </div>
            <div class="text-[14px] text-neutral-400 lg:hidden">
              {company.tagline}
            </div>
          </div>
        </div>
        <p class="hidden max-w-[260px] text-[15px] leading-[1.6] text-neutral-400 lg:block">
          Katering rumahan dari Majalengka. Nasi kotak, snack box, dan
          prasmanan untuk segala acara, diantar ke seluruh Ciayumajakuning.
        </p>
      </div>

      <!-- Kolom 2 — Menu -->
      <nav
        aria-label="Menu"
        class="hidden flex-col gap-[var(--space-3)] lg:flex"
      >
        <h2 class={judulKolom}>Menu</h2>
        {kolomMenu.map((t) => (
          <a href={t.href} class={tautanKolom}>
            {t.label}
          </a>
        ))}
      </nav>

      <!-- Kolom 3 — Informasi -->
      <nav
        aria-label="Informasi"
        class="hidden flex-col gap-[var(--space-3)] lg:flex"
      >
        <h2 class={judulKolom}>Informasi</h2>
        {kolomInformasi.map((t) => (
          <a href={t.href} class={tautanKolom}>
            {t.label}
          </a>
        ))}
      </nav>

      <!-- Kolom 4 — Kontak Langsung -->
      <div class="flex flex-col gap-[var(--space-6)] lg:gap-3.5">
        <h2 class={`hidden lg:block ${judulKolom}`}>Pesan langsung</h2>
        <div class="flex flex-col gap-[var(--space-1)] lg:contents">
          <span class="text-[14px] text-neutral-400 lg:hidden">
            Menerima pesanan setiap hari
          </span>
          <a
            href={company.contact.phoneHref}
            class="font-heading text-[31px] leading-[1.1] font-semibold text-bg no-underline transition-colors hover:text-accent-400 lg:text-[32px]"
          >
            {company.contact.whatsappDisplay}
          </a>
          <span class="hidden text-[14px] text-neutral-400 lg:block">
            {company.contact.operatingHours}
          </span>
        </div>

        <a
          class="btn btn-primary btn-block min-h-13 text-[16px] focus-visible:outline-bg lg:min-h-12 lg:w-auto lg:self-start lg:px-[var(--space-5)] lg:text-[14px] lg:tracking-[0.05em] lg:uppercase"
          href={waGeneral}
        >
          <span class="lg:hidden">Pesan via WhatsApp</span>
          <span class="hidden lg:inline">WhatsApp</span>
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-[var(--space-2)] border-t border-bg/20 pt-[var(--space-4)] text-neutral-400 lg:flex-row lg:justify-between lg:gap-[var(--space-5)] lg:pt-[var(--space-5)]">
      <div class="text-[14px] leading-[1.5] lg:hidden">
        Dapur di Majalengka, mengantar ke {company.ketentuan.areaAntar}.
        Pengantaran mulai pukul 06.00.
      </div>
      <div class="text-[13px]">© 2026 Dzanis Catering</div>
      <div class="hidden text-[13px] lg:block">
        {company.contact.address}
      </div>
    </div>
  </div>
</footer>

<!-- WhatsApp Floating Action Button -->
<a
  href={waGeneral}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat WhatsApp Dzanis Catering"
  class="fixed right-[var(--space-4)] bottom-[max(var(--space-4),env(safe-area-inset-bottom))] z-[300] flex size-14 items-center justify-center rounded-full bg-wa text-bg shadow-[var(--shadow-lg)] ring-1 ring-wa-gelap transition-[background-color,transform] duration-200 hover:scale-105 hover:bg-wa-gelap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-700 lg:size-[60px]"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="size-7 lg:size-8">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
  </svg>
  <span class="sr-only">Hubungi kami lewat WhatsApp</span>
</a>
