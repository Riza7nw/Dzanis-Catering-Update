---
import { waLink } from '../../data/company';

const waPaket = waLink('Halo Dzanis Catering, saya mau tanya paket nasi kotak.');
---

<section class="hero-masuk mx-auto flex max-w-[1280px] flex-col gap-[var(--space-4)] px-[var(--space-4)] pt-[var(--space-3)] pb-[var(--space-8)] lg:gap-[44px] lg:px-14 lg:pt-16 lg:pb-[72px]">
  <!-- Judul & paragraf: bertumpuk di mobile, sebaris rata-atas di web. -->
  <div class="flex flex-col gap-[var(--space-4)] lg:flex-row lg:items-start lg:justify-between lg:gap-[var(--space-6)]">
    <!-- 82px persis di lebar artboard (1280px); clamp hanya mengecilkan
        judul di rentang 1024–1279px supaya tidak menabrak paragraf. -->
    <h1 class="m-0 max-w-[330px] font-heading text-[38px] leading-[1.06] tracking-[-0.01em] text-pretty uppercase lg:max-w-[700px] xl:max-w-[760px] lg:text-[clamp(56px,5.8vw,82px)] lg:leading-[0.94] lg:tracking-[-0.02em] xl:text-[82px]">
      <span class="font-heading">Setiap sajian punya</span>{" "}
      <span class="font-body font-normal tracking-[-0.01em] normal-case italic text-accent-700 lg:whitespace-nowrap">
        cerita
      </span>
    </h1>
    <p class="m-0 max-w-[360px] text-[18px] leading-[1.55] text-neutral-800 lg:mt-1.5 lg:-ml-6 xl:-ml-10 lg:w-[380px] xl:w-[420px] lg:max-w-none lg:text-[18px] lg:leading-[1.6] lg:flex-none">
      Hadirkan kehangatan masakan rumahan yang pas di lidah dan ramah di
      kantong untuk setiap momen kumpul Anda.
    </p>
  </div>

  <!-- Dua tombol block hanya ada di artboard mobile. -->
  <div class="flex flex-col items-start gap-[var(--space-2)] lg:hidden">
    <a class="btn btn-primary btn-block min-h-[52px] text-[16px]" href="#paket">
      Lihat paket &amp; harga
    </a>
    <a
      class="btn btn-secondary btn-block min-h-[52px] text-[16px]"
      href={waPaket}
      target="_blank"
      rel="noopener noreferrer"
    >
      Pesan via WhatsApp
    </a>
  </div>

  <div class="relative mt-[var(--space-2)] lg:mt-0">
    <!-- Lingkaran sage mengintip di balik foto — versi mobile. -->
    <span
      aria-hidden="true"
      class="lingkaran-sage absolute top-[-22px] right-[-14px] size-24 rounded-full bg-accent-2-300 lg:hidden"
    ></span>

    <div class="grid gap-[var(--space-4)] lg:grid-cols-[1.55fr_1fr]">
      <!-- Bayangan hanya ada di artboard mobile; versi web tanpa shadow. -->
      <div class="relative aspect-[4/3] w-full overflow-hidden rounded-[var(--radius-lg)] bg-surface shadow-[var(--shadow-md)] lg:rounded-[var(--radius-md)] lg:shadow-none">
        <img
          src="/images/menu/hero-nasi-kotak.jpg"
          alt="Nasi kotak Dzanis Catering"
          loading="eager"
          decoding="async"
          class="washed h-full w-full object-cover"
        />
      </div>

      <!-- Foto kedua hanya muncul di artboard web. Slot ini dibiarkan kosong
          di artboard ("foto acara / meja prasmanan"), jadi diisi foto Dzanis
          asli dari poster harga sampai pemilik mengirim foto acara. -->
      <div class="relative hidden overflow-hidden rounded-[var(--radius-md)] bg-surface lg:block">
        <img
          src="/images/menu/paket-23k.jpg"
          alt="Nasi kotak lengkap Dzanis Catering"
          loading="lazy"
          decoding="async"
          class="washed h-full w-full object-cover"
        />
      </div>
    </div>

    <!-- Badge harga menumpuk di sudut grid — versi web. -->
    <div class="absolute top-[-34px] right-[-16px] hidden size-[118px] flex-col items-center justify-center gap-px rounded-full bg-accent text-bg shadow-[var(--shadow-md)] lg:flex">
      <span class="font-heading text-[14px] tracking-[0.04em]">MULAI</span>
      <span class="font-heading text-[27px] leading-none">20K</span>
      <span class="text-base font-bold tracking-[0.04em]">per box</span>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 lg:gap-[14px]">
    <span class="tag tag-accent text-base px-4 py-2 lg:hidden">
      Mulai Rp20.000/box
    </span>
    <span class="tag tag-accent-2 text-base px-5 py-2.5 hidden lg:inline-flex">
      Halal, masakan rumahan
    </span>
    <!-- Sage di mobile, netral di web — mengikuti masing-masing artboard. -->
    <span class="tag tag-accent-2 text-base px-4 py-2 lg:px-5 lg:py-2.5 lg:bg-neutral-200 lg:text-neutral-800">
      Minimal 20 box
    </span>
    <span class="tag tag-neutral text-base px-4 py-2 lg:px-5 lg:py-2.5">
      Antar Ciayumajakuning
    </span>
    <a
      class="btn btn-secondary hidden px-[22px] lg:ml-auto lg:inline-flex"
      href={waPaket}
      target="_blank"
      rel="noopener noreferrer"
    >
      Tanya via WhatsApp
    </a>
  </div>
</section>
