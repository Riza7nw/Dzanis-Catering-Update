---
import { layanan } from '../../data/konten';
import { waLink } from '../../data/company';
---

<section id="layanan" class="bg-surface lg:bg-bg">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-8)] lg:gap-8 lg:px-14 lg:py-[72px]">
    <div class="flex flex-col gap-[var(--space-3)] lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <h2 class="m-0 text-[29px] leading-[1.12] lg:text-[52px] lg:leading-[0.98] lg:tracking-[-0.01em] lg:uppercase font-heading">
        Layanan lain
      </h2>
      <p class="m-0 text-[16px] leading-[1.6] text-neutral-800 lg:mb-[6px] lg:w-[340px] lg:flex-none">
        Di luar nasi kotak dan snack box, kami juga menangani acara berskala besar.
      </p>
    </div>

    <div class="flex flex-col gap-[var(--space-3)] lg:grid lg:grid-cols-3 lg:gap-5" data-reveal>
      {layanan.map((item) => (
        <article
          class="card items-start bg-bg lg:gap-0 lg:overflow-hidden lg:bg-surface lg:p-0"
        >
          <!-- Foto hanya bagian dari artboard web -->
          <div class="relative hidden aspect-[4/3] w-full lg:block overflow-hidden">
            <img
              src={item.foto}
              alt={item.fotoAlt}
              loading="lazy"
              decoding="async"
              class="washed h-full w-full object-cover"
            />
          </div>

          <div class="flex w-full flex-col items-start gap-[var(--space-2)] lg:gap-[10px] lg:px-[26px] lg:pt-6 lg:pb-7">
            <h3 class="card-title text-[20px] lg:text-[23px] font-heading font-semibold">
              {item.judul}
            </h3>
            <p class="card-body text-[15px] leading-[1.5] lg:leading-[1.55] text-neutral-800">
              {item.deskripsi}
            </p>
            <a
              class="btn btn-secondary min-h-[44px] lg:text-[13px] lg:tracking-[0.05em] lg:uppercase"
              href={waLink(`Halo Dzanis Catering, saya mau minta penawaran untuk ${item.judul}.`)}
              aria-label={`Minta penawaran untuk ${item.judul}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Minta penawaran
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
