---
import { DAFTAR_LAYANAN_LAIN } from '../../data/layananLain';
import { waPhoneNumber } from '../../data/company';
import { buildServiceInquiryUrl } from '../../utils/whatsappFormatter';

const phone = waPhoneNumber;
---

<section id="layanan" class="py-14 md:py-20 bg-surface/30">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <!-- Header Seksi -->
    <div class="flex flex-col gap-2 max-w-2xl">
      <h2 class="font-serif font-bold tracking-wide text-3xl md:text-5xl text-neutral-900 uppercase">
        Layanan Lain
      </h2>
      <p class="text-sm md:text-base text-neutral-900 leading-relaxed">
        Di luar nasi kotak dan snack box, kami juga menangani acara berskala besar dengan fasilitas lengkap.
      </p>
    </div>

    <!-- Carousel Wrapper -->
    <div class="relative group/carousel mt-10">
      <!-- Tombol Panah Kiri (‹) -->
      <button
        type="button"
        id="layanan-prev"
        aria-label="Layanan sebelumnya"
        onclick="document.getElementById('layanan-grid')?.scrollBy({ left: -350, behavior: 'smooth' })"
        class="absolute -left-3 sm:-left-4 lg:-left-6 top-1/2 -translate-y-1/2 z-20 size-11 sm:size-12 rounded-full bg-white/95 backdrop-blur shadow-md hover:shadow-xl border border-neutral-200/90 text-neutral-800 hover:text-[#C04A27] flex items-center justify-center transition-all duration-200 cursor-pointer touch-manipulation disabled:opacity-0 disabled:pointer-events-none disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C04A27]"
      >
        <svg class="size-5 sm:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>

      <!-- Carousel Container (Native CSS Scroll Snap) -->
      <div
        id="layanan-grid"
        role="region"
        aria-roledescription="carousel"
        aria-label="Daftar Layanan Lainnya"
        class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-5 pb-6 pt-1 overscroll-x-contain no-scrollbar cursor-grab select-none"
      >
        {DAFTAR_LAYANAN_LAIN.map((item, idx) => {
          const serviceName = item.title || item.nama;
          const waUrl = buildServiceInquiryUrl(serviceName, phone);

          return (
            <div
              role="group"
              aria-roledescription="slide"
              aria-label={`${item.nama} (${idx + 1} dari ${DAFTAR_LAYANAN_LAIN.length})`}
              class="w-full md:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)] shrink-0 snap-start bg-white rounded-3xl border border-neutral-200/80 shadow-sm overflow-hidden flex flex-col justify-between transition-shadow duration-200 hover:shadow-md select-none"
            >
              <!-- Top Image with Floating Badge -->
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-surface">
                <img
                  src={item.foto}
                  alt={item.fotoAlt}
                  loading="lazy"
                  width="600"
                  height="375"
                  decoding="async"
                  draggable="false"
                  class="h-full w-full object-cover transition-transform duration-300 hover:scale-105 pointer-events-none select-none"
                />
                {item.badge && (
                  <span class="absolute top-3.5 left-3.5 rounded-full bg-[#C04A27] px-3 py-1 font-heading text-[10px] tracking-[0.05em] text-white font-bold uppercase shadow-sm">
                    {item.badge}
                  </span>
                )}
              </div>

              <!-- Card Content Body -->
              <div class="p-5 md:p-6 flex flex-1 flex-col justify-between">
                <div>
                  <!-- Title & Description -->
                  <h3 class="font-heading text-xl font-bold text-neutral-900 mb-1.5">
                    {item.nama}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-900 leading-relaxed mb-4">
                    {item.deskripsi}
                  </p>

                  <!-- Pricing & MoQ Header -->
                  <div class="mb-4">
                    <p class="flex items-baseline gap-1.5 text-neutral-900">
                      <span class="text-xs font-semibold text-neutral-500">Mulai</span>
                      <span class="text-2xl font-bold font-heading text-neutral-900">
                        {item.headlineHarga}
                      </span>
                      <span class="text-xs text-neutral-500 font-normal">
                        {item.satuanHarga}
                      </span>
                    </p>
                    <span class="inline-block bg-white text-neutral-900 border border-neutral-300 font-medium text-xs px-2.5 py-1 rounded-full w-fit mt-2">
                      {item.minOrder}
                    </span>
                  </div>

                  <!-- Facility Inclusion List -->
                  <div class="border-t border-neutral-100 pt-3.5 mb-2">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-2">
                      Fasilitas Termasuk:
                    </span>
                    <ul class="text-xs text-neutral-900 space-y-1.5">
                      {item.fasilitas.map((f) => (
                        <li class="flex items-start gap-2">
                          <span class="text-[#C04A27] font-bold flex-none">✓</span>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Native Accordion for Menu Highlights (Zero JS) -->
                  <details class="group border-t border-neutral-100 pt-3 mt-4">
                    <summary class="flex justify-between items-center text-xs font-semibold text-[#C04A27] cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none focus-visible:outline-2 focus-visible:outline-accent-700">
                      <span>Contoh Menu Pilihan ({item.menuHighlight.length})</span>
                      <span aria-hidden="true" class="text-sm font-bold group-open:rotate-45 transition-transform duration-200">+</span>
                    </summary>
                    <ul class="mt-2 space-y-1 text-xs text-neutral-900 pl-2">
                      {item.menuHighlight.map((m) => (
                        <li>• {m}</li>
                      ))}
                    </ul>
                  </details>
                </div>

                <!-- Primary CTA Button: Direct WhatsApp Action -->
                <div class="mt-6 pt-2">
                  <a
                    href={waUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Konsultasi paket ${item.nama} via WhatsApp`}
                    class="flex min-h-[44px] w-full items-center justify-center gap-2 text-center py-3 px-4 rounded-full bg-wa hover:bg-wa-gelap text-white text-xs font-bold uppercase tracking-wider transition-all duration-200 shadow-sm hover:shadow-md cursor-pointer touch-manipulation"
                  >
                    <svg class="size-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    <span>Konsultasi via WhatsApp</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Tombol Panah Kanan (›) -->
      <button
        type="button"
        id="layanan-next"
        aria-label="Layanan selanjutnya"
        onclick="document.getElementById('layanan-grid')?.scrollBy({ left: 350, behavior: 'smooth' })"
        class="absolute -right-3 sm:-right-4 lg:-right-6 top-1/2 -translate-y-1/2 z-20 size-11 sm:size-12 rounded-full bg-white/95 backdrop-blur shadow-md hover:shadow-xl border border-neutral-200/90 text-neutral-800 hover:text-[#C04A27] flex items-center justify-center transition-all duration-200 cursor-pointer touch-manipulation disabled:opacity-0 disabled:pointer-events-none disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C04A27]"
      >
        <svg class="size-5 sm:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </div>

    <!-- Indikator Posisi Visual (Dots) -->
    <div
      id="layanan-dots"
      class="flex items-center justify-center gap-2 mt-6"
    >
    </div>
  </div>
</section>
