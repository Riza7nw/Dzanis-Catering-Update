---
import { LAYANAN_PRASMANAN_SSOT } from '../../data/layananLain';
import { waPhoneNumber } from '../../data/company';
import { buildServiceInquiryUrl } from '../../utils/whatsappFormatter';

const data = LAYANAN_PRASMANAN_SSOT;
const phone = waPhoneNumber;
const waUrl = buildServiceInquiryUrl(
  'Prasmanan',
  phone,
  data.waPreFilledMessage
);
---

<section id="layanan" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- 1. Section Header (Clean & Aligned) -->
  <div class="max-w-3xl mb-12">
    <p class="text-xs md:text-sm font-semibold tracking-wider text-amber-900 uppercase mb-2">
      {data.eyebrow}
    </p>
    <h2 class="text-3xl md:text-4xl font-extrabold text-stone-900 tracking-tight font-heading">
      {data.heading}
    </h2>
    <p class="mt-3 text-base md:text-lg text-stone-600 leading-relaxed">
      {data.deskripsi}
    </p>
  </div>

  <!-- 2. Main Showcase Card (Bordernya Pas, Grid 50:50 yang Imbang) -->
  <div class="bg-white rounded-3xl border border-stone-200/90 shadow-sm overflow-hidden grid grid-cols-1 lg:grid-cols-12">
    
    <!-- SISI KIRI: Visual Showcase Gagah (lg:col-span-6) -->
    <div class="lg:col-span-6 p-6 sm:p-8 bg-stone-50/50 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-stone-200/80">
      <div class="grid grid-cols-2 gap-4">
        <!-- Foto 1 -->
        <div class="space-y-2">
          <div class="aspect-4/3 rounded-2xl overflow-hidden shadow-sm border border-stone-200/80 bg-stone-100">
            <img 
              src="/images/layanan/prasmanan-kantor.webp" 
              alt="Setup Meja Prasmanan Kantor Dzanis Catering" 
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="text-xs font-semibold text-stone-700 text-center">Setup Meja Kantor & Rapat</p>
        </div>
        <!-- Foto 2 -->
        <div class="space-y-2">
          <div class="aspect-4/3 rounded-2xl overflow-hidden shadow-sm border border-stone-200/80 bg-stone-100">
            <img 
              src="/images/layanan/wedding-catering.webp" 
              alt="Setup Buffet Acara Dzanis Catering" 
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="text-xs font-semibold text-stone-700 text-center">Setup Meja Resepsi & Acara</p>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-stone-200/60 flex items-center justify-between text-xs text-stone-500">
        <span>✓ Peralatan steril & pemanas siap saji di lokasi</span>
        <span class="font-medium text-amber-900">Area Majalengka</span>
      </div>
    </div>

    <!-- SISI KANAN: Value, Menu & Pricing Matrix (lg:col-span-6) -->
    <div class="lg:col-span-6 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
      <div>
        <!-- Price Tag Header -->
        <div class="flex items-baseline justify-between border-b border-stone-200/80 pb-6 mb-6">
          <div>
            <span class="text-xs text-stone-500 uppercase tracking-wider block mb-1">Mulai Dari</span>
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight font-heading">{data.harga}</span>
              <span class="text-stone-500 text-sm font-medium">{data.satuanHarga}</span>
            </div>
          </div>
          <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-950 border border-amber-200">
            {data.minOrder}
          </span>
        </div>

        <!-- Detail Fasilitas vs Menu Populer -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm mb-8">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-3">Fasilitas Termasuk:</h4>
            <ul class="space-y-2.5 text-stone-600">
              {data.fasilitas.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-stone-900 mb-3">Pilihan Menu Favorit:</h4>
            <ul class="space-y-2 text-stone-600">
              {data.menuPopuler.map((m) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-800 shrink-0"></span>
                  <span>{m}</span>
                </li>
              ))}
            </ul>
            {data.catatanMenu && (
              <p class="mt-2 text-[11px] text-stone-400 italic">*{data.catatanMenu}</p>
            )}
          </div>
        </div>
      </div>

      <!-- Single Solid CTA WhatsApp Button -->
      <div>
        <a 
          href={waUrl}
          target="_blank" 
          rel="noopener noreferrer"
          aria-label="Konsultasi prasmanan via WhatsApp"
          class="w-full inline-flex min-h-[48px] items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-[#9A5034] hover:bg-[#85432B] text-white font-semibold text-sm shadow-sm transition-all duration-200 touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#9A5034]"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span>KONSULTASI PRASMANAN VIA WHATSAPP</span>
        </a>
      </div>

    </div>

  </div>
</section>
