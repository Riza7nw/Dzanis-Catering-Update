---
import { DAFTAR_LAYANAN_LAIN } from '../../data/layananLain';
import { waPhoneNumber } from '../../data/company';
import { buildServiceInquiryUrl } from '../../utils/whatsappFormatter';

const item = DAFTAR_LAYANAN_LAIN[0];
const phone = waPhoneNumber;
const serviceName = item.title || item.nama;
const waUrl = buildServiceInquiryUrl(serviceName, phone);
---

<section id="layanan" class="py-14 md:py-20 bg-surface/30">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <!-- Header Seksi -->
    <div class="flex flex-col gap-2 max-w-2xl mb-8 md:mb-12">
      <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-accent-700">
        Layanan Khusus
      </span>
      <h2 class="font-serif font-bold tracking-wide text-3xl md:text-5xl text-neutral-900 uppercase">
        Layanan Prasmanan
      </h2>
      <p class="text-sm md:text-base text-neutral-800 leading-relaxed">
        Solusi jamuan makan prasmanan siap saji higienis dan praktis untuk rapat kerja, pelatihan, seminar, maupun syukuran kantor Anda.
      </p>
    </div>

    <!-- Spotlight Showcase Container (2-Column Grid on Desktop) -->
    <div class="bg-white rounded-3xl border border-neutral-200/80 shadow-sm overflow-hidden p-6 sm:p-8 lg:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Visual Column (5 Cols) -->
        <div class="lg:col-span-5 relative flex flex-col">
          <div class="relative aspect-[4/5] w-full overflow-hidden rounded-2xl bg-surface shadow-inner">
            <img
              id="prasmanan-main-img"
              src={item.foto}
              alt={item.fotoAlt}
              loading="lazy"
              width="767"
              height="1024"
              decoding="async"
              class="h-full w-full object-cover transition-opacity duration-300"
            />
            {item.badge && (
              <span class="absolute top-3.5 left-3.5 rounded-full bg-accent-700 px-3 py-1 font-heading text-[11px] tracking-[0.05em] text-white font-bold uppercase shadow-sm">
                {item.badge}
              </span>
            )}
          </div>

          <!-- Thumbnail Gallery Selector -->
          {item.galeri && item.galeri.length > 1 && (
            <div class="flex items-center gap-3 mt-3.5">
              <div class="flex gap-2">
                {item.galeri.map((g, idx) => (
                  <button
                    type="button"
                    class={`prasmanan-thumb-btn group relative size-14 sm:size-16 shrink-0 overflow-hidden rounded-xl border-2 transition-all duration-200 cursor-pointer touch-manipulation focus-visible:outline-2 focus-visible:outline-accent-700 ${idx === 0 ? 'border-accent-700 ring-2 ring-accent-700/20' : 'border-neutral-200 opacity-70 hover:opacity-100'}`}
                    data-src={g.src}
                    data-alt={g.alt}
                    aria-label={`Tampilkan dokumentasi prasmanan meja ${idx + 1}`}
                  >
                    <img
                      src={g.src}
                      alt={g.alt}
                      width="64"
                      height="64"
                      class="h-full w-full object-cover pointer-events-none"
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
              <span class="text-[11px] text-neutral-500 leading-tight">
                Pilihan dokumentasi setup prasmanan siap santap
              </span>
            </div>
          )}

          <!-- Sub-caption Reassurance -->
          <p class="text-xs text-neutral-500 mt-3 text-center sm:text-left flex items-center justify-center sm:justify-start gap-1.5">
            <svg class="size-4 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span>Peralatan & pemanas bersih, steril, dan siap saji di lokasi.</span>
          </p>
        </div>

        <!-- Detail Information Column (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-baseline gap-3 mb-2">
              <h3 class="font-heading text-2xl sm:text-3xl font-bold text-neutral-900">
                {item.nama}
              </h3>
            </div>
            
            <p class="text-sm sm:text-base text-neutral-700 leading-relaxed mb-6">
              {item.deskripsi}
            </p>

            <!-- Pricing & MOQ Cardlet -->
            <div class="bg-surface/50 rounded-2xl p-4 sm:p-5 border border-neutral-200/60 mb-6 flex flex-wrap items-center justify-between gap-4">
              <div>
                <span class="text-xs text-neutral-500 block font-medium">Biaya Mulai:</span>
                <p class="flex items-baseline gap-1 text-neutral-900 mt-0.5">
                  <span class="text-2xl sm:text-3xl font-bold font-heading text-accent-700">
                    {item.headlineHarga}
                  </span>
                  <span class="text-xs sm:text-sm text-neutral-500 font-normal">
                    {item.satuanHarga}
                  </span>
                </p>
              </div>
              <div class="sm:text-right">
                <span class="text-xs text-neutral-500 block font-medium">Ketentuan:</span>
                <span class="inline-block bg-white text-neutral-800 border border-neutral-300 font-semibold text-xs sm:text-sm px-3.5 py-1.5 rounded-full mt-0.5 shadow-2xs">
                  {item.minOrder}
                </span>
              </div>
            </div>

            <!-- Facilities Grid -->
            <div class="mb-6">
              <span class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2.5">
                Fasilitas Termasuk:
              </span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {item.fasilitas.map((f) => (
                  <div class="flex items-center gap-2.5 bg-neutral-50 p-2.5 rounded-xl border border-neutral-200/60 text-xs sm:text-sm text-neutral-800">
                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-accent-700/10 text-accent-700 text-xs font-bold">✓</span>
                    <span class="font-medium">{f}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Menu Highlights (Pills) -->
            <div class="mb-8">
              <span class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-2.5">
                Contoh Pilihan Menu:
              </span>
              <div class="flex flex-wrap gap-2">
                {item.menuHighlight.map((m) => (
                  <span class="inline-flex items-center rounded-lg bg-surface px-3 py-1.5 text-xs text-neutral-800 border border-neutral-200/60">
                    • {m}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Primary CTA Button: WhatsApp -->
          <div>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Konsultasi paket ${item.nama} via WhatsApp`}
              class="inline-flex min-h-[48px] w-full sm:w-auto items-center justify-center gap-2 text-center py-3.5 px-7 rounded-full bg-accent-900 hover:bg-accent-700 text-bg text-xs sm:text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-sm hover:shadow-md cursor-pointer touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-700"
            >
              <svg class="size-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Konsultasi Prasmanan via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPrasmananGallery() {
    const mainImg = document.getElementById('prasmanan-main-img') as HTMLImageElement | null;
    const thumbBtns = document.querySelectorAll('.prasmanan-thumb-btn');

    if (!mainImg || thumbBtns.length === 0) return;

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        const alt = btn.getAttribute('data-alt');
        if (!src) return;

        // Smooth swap
        mainImg.style.opacity = '0.7';
        setTimeout(() => {
          mainImg.src = src;
          if (alt) mainImg.alt = alt;
          mainImg.style.opacity = '1';
        }, 120);

        // Update active rings
        thumbBtns.forEach((b) => {
          b.classList.remove('border-accent-700', 'ring-2', 'ring-accent-700/20');
          b.classList.add('border-neutral-200', 'opacity-70');
        });

        btn.classList.remove('border-neutral-200', 'opacity-70');
        btn.classList.add('border-accent-700', 'ring-2', 'ring-accent-700/20');
      });
    });
  }

  // Support initial load and Astro View Transitions if any
  initPrasmananGallery();
  document.addEventListener('astro:page-load', initPrasmananGallery);
</script>
