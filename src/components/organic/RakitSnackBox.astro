---
import { snackKategori, MIN_BOX, formatRupiah } from '../../data/snack';
---

<section id="rakit" class="px-[var(--space-4)] py-[var(--space-8)] lg:px-14 lg:py-20 bg-surface/60">
  <div class="mx-auto max-w-[1280px]">
    <!-- Section Header -->
    <div class="mb-8 lg:mb-12 flex flex-col items-center text-center">
      <span class="tag tag-accent text-xs uppercase tracking-widest font-bold mb-3">
        Interactive Builder
      </span>
      <h2 class="font-heading text-[32px] leading-tight lg:text-[52px] lg:leading-[1] text-neutral-900 uppercase">
        Rakit Snack Box Sendiri
      </h2>
      <p class="mt-3 max-w-xl text-[16px] leading-relaxed text-neutral-700">
        Pilih aneka jajan pasar, kue basah, pastry, dan puding sesuai selera acara Anda. Harga dihitung transparan per box secara real-time.
      </p>
    </div>

    <!-- Builder Container Card -->
    <div id="snack-builder" class="rounded-[32px] border border-divider bg-bg p-6 lg:p-10 shadow-[var(--shadow-lg)]">
      <!-- Portion & Box Settings Bar -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-divider pb-6">
        <div>
          <h3 class="font-heading text-xl text-neutral-900">Pilihan Jajanan</h3>
          <p class="text-xs text-neutral-600">Centang jajanan yang ingin dimasukkan ke dalam setiap box.</p>
        </div>
        <div class="flex items-center gap-3 bg-surface px-4 py-2 rounded-full border border-divider">
          <span class="text-xs font-semibold text-neutral-800">Jumlah Box:</span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="builder-box-minus"
              class="size-8 rounded-full border border-accent text-accent font-bold hover:bg-accent hover:text-bg transition-colors flex items-center justify-center cursor-pointer text-base"
              aria-label="Kurangi jumlah box"
            >
              −
            </button>
            <span
              id="builder-box-count"
              role="spinbutton"
              aria-valuemin="20"
              aria-valuenow={MIN_BOX}
              aria-label="Jumlah box"
              class="font-heading text-lg font-bold min-w-[28px] text-center text-neutral-900"
            >
              {MIN_BOX}
            </span>
            <button
              type="button"
              id="builder-box-plus"
              class="size-8 rounded-full bg-accent text-bg font-bold hover:bg-accent-700 transition-colors flex items-center justify-center cursor-pointer text-base"
              aria-label="Tambah jumlah box"
            >
              +
            </button>
          </div>
          <span class="text-[11px] text-neutral-500">(Min. {MIN_BOX})</span>
        </div>
      </div>

      <!-- Categories & Checkbox Grid -->
      <div class="flex flex-col gap-8">
        {snackKategori.map((kategori) => (
          <div>
            <div class="flex items-center gap-2.5 mb-4">
              <span class="size-2 rounded-full bg-accent"></span>
              <h4 class="font-heading text-lg font-semibold text-neutral-900">
                {kategori.label}
              </h4>
              <span class="text-xs text-neutral-500 font-mono">({kategori.items.length} pilihan)</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              {kategori.items.map((item) => (
                <label class="group relative flex items-center justify-between gap-3 p-3.5 rounded-2xl border border-divider bg-surface/50 hover:bg-surface hover:border-accent/40 cursor-pointer transition-all has-[:checked]:border-accent has-[:checked]:bg-accent-200/25">
                  <div class="flex items-center gap-3 min-w-0">
                    <input
                      type="checkbox"
                      name="snack-choice"
                      value={item.nama}
                      data-nama={item.nama}
                      data-price={item.harga}
                      class="size-4.5 rounded border-neutral-400 text-accent focus:ring-accent accent-accent cursor-pointer"
                    />
                    <span class="text-sm font-medium text-neutral-900 truncate">
                      {item.nama}
                    </span>
                  </div>
                  <span class="text-xs font-semibold text-accent-700 whitespace-nowrap">
                    {formatRupiah(item.harga)}
                  </span>
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Sticky / Bottom Summary Bar -->
      <div class="mt-10 pt-6 border-t border-divider flex flex-col md:flex-row items-center justify-between gap-6 bg-surface/80 rounded-2xl p-6">
        <div class="flex flex-wrap items-center gap-6 text-center md:text-left">
          <div>
            <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Item Terpilih</span>
            <span id="summary-item-count" aria-live="polite" role="status" class="font-heading text-2xl font-bold text-neutral-900">0 macam</span>
          </div>
          <div class="h-8 w-px bg-divider hidden sm:block"></div>
          <div>
            <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Harga per Box</span>
            <span id="summary-subtotal" aria-live="polite" role="status" class="font-heading text-2xl font-bold text-accent-700">Rp0</span>
          </div>
          <div class="h-8 w-px bg-divider hidden sm:block"></div>
          <div>
            <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Estimasi Total</span>
            <span id="summary-total" aria-live="polite" role="status" class="font-heading text-2xl font-bold text-neutral-900">Rp0</span>
          </div>
        </div>

        <button
          type="button"
          id="builder-order-btn"
          class="btn btn-primary min-h-[50px] px-8 text-base font-semibold w-full md:w-auto shadow-md hover:shadow-lg transition-shadow cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          Pesan Paket Rakitan Ini &rarr;
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initSnackBuilder() {
    const root = document.getElementById('snack-builder');
    if (!root) return;

    let boxCount = 20;
    const minBoxes = 20;
    const stepBoxes = 5;

    const checkboxes = root.querySelectorAll<HTMLInputElement>('input[name="snack-choice"]');
    const boxCountDisplay = document.getElementById('builder-box-count');
    const boxMinusBtn = document.getElementById('builder-box-minus');
    const boxPlusBtn = document.getElementById('builder-box-plus');

    const itemCountDisplay = document.getElementById('summary-item-count');
    const subtotalDisplay = document.getElementById('summary-subtotal');
    const totalDisplay = document.getElementById('summary-total');
    const orderBtn = document.getElementById('builder-order-btn') as HTMLButtonElement | null;

    function formatRp(num: number): string {
      return 'Rp' + num.toLocaleString('id-ID');
    }

    function recalculate() {
      let subtotal = 0;
      const selectedItems: string[] = [];

      checkboxes.forEach((cb) => {
        if (cb.checked) {
          const price = Number(cb.dataset.price || 0);
          subtotal += price;
          selectedItems.push(cb.dataset.nama || cb.value);
        }
      });

      const total = subtotal * boxCount;

      if (itemCountDisplay) {
        itemCountDisplay.textContent = `${selectedItems.length} macam`;
      }
      if (subtotalDisplay) {
        subtotalDisplay.textContent = formatRp(subtotal);
      }
      if (totalDisplay) {
        totalDisplay.textContent = formatRp(total);
      }

      if (orderBtn) {
        orderBtn.disabled = selectedItems.length === 0;
      }

      return { selectedItems, subtotal, total };
    }

    boxMinusBtn?.addEventListener('click', () => {
      if (boxCount > minBoxes) {
        boxCount -= stepBoxes;
        if (boxCountDisplay) {
          boxCountDisplay.textContent = String(boxCount);
          boxCountDisplay.setAttribute('aria-valuenow', String(boxCount));
        }
        recalculate();
      }
    });

    boxPlusBtn?.addEventListener('click', () => {
      boxCount += stepBoxes;
      if (boxCountDisplay) {
        boxCountDisplay.textContent = String(boxCount);
        boxCountDisplay.setAttribute('aria-valuenow', String(boxCount));
      }
      recalculate();
    });

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', recalculate);
    });

    orderBtn?.addEventListener('click', () => {
      const { selectedItems, subtotal, total } = recalculate();
      if (selectedItems.length === 0) return;

      const packageName = `Custom Snack Box (${selectedItems.length} item: ${selectedItems.join(', ')})`;
      const priceText = `${formatRp(subtotal)}/box (Total: ${formatRp(total)} untuk ${boxCount} box)`;

      window.dispatchEvent(
        new CustomEvent('open-order-modal', {
          detail: {
            packageName,
            price: priceText,
          },
        })
      );
    });

    // Jalankan kalkulasi awal
    recalculate();
  }

  initSnackBuilder();
</script>
