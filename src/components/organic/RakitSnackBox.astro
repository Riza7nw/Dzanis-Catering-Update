---
import {
  snackKategori,
  MIN_BOX,
} from '../../data/snack';
import { getSnackTemplates } from '../../services/api/menuService';
import SnackTemplateCarousel from '../snack/SnackTemplateCarousel.astro';
import SnackCategoryNav from '../snack/SnackCategoryNav.astro';
import SnackCatalogGrid from '../snack/SnackCatalogGrid.astro';
import SnackBuilderBar from '../snack/SnackBuilderBar.astro';

const totalSnackItems = snackKategori.reduce((sum, cat) => sum + cat.items.length, 0);
const snackTemplates = await getSnackTemplates();
---

<section id="rakit" class="px-[var(--space-4)] py-[var(--space-8)] lg:px-14 lg:py-20 bg-surface/60">
  <div class="mx-auto max-w-[1280px]">
    <!-- Section Header -->
    <div class="mb-8 lg:mb-12 flex flex-col items-center text-center">
      <span class="tag tag-accent text-xs uppercase tracking-widest font-bold mb-3">
        Interactive Snack Experience
      </span>
      <h1 class="font-heading text-[32px] leading-tight lg:text-[52px] lg:leading-[1] text-neutral-900 uppercase">
        Pemesanan Snack Box
      </h1>
      <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-neutral-800">
        Pilih paket template favorit dengan kolom isian fleksibel, atau rancang sendiri snack box impian dari {totalSnackItems} pilihan jajanan higienis.
      </p>
    </div>

    <!-- ================= PANEL 1: PAKET TEMPLATE & KUSTOMISASI KOLOM ================= -->
    <SnackTemplateCarousel snackTemplates={snackTemplates} totalSnackItems={totalSnackItems} />

    <!-- ================= PANEL 2: BUILDER CUSTOM DARI NOL ================= -->
    <div id="custom" class="scroll-mt-20"></div>
    <div id="panel-custom" class="mt-10 lg:mt-12 space-y-8">
      <div id="snack-builder" class="rounded-[32px] border border-divider bg-bg p-6 lg:p-10 shadow-[var(--shadow-lg)]">
        <!-- Portion & Box Settings Bar -->
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-divider pb-6">
          <div>
            <h2 class="font-heading text-2xl text-neutral-900">Rakit Custom Sendiri dari Nol</h2>
            <p class="text-xs text-neutral-600 mt-1">Centang jajanan yang ingin dimasukkan ke dalam setiap box secara bebas.</p>
          </div>
          <div class="flex items-center gap-3 bg-surface px-4 py-2 rounded-full border border-divider">
            <label for="builder-box-count" class="text-xs font-semibold text-neutral-800 cursor-pointer">Jumlah Box:</label>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="builder-box-minus"
                class="size-8 rounded-full border border-accent text-accent font-bold hover:bg-accent hover:text-bg transition-colors flex items-center justify-center cursor-pointer text-base disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-accent"
                aria-label="Kurangi jumlah box"
              >
                −
              </button>
              <input
                type="number"
                id="builder-box-count"
                name="boxCount"
                min={MIN_BOX}
                step="1"
                value={MIN_BOX}
                aria-label="Jumlah box"
                class="w-16 h-8 rounded-lg border border-neutral-300 bg-white px-2 text-center font-heading text-base font-bold text-neutral-900 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
              />
              <button
                type="button"
                id="builder-box-plus"
                class="size-8 rounded-full bg-accent text-bg font-bold hover:bg-accent-700 transition-colors flex items-center justify-center cursor-pointer text-base"
                aria-label="Tambah jumlah box"
              >
                +
              </button>
            </div>
            <span class="text-[11px] text-neutral-500">(Min. {MIN_BOX})</span>
          </div>
        </div>

        <!-- Filter Kategori Pill Buttons -->
        <SnackCategoryNav snackKategori={snackKategori} totalSnackItems={totalSnackItems} />

        <!-- Categories & Checkbox Grid -->
        <SnackCatalogGrid snackKategori={snackKategori} />

        <!-- Sticky / Bottom Summary Bar -->
        <SnackBuilderBar />
      </div>
    </div>
  </div>
</section>

<script>
  import { initSnackBoxController } from '../../scripts/snack-box-controller';
  initSnackBoxController();
</script>
