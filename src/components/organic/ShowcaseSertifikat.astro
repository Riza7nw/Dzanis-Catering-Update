---
// src/components/organic/ShowcaseSertifikat.astro
import { getShowcaseCertificates } from '../../services/api/certService';

const defaultCertificates = await getShowcaseCertificates();
---

<section class="py-14 bg-bg relative overflow-x-clip" id="showcase-sertifikat-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 relative">
    
    <!-- Header Bagian -->
    <div class="mb-8">
      <span class="text-[11px] font-bold tracking-[0.2em] text-accent-900 uppercase">DOKUMEN RESMI</span>
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-text mt-1">Showcase Sertifikat Resmi Berlaku</h2>
    </div>

    <!-- Kontainer Slider dengan Panah Melayang & Gap Ekstra -->
    <div class="relative px-2 sm:px-4 md:px-6">
      
      <!-- Tombol Panah Kiri (<) -->
      <button 
        type="button" 
        id="cert-prev-btn"
        aria-label="Halaman Sebelumnya"
        class="absolute -left-2 sm:-left-5 md:-left-7 lg:-left-10 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-surface border border-divider text-text hover:bg-accent-900 hover:text-bg hover:border-accent-900 shadow-md flex items-center justify-center transition-all duration-200 focus:outline-none cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Viewport Grid Kartu (2x2) -->
      <div class="overflow-hidden w-full rounded-2xl">
        <div 
          id="cert-slider-track" 
          class="flex transition-transform duration-500 ease-out will-change-transform"
          data-certificates={JSON.stringify(defaultCertificates)}
        >
          <!-- SSR Initial Render: First Page Preview -->
          <div class="w-full shrink-0 grid grid-cols-1 md:grid-cols-2 gap-5 px-1">
            {defaultCertificates.slice(0, 4).map(cert => (
              <div class="bg-surface border border-divider rounded-3xl p-6 flex flex-col justify-between hover:shadow-md transition duration-200">
                <div>
                  <div class="flex items-center justify-between text-xs mb-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-accent-2-200 text-accent-2-900 tracking-wider uppercase">{cert.badge || 'RESMI'}</span>
                    <span class="text-neutral-700 text-xs font-medium">{cert.date || '-'}</span>
                  </div>
                  <h3 class="font-heading font-bold text-text text-base sm:text-lg mt-3 leading-snug">{cert.title}</h3>
                  <p class="text-xs text-neutral-600 font-mono mt-1">No. {cert.no}</p>
                </div>

                <div class="flex items-center justify-between pt-5 mt-5 border-t border-divider text-xs">
                  <span class="font-bold text-neutral-600 text-[11px] tracking-wider uppercase">DOKUMEN TERVERIFIKASI</span>
                  <button 
                    type="button"
                    data-view-doc={cert.docUrl || '/images/brand/halal-cert.png'}
                    data-view-title={cert.title}
                    data-view-issuer={cert.issuer}
                    data-view-no={cert.no}
                    data-view-date={cert.date}
                    data-view-badge={cert.badge}
                    class="btn-view-cert text-accent-900 font-bold hover:underline flex items-center gap-1.5 transition cursor-pointer">
                    <span>Lihat Dokumen Asli</span>
                    <span>&rarr;</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Tombol Panah Kanan (>) -->
      <button 
        type="button" 
        id="cert-next-btn"
        aria-label="Halaman Selanjutnya"
        class="absolute -right-2 sm:-right-5 md:-right-7 lg:-right-10 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-surface border border-divider text-text hover:bg-accent-900 hover:text-bg hover:border-accent-900 shadow-md flex items-center justify-center transition-all duration-200 focus:outline-none cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

    </div>

    <!-- Indikator Titik Posisi (Pagination Dots) -->
    <div id="cert-dots-container" class="flex items-center justify-center gap-2 mt-8">
      <!-- Titik-titik aktif dirender oleh skrip -->
    </div>

  </div>
</section>

<script is:inline>
(function initCertShowcaseSlider() {
  const track = document.getElementById('cert-slider-track');
  const dotsContainer = document.getElementById('cert-dots-container');
  const prevBtn = document.getElementById('cert-prev-btn');
  const nextBtn = document.getElementById('cert-next-btn');

  if (!track) return;

  // Baca data sertifikat
  let certList = [];
  try {
    certList = JSON.parse(track.getAttribute('data-certificates') || '[]');
  } catch (e) {
    certList = [];
  }

  // Pengaturan Ukuran Halaman (Mobile: 2 kartu per slide, Desktop: 4 kartu per slide / 2x2)
  const getPageSize = () => (window.innerWidth < 768 ? 2 : 4);
  let pageSize = getPageSize();
  let currentPage = 0;
  let totalPages = Math.max(1, Math.ceil(certList.length / pageSize));

  // Render Seluruh Halaman Slide
  function renderSlides() {
    pageSize = getPageSize();
    totalPages = Math.max(1, Math.ceil(certList.length / pageSize));
    if (currentPage >= totalPages) currentPage = Math.max(0, totalPages - 1);

    let html = '';
    for (let p = 0; p < totalPages; p++) {
      const pageCerts = certList.slice(p * pageSize, (p + 1) * pageSize);
      
      html += `
        <div class="w-full shrink-0 grid grid-cols-1 md:grid-cols-2 gap-5 px-1">
          ${pageCerts.map(cert => `
            <div class="bg-surface border border-divider rounded-3xl p-6 flex flex-col justify-between hover:shadow-md transition duration-200">
              <div>
                <div class="flex items-center justify-between text-xs mb-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-accent-2-200 text-accent-2-900 tracking-wider uppercase">${cert.badge || 'RESMI'}</span>
                  <span class="text-neutral-700 text-xs font-medium">${cert.date || '-'}</span>
                </div>
                <h3 class="font-heading font-bold text-text text-base sm:text-lg mt-3 leading-snug">${cert.title}</h3>
                <p class="text-xs text-neutral-600 font-mono mt-1">No. ${cert.no}</p>
              </div>

              <div class="flex items-center justify-between pt-5 mt-5 border-t border-divider text-xs">
                <span class="font-bold text-neutral-600 text-[11px] tracking-wider uppercase">DOKUMEN TERVERIFIKASI</span>
                <button 
                  type="button"
                  data-view-doc="${cert.docUrl || '/images/brand/halal-cert.png'}"
                  data-view-title="${cert.title}"
                  data-view-issuer="${cert.issuer || ''}"
                  data-view-no="${cert.no || ''}"
                  data-view-date="${cert.date || ''}"
                  data-view-badge="${cert.badge || 'RESMI'}"
                  class="btn-view-cert text-accent-900 font-bold hover:underline flex items-center gap-1.5 transition cursor-pointer">
                  <span>Lihat Dokumen Asli</span>
                  <span>&rarr;</span>
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    track.innerHTML = html;
    updateTrackPosition();
    renderDots();
  }

  // Pembaruan Posisi Slide
  function updateTrackPosition() {
    track.style.transform = `translateX(-${currentPage * 100}%)`;
    updateDots();
  }

  // Render Indikator Titik
  function renderDots() {
    if (!dotsContainer) return;
    dotsContainer.innerHTML = '';
    
    if (totalPages <= 1) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      return;
    } else {
      if (prevBtn) prevBtn.style.display = 'flex';
      if (nextBtn) nextBtn.style.display = 'flex';
    }

    for (let i = 0; i < totalPages; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = `h-2 rounded-full transition-all duration-300 focus:outline-none cursor-pointer ${i === currentPage ? 'w-7 bg-accent-900' : 'w-2 bg-neutral-300 hover:bg-neutral-400'}`;
      dot.setAttribute('aria-label', `Halaman ${i + 1}`);
      dot.addEventListener('click', () => {
        currentPage = i;
        updateTrackPosition();
      });
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots() {
    if (!dotsContainer) return;
    const dots = dotsContainer.querySelectorAll('button');
    dots.forEach((dot, idx) => {
      if (idx === currentPage) {
        dot.className = 'h-2 w-7 rounded-full bg-accent-900 transition-all duration-300 focus:outline-none cursor-pointer';
      } else {
        dot.className = 'h-2 w-2 rounded-full bg-neutral-300 hover:bg-neutral-400 transition-all duration-300 focus:outline-none cursor-pointer';
      }
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      currentPage = currentPage > 0 ? currentPage - 1 : totalPages - 1;
      updateTrackPosition();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      currentPage = currentPage < totalPages - 1 ? currentPage + 1 : 0;
      updateTrackPosition();
    });
  }

  // Touch Swipe
  let touchStartX = 0;
  track.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  track.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 40) {
      if (diff > 0) nextBtn && nextBtn.click();
      else prevBtn && prevBtn.click();
    }
  }, { passive: true });

  // Event Delegation Lightbox Modal Trigger
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.btn-view-cert');
    if (target) {
      const docUrl = target.getAttribute('data-view-doc') || '';
      const title = target.getAttribute('data-view-title') || 'Dokumen Sertifikat';
      const issuer = target.getAttribute('data-view-issuer') || 'Dzanis Catering';
      const certNumber = target.getAttribute('data-view-no') || '-';
      const validUntil = target.getAttribute('data-view-date') || 'Aktif';
      const badge = target.getAttribute('data-view-badge') || 'RESMI';

      if (typeof window.openCertLightbox === 'function') {
        window.openCertLightbox({
          title,
          issuer,
          certNumber,
          validUntil,
          badge,
          documentUrl: docUrl,
          fileType: docUrl.toLowerCase().endsWith('.pdf') ? 'pdf' : 'image'
        });
      }
    }
  });

  renderSlides();
  window.addEventListener('resize', () => {
    const newPageSize = getPageSize();
    if (newPageSize !== pageSize) {
      renderSlides();
    }
  });
})();
</script>
