---
// src/components/sertifikat/CertB2BProcurementCta.astro
import { company } from '../../data/company';
import { buildWhatsAppUrl } from '../../services/whatsapp/waUrl';

const waMessage = `Halo Tim Dzanis Catering, saya ingin konsultasi menu dan kelengkapan dokumen legalitas/administrasi untuk rencana acara kami.`;
const waUrl = buildWhatsAppUrl(company.contact.whatsapp, waMessage);
---

<section class="py-8 sm:py-14 bg-bg">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <div class="rounded-3xl border border-divider bg-surface p-6 sm:p-10 lg:p-12 shadow-xs">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent-300/80 bg-accent-200/50 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-accent-900">
          <span>Kebutuhan Acara &amp; Pengadaan Resmi</span>
        </div>

        <h2 class="mt-3.5 font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-text leading-tight">
          Konsultasi Pesanan &amp; Kesiapan Administrasi
        </h2>

        <p class="mt-2.5 sm:mt-3 text-xs sm:text-base leading-relaxed text-neutral-700">
          Baik untuk syukuran keluarga, pernikahan, maupun konsumsi kantor dan dinas instansi, Dzanis Catering siap melayani dengan hidangan higienis dan dukungan administrasi resmi lengkap.
        </p>

        <!-- Kesiapan Administrasi Ringkas -->
        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3 text-xs sm:text-sm text-neutral-800">
          <div class="flex items-center gap-2">
            <span class="text-accent-900 font-bold" aria-hidden="true">&#10003;</span>
            <span>Kwitansi Resmi Bermeterai</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-accent-900 font-bold" aria-hidden="true">&#10003;</span>
            <span>Surat Pesanan Kerja (SPK) &amp; BAST</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-accent-900 font-bold" aria-hidden="true">&#10003;</span>
            <span>Faktur Pajak &amp; NPWP Terdaftar</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-accent-900 font-bold" aria-hidden="true">&#10003;</span>
            <span>Pengantaran Tepat Waktu se-Ciayumajakuning</span>
          </div>
        </div>

        <!-- Single Terracotta CTA Button (Matching Main Site Visual Language) -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-5">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary min-h-[48px] px-6 sm:px-8 py-3 text-sm sm:text-base font-semibold shadow-xs hover:shadow transition touch-manipulation inline-flex items-center justify-center gap-2"
          >
            <svg class="size-4.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Konsultasi via WhatsApp</span>
          </a>

          <p class="text-xs text-neutral-600">
            Nomor Resmi: <strong class="text-text font-semibold">{company.contact.whatsappDisplay}</strong> &bull; Respon Cepat Setiap Hari
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
