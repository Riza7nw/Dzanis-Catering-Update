---
// src/components/sertifikat/CertB2BProcurementCta.astro
import { company } from '../../data/company';
import { buildWhatsAppUrl } from '../../services/whatsapp/waUrl';

const b2bWaMessage = `Halo Tim Dzanis Catering, kami memerlukan kelengkapan dokumen legalitas usaha dan penawaran menu katering untuk pengadaan acara instansi/kantor. Mohon bantuannya.`;
const waUrl = buildWhatsAppUrl(company.contact.whatsapp, b2bWaMessage);
---

<section class="bg-accent-900 text-bg relative overflow-hidden pt-10 pb-8 sm:pt-16 sm:pb-14 px-4 sm:px-6 lg:px-0">
  <!-- Subtle decorative lighting -->
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-accent-400/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1280px] lg:px-14">
    <div class="grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-center">
      <!-- Left side: Value proposition -->
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent-200">
          <span>💼</span>
          <span>Kesiapan Pengadaan B2B &amp; Instansi Pemerintah</span>
        </div>
        <h2 class="mt-4 font-heading text-2xl font-bold sm:text-3xl lg:text-4xl text-bg leading-tight">
          Butuh Berkas Administrasi Lengkap untuk SPK / LPJ Acara Anda?
        </h2>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-accent-200/90 max-w-xl">
          Kami berpengalaman melayani pengadaan nasi kotak dan prasmanan untuk kantor dinas, BUMN, perbankan, dan perusahaan di Majalengka &amp; sekitarnya. Seluruh administrasi pendukung siap diterbitkan sesuai regulasi pengadaan.
        </p>

        <!-- Procurement Checklist -->
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-w-xl mx-auto mb-6 text-sm text-bg/95">
          <div class="flex items-center gap-2.5">
            <svg class="size-4.5 text-accent-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span>Kwitansi Resmi Bermeterai</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="size-4.5 text-accent-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span>Surat Pesanan Kerja (SPK) / MOU</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="size-4.5 text-accent-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span>Faktur Pajak &amp; NPWP Badan</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="size-4.5 text-accent-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span>Berita Acara Serah Terima (BAST)</span>
          </div>
        </div>
      </div>

      <!-- Right side: Fast CTA Card -->
      <div class="rounded-[28px] border border-white/20 bg-surface p-6 text-text shadow-[var(--shadow-lg)]">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-700">
          KONSULTASI PENGADAAN CEPAT
        </p>
        <h3 class="mt-1 font-heading text-xl font-bold text-text">
          Hubungi Spesialis Vendor Resmi
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-neutral-700">
          Diskusikan kuota porsi, jadwal pengantaran tepat waktu, dan permohonan bundel Company Profile beserta salinan legalitas usaha.
        </p>

        <div class="mt-5">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#25D366] hover:bg-[#20ba5a] text-white font-semibold shadow-md py-3.5 px-6 rounded-xl flex items-center justify-center gap-2.5 w-full sm:w-auto mx-auto min-h-[48px] touch-manipulation transition-colors"
          >
            <svg class="size-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Konsultasi Pengadaan via WhatsApp</span>
          </a>

          <p class="text-xs text-text-muted text-center mt-2.5">
            Nomor Resmi: <span class="font-semibold text-text">{company.contact.whatsappDisplay}</span> • Respon Cepat Setiap Hari
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
