---
// src/components/sertifikat/CertHero.astro
import { company } from '../../data/company';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section class={`bg-accent-900 text-bg relative overflow-hidden ${className}`}>
  <!-- Subtle geometric background accent -->
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-white/5 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-accent-400/10 blur-2xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1280px] px-4 py-8 sm:px-6 lg:px-14 lg:py-12">
    <!-- Breadcrumb / Pre-header tag -->
    <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-300">
      <span class="inline-flex h-2 w-2 rounded-full bg-accent-300 animate-pulse" aria-hidden="true"></span>
      <span>Akuntabilitas &amp; Legalitas Jasaboga Resmi</span>
    </div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-center lg:gap-12">
      <!-- Main Headline & Value Statement -->
      <div>
        <h1 class="max-w-[580px] font-heading text-3xl font-bold leading-[1.1] tracking-[-0.03em] text-bg sm:text-4xl lg:text-5xl">
          Sertifikasi Resmi, Sanitasi Higienis &amp; Jaminan Halal Terbuka
        </h1>
        <p class="mt-4 max-w-[620px] text-sm leading-relaxed text-accent-200/90 sm:text-base">
          Dzanis Catering menjaga standar tertinggi keamanan pangan di Majalengka dan Ciayumajakuning. Seluruh operasional dapur, uji mikrobiologi, sanitasi penjamah makanan, hingga izin berusaha telah terverifikasi secara resmi oleh otoritas pemerintah.
        </p>

        <!-- Fast Badges -->
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-bg backdrop-blur-sm">
            <span class="text-accent-300">✓</span> 100% Halal BPJPH Kemenag
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-bg backdrop-blur-sm">
            <span class="text-accent-300">✓</span> SLHS Dinkes Kab. Majalengka
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-medium text-bg backdrop-blur-sm">
            <span class="text-accent-300">✓</span> Legalitas NIB OSS-RBA (KBLI 56210)
          </div>
        </div>
      </div>

      <!-- Trust Credential Card (Anti-Slop ID Matrix) -->
      <div class="rounded-[28px] border border-white/20 bg-surface p-5 text-text shadow-[var(--shadow-lg)] sm:p-6 backdrop-blur-sm">
        <div class="flex items-center justify-between border-b border-divider pb-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-900 text-bg font-heading font-black text-sm">
              DZ
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-neutral-700">
                Identitas Legal Usaha
              </p>
              <p class="font-heading text-lg font-bold text-text">
                {company.brandName}
              </p>
            </div>
          </div>
          <span class="rounded-full bg-accent-2-200 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-accent-2-900">
            Terverifikasi Aktif
          </span>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
          <div class="rounded-2xl border border-divider bg-bg/80 p-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-neutral-700">NIB OSS-RBA</p>
            <p class="mt-1 font-mono font-bold text-text">1209230045678</p>
            <p class="text-[9px] text-neutral-600 mt-0.5">KBLI 56210 (Jasa Boga)</p>
          </div>
          <div class="rounded-2xl border border-divider bg-bg/80 p-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-neutral-700">ID Halal BPJPH</p>
            <p class="mt-1 font-mono font-bold text-text">ID3211000123456</p>
            <p class="text-[9px] text-neutral-600 mt-0.5">MUI &amp; Kemenag RI</p>
          </div>
          <div class="rounded-2xl border border-divider bg-bg/80 p-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-neutral-700">No. WhatsApp Resmi</p>
            <p class="mt-1 font-bold text-text">{company.contact.whatsappDisplay}</p>
            <p class="text-[9px] text-neutral-600 mt-0.5">Layanan Pengadaan &amp; Order</p>
          </div>
          <div class="rounded-2xl border border-divider bg-bg/80 p-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-neutral-700">Wilayah Layanan</p>
            <p class="mt-1 font-bold text-text">{company.ketentuan.areaAntarRingkas}</p>
            <p class="text-[9px] text-neutral-600 mt-0.5">{company.contact.address}</p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between rounded-xl bg-accent-200/50 px-3.5 py-2.5 text-[11px] text-accent-900 border border-accent-300/40">
          <div class="flex items-center gap-2">
            <span class="text-sm">🛡️</span>
            <span class="font-semibold">Standar Laik Higiene Sanitasi (SLHS) Aktif</span>
          </div>
          <span class="font-mono text-[10px] font-bold text-neutral-800">DINKES KAB. MAJALENGKA</span>
        </div>
      </div>
    </div>
  </div>
</section>
