---
// src/components/sertifikat/CertHero.astro
import { company } from '../../data/company';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<header class={`bg-surface/30 border-b border-divider/60 ${className}`}>
  <div class="mx-auto max-w-[1280px] px-4 pt-8 pb-8 sm:pt-12 sm:pb-12 lg:px-14">
    <!-- Asymmetric 2-Column Split Editorial Hero (12 Cols: 7 + 5) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- KOLOM KIRI (lg:col-span-7): Headline, Intro & Status Pills -->
      <div class="lg:col-span-7">
        <!-- Eyebrow Pill Terakota -->
        <div class="inline-flex items-center gap-2 rounded-full border border-accent-300/80 bg-accent-200/40 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-accent-900">
          <span class="inline-block size-1.5 rounded-full bg-accent-900" aria-hidden="true"></span>
          <span>Akuntabilitas &amp; Legalitas Usaha</span>
        </div>

        <!-- Judul Utama dengan Penekanan Warna Terakota -->
        <h1 class="mt-3.5 font-heading text-2xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-text leading-[1.18]">
          Sertifikat &amp; Legalitas Resmi <span class="text-accent-900">Dzanis Catering</span>
        </h1>

        <!-- Deskripsi Ringkas Hangat -->
        <p class="mt-2.5 sm:mt-3 text-xs sm:text-base leading-relaxed text-neutral-700 max-w-xl">
          Standar keamanan pangan, higienitas dapur, dan kepatuhan perizinan berusaha telah terverifikasi resmi untuk menjamin rasa aman dan kenyamanan setiap acara Anda di Majalengka.
        </p>

        <!-- 3 Inline Status Pills -->
        <div class="mt-5 sm:mt-6 flex flex-wrap items-center gap-2 sm:gap-2.5" aria-label="Status verifikasi resmi">
          <div class="inline-flex items-center gap-2 rounded-full border border-accent-2-300 bg-accent-2-200/50 px-3 py-1 sm:px-3.5 sm:py-1.5 text-[11px] sm:text-xs font-semibold text-accent-2-900">
            <span class="inline-block size-1.5 rounded-full bg-accent-2-700" aria-hidden="true"></span>
            <span>Halal BPJPH Kemenag</span>
            <span class="text-[10px] sm:text-[11px] text-accent-2-800/80 font-normal">| Terverifikasi</span>
          </div>

          <div class="inline-flex items-center gap-2 rounded-full border border-accent-2-300 bg-accent-2-200/50 px-3 py-1 sm:px-3.5 sm:py-1.5 text-[11px] sm:text-xs font-semibold text-accent-2-900">
            <span class="inline-block size-1.5 rounded-full bg-accent-2-700" aria-hidden="true"></span>
            <span>SLHS Dinkes Majalengka</span>
            <span class="text-[10px] sm:text-[11px] text-accent-2-800/80 font-normal">| Laik Higiene</span>
          </div>

          <div class="inline-flex items-center gap-2 rounded-full border border-accent-2-300 bg-accent-2-200/50 px-3 py-1 sm:px-3.5 sm:py-1.5 text-[11px] sm:text-xs font-semibold text-accent-2-900">
            <span class="inline-block size-1.5 rounded-full bg-accent-2-700" aria-hidden="true"></span>
            <span>NIB OSS BKPM</span>
            <span class="text-[10px] sm:text-[11px] text-accent-2-800/80 font-normal">| KBLI 56210</span>
          </div>
        </div>
      </div>

      <!-- KOLOM KANAN (lg:col-span-5): Kartu Ringkasan Verifikasi Legalitas yang Berkelas -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-divider bg-surface p-5 sm:p-6 shadow-[var(--shadow-md)] relative overflow-hidden transition-all duration-200 hover:shadow-[var(--shadow-lg)] hover:border-accent-900/30">
          <!-- Card Top Row -->
          <div class="flex items-center justify-between border-b border-divider/70 pb-3.5">
            <div class="flex items-center gap-3">
              <div class="flex size-10 items-center justify-center rounded-xl bg-accent-900 text-bg font-heading font-black text-sm shrink-0 shadow-xs">
                DZ
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-neutral-600 truncate">
                  Kartu Verifikasi Usaha
                </p>
                <p class="font-heading text-base font-bold text-text truncate">
                  {company.brandName}
                </p>
              </div>
            </div>
            <span class="rounded-full bg-accent-2-200/80 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-accent-2-900 border border-accent-2-300 shrink-0">
              Terverifikasi Aktif
            </span>
          </div>

          <!-- Points Grid: 3 Legalitas Kunci -->
          <div class="mt-4 space-y-2.5 text-xs">
            <!-- Item 1: Halal BPJPH -->
            <div class="flex items-start justify-between gap-2 rounded-xl bg-bg/90 p-2.5 border border-divider/60">
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-500">Halal BPJPH Kemenag RI</p>
                <p class="font-mono font-bold text-xs text-text mt-0.5">ID3211000123456</p>
              </div>
              <span class="text-[10px] text-accent-2-800 font-semibold bg-accent-2-200/60 px-2 py-0.5 rounded border border-accent-2-300/60 shrink-0">
                MUI &amp; Kemenag
              </span>
            </div>

            <!-- Item 2: NIB OSS BKPM -->
            <div class="flex items-start justify-between gap-2 rounded-xl bg-bg/90 p-2.5 border border-divider/60">
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-500">NIB OSS-RBA BKPM</p>
                <p class="font-mono font-bold text-xs text-text mt-0.5">1209230045678</p>
              </div>
              <span class="text-[10px] text-neutral-700 font-medium bg-neutral-200/70 px-2 py-0.5 rounded border border-neutral-300/60 shrink-0">
                KBLI 56210
              </span>
            </div>

            <!-- Item 3: SLHS Dinkes -->
            <div class="flex items-start justify-between gap-2 rounded-xl bg-bg/90 p-2.5 border border-divider/60">
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-neutral-500">SLHS Dinas Kesehatan</p>
                <p class="font-bold text-xs text-text mt-0.5">Kabupaten Majalengka</p>
              </div>
              <span class="text-[10px] text-accent-2-800 font-semibold bg-accent-2-200/60 px-2 py-0.5 rounded border border-accent-2-300/60 shrink-0">
                Laik Higiene
              </span>
            </div>
          </div>

          <!-- Bottom Action: Smooth Anchor ke #daftar-sertifikat -->
          <a
            href="#daftar-sertifikat"
            class="mt-4 flex items-center justify-between rounded-xl bg-accent-100/70 hover:bg-accent-200/70 border border-accent-300/70 px-3.5 py-2.5 text-xs font-semibold text-accent-900 transition-colors group touch-manipulation"
          >
            <span>Jelajahi Berkas &amp; Dokumen Asli</span>
            <span class="group-hover:translate-y-0.5 transition-transform" aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</header>
