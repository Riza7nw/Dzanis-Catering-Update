---
// src/components/sertifikat/CertShowcaseGrid.astro
import type { ShowcaseCertificateItem, LegalCardItem } from '../../services/api/certService';

interface Props {
  certificates: ShowcaseCertificateItem[];
  legalDocuments: LegalCardItem[];
  publicApiUrl?: string;
}

const { certificates = [], legalDocuments = [], publicApiUrl = '' } = Astro.props;

// Combine into unified list with clear categories and normalized asset URLs
const allDocuments = [
  ...certificates.map(item => {
    let docUrl = item.documentUrl || item.docUrl || '';
    if (typeof docUrl === 'string' && docUrl.trim().length > 0) {
      if (docUrl.startsWith('uploads/')) docUrl = '/' + docUrl;
      if (docUrl.startsWith('/uploads/')) {
        const base = publicApiUrl || 'https://dzaniez-back.ethiodeploy.app';
        docUrl = `${base}${docUrl}`;
      }
    }
    return {
      id: String(item.id),
      title: item.title,
      issuer: item.issuer,
      certNumber: item.certNumber || item.no,
      validUntil: item.validUntil || item.date,
      badge: item.badge || 'RESMI',
      category: 'sertifikat',
      categoryLabel: 'Sertifikasi Mutu & Halal',
      documentUrl: docUrl,
      fileType: item.fileType || 'image',
      detail: `Dokumen sah diterbitkan oleh ${item.issuer}. Keaslian dapat diverifikasi langsung melalui nomor registrasi resmi.`
    };
  }),
  ...legalDocuments.map(item => {
    let docUrl = item.document_url || item.documentUrl || '';
    if (typeof docUrl === 'string' && docUrl.trim().length > 0) {
      if (docUrl.startsWith('uploads/')) docUrl = '/' + docUrl;
      if (docUrl.startsWith('/uploads/')) {
        const base = publicApiUrl || 'https://dzaniez-back.ethiodeploy.app';
        docUrl = `${base}${docUrl}`;
      }
    }
    return {
      id: String(item.id),
      title: item.label || item.title,
      issuer: item.issuer,
      certNumber: item.certNumber || '-',
      validUntil: item.validUntil || 'Aktif',
      badge: item.status || item.badge || 'LEGAL',
      category: 'legalitas',
      categoryLabel: 'Legalitas Usaha & Pajak',
      documentUrl: docUrl,
      fileType: item.file_type || item.fileType || 'image',
      detail: item.detail || `Legalitas resmi operasional Dzanis Catering untuk jaminan kepatuhan hukum.`
    };
  })
];

function getDocVisual(doc: { badge: string; title: string }) {
  const b = (doc.badge || '').toLowerCase();
  const t = (doc.title || '').toLowerCase();

  if (b.includes('slhs') || t.includes('slhs') || t.includes('laik') || t.includes('higiene') || t.includes('sanitasi')) {
    return {
      type: 'slhs',
      header: 'PEMKAB MAJALENGKA',
      subHeader: 'DINAS KESEHATAN KAB. MAJALENGKA',
      docType: 'SERTIFIKAT LAIK HIGIENE SANITASI',
      subDocType: 'Jasaboga Golongan A2 / Catering Resmi',
      accentColor: 'text-emerald-900',
      tagText: 'KESEHATAN',
      tagClass: 'bg-emerald-100 text-emerald-800 border-emerald-300',
      stampText: 'LAIK HIGIENE RESMI',
      stampBorder: 'border-emerald-700 text-emerald-800 bg-emerald-50/90',
      bgTheme: 'from-emerald-50/70 via-white to-surface/90',
      iconEmoji: '🛡️'
    };
  }
  if (b.includes('k3') || t.includes('penjamah') || t.includes('k3')) {
    return {
      type: 'k3',
      header: 'STANDAR K3 & MUTU PANGAN',
      subHeader: 'BALAI PELATIHAN & KOMPETENSI',
      docType: 'SERTIFIKAT PENJAMAH MAKANAN',
      subDocType: 'Higiene Sanitasi Pengolahan Dapur',
      accentColor: 'text-amber-900',
      tagText: 'K3 PANGAN',
      tagClass: 'bg-amber-100 text-amber-800 border-amber-300',
      stampText: 'KOMPETEN & SAH',
      stampBorder: 'border-amber-700 text-amber-800 bg-amber-50/90',
      bgTheme: 'from-amber-50/70 via-white to-surface/90',
      iconEmoji: '⭐'
    };
  }
  if (b.includes('nib') || b.includes('legal') || t.includes('nib') || t.includes('izin')) {
    return {
      type: 'nib',
      header: 'REPUBLIK INDONESIA',
      subHeader: 'KEMENTERIAN INVESTASI / BKPM',
      docType: 'NOMOR INDUK BERUSAHA (NIB)',
      subDocType: 'KBLI 56210 • Jasa Boga Event Tertentu',
      accentColor: 'text-neutral-900',
      tagText: 'OSS RBA',
      tagClass: 'bg-neutral-200/80 text-neutral-800 border-neutral-300',
      stampText: 'OSS RBA AKTIF',
      stampBorder: 'border-neutral-700 text-neutral-800 bg-neutral-100/90',
      bgTheme: 'from-stone-100/70 via-white to-surface/90',
      iconEmoji: '⚖️'
    };
  }
  if (b.includes('lab') || t.includes('lab') || t.includes('uji') || t.includes('mikro')) {
    return {
      type: 'lab',
      header: 'LABKESDA & KEAMANAN PANGAN',
      subHeader: 'PENGUJIAN MUTU AIR & MIKROBIOLOGI',
      docType: 'HASIL UJI LABORATORIUM RESMI',
      subDocType: 'Bebas Cemaran Kimia & Bakteri Patogen',
      accentColor: 'text-teal-900',
      tagText: 'TERUJI LAB',
      tagClass: 'bg-teal-100 text-teal-800 border-teal-300',
      stampText: 'MEMENUHI SYARAT',
      stampBorder: 'border-teal-700 text-teal-800 bg-teal-50/90',
      bgTheme: 'from-teal-50/70 via-white to-surface/90',
      iconEmoji: '🔬'
    };
  }
  return {
    type: 'pangan',
    header: 'PENGAWASAN KEAMANAN PANGAN',
    subHeader: 'DINAS KESEHATAN KAB. MAJALENGKA',
    docType: 'SERTIFIKASI KEAMANAN PANGAN',
    subDocType: 'Inspeksi Dapur & Sanitasi Berkala',
    accentColor: 'text-accent-900',
    tagText: 'TERDAFTAR',
    tagClass: 'bg-orange-100 text-accent-900 border-accent-300',
    stampText: 'TERVERIFIKASI RESMI',
    stampBorder: 'border-accent-900 text-accent-900 bg-orange-50/90',
    bgTheme: 'from-orange-50/70 via-white to-surface/90',
    iconEmoji: '📋'
  };
}
---

<section class="py-5 sm:py-8 bg-bg relative" id="daftar-sertifikat">
  <!-- Anchor alias for backward compatibility -->
  <span id="dokumen-resmi" class="sr-only" aria-hidden="true"></span>

  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <!-- Clean Category Filter Pills Bar (Directly Above the Cards - Above the Fold) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 sm:pb-5 border-b border-divider">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2 w-2 rounded-full bg-accent-900" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-text">Daftar Dokumen Resmi</span>
        <span class="text-xs text-neutral-600">({allDocuments.length} Berkas)</span>
      </div>

      <!-- Minimalist Category Filter Pills -->
      <div 
        class="flex flex-nowrap overflow-x-auto no-scrollbar gap-1.5 sm:gap-2 pb-1 sm:pb-0 overscroll-x-contain touch-manipulation w-full sm:w-auto" 
        role="tablist" 
        aria-label="Filter kategori dokumen"
      >
        <button
          type="button"
          data-filter="all"
          class="cert-filter-btn active-filter shrink-0 min-h-[36px] sm:min-h-[40px] px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider transition cursor-pointer border border-accent-900 bg-accent-900 text-bg shadow-2xs flex items-center justify-center touch-manipulation"
        >
          Semua Dokumen ({allDocuments.length})
        </button>
        <button
          type="button"
          data-filter="sertifikat"
          class="cert-filter-btn shrink-0 min-h-[36px] sm:min-h-[40px] px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider transition cursor-pointer border border-divider bg-surface text-neutral-800 hover:border-accent-900/40 flex items-center justify-center touch-manipulation"
        >
          Sertifikasi Mutu ({certificates.length})
        </button>
        <button
          type="button"
          data-filter="legalitas"
          class="cert-filter-btn shrink-0 min-h-[36px] sm:min-h-[40px] px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider transition cursor-pointer border border-divider bg-surface text-neutral-800 hover:border-accent-900/40 flex items-center justify-center touch-manipulation"
        >
          Izin Usaha &amp; Pajak ({legalDocuments.length})
        </button>
      </div>
    </div>

    <!-- Document Cards Grid (2 Kolom Ringkas di Mobile, 3 di Desktop) -->
    <div 
      id="cert-documents-grid" 
      class="mt-4 sm:mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6"
      data-api-url={publicApiUrl}
    >
      {allDocuments.map((doc) => {
        const payloadStr = JSON.stringify({
          title: doc.title,
          issuer: doc.issuer,
          certNumber: doc.certNumber,
          validUntil: doc.validUntil,
          badge: doc.badge,
          documentUrl: doc.documentUrl,
          fileType: doc.fileType,
          detail: doc.detail
        });

        const isHalalOrSanitasi = doc.badge.toLowerCase().includes('halal') || doc.badge.toLowerCase().includes('slhs');
        const badgeColorClass = isHalalOrSanitasi
          ? 'bg-accent-2-200 text-accent-2-900 border-accent-2-300'
          : 'bg-accent-200 text-accent-900 border-accent-300';

        const hasRealScan = Boolean(doc.documentUrl && doc.documentUrl.trim().length > 0);
        const visual = getDocVisual(doc);

        return (
          <article 
            class="cert-card group flex flex-col justify-between rounded-2xl sm:rounded-[24px] border border-divider bg-surface p-2.5 sm:p-5 shadow-[var(--shadow-md)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] hover:border-accent-900/30 cursor-pointer touch-manipulation"
            data-category={doc.category}
            data-cert={payloadStr}
            tabindex="0"
            role="button"
            aria-label={`Buka pratinjau dokumen ${doc.title}`}
          >
            <!-- Card Upper Section: Badge & Document Framing -->
            <div>
              <div class="flex items-center justify-between gap-1 sm:gap-2">
                <span class={`rounded-full px-2 sm:px-2.5 py-0.5 sm:py-1 text-[8px] sm:text-[10px] font-bold uppercase tracking-wider border ${badgeColorClass} truncate max-w-[62%] sm:max-w-none`}>
                  {doc.badge}
                </span>
                <span class="inline-flex items-center gap-1 sm:gap-1.5 text-[9px] sm:text-[11px] font-medium text-neutral-700 shrink-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent-2-700"></span>
                  <span class="truncate max-w-[65px] sm:max-w-none">{doc.validUntil}</span>
                </span>
              </div>

              <!-- Document Preview Thumbnail Canvas (Proporsional aspect-[4/3] framed) -->
              <div class="relative mt-2 sm:mt-4 overflow-hidden rounded-lg sm:rounded-xl border border-divider/70 bg-bg p-1.5 sm:p-2.5 shadow-inner group-hover:border-accent-900/30 transition">
                <div class="relative flex items-center justify-center aspect-[4/3] w-full overflow-hidden rounded-md sm:rounded-lg bg-neutral-100 border border-neutral-200/80 shadow-xs">
                  {hasRealScan ? (
                    <>
                      <img
                        src={doc.documentUrl}
                        alt={`Pindaian Dokumen Resmi: ${doc.title}`}
                        width="400"
                        height="300"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-contain object-center transition duration-300 group-hover:scale-105"
                        onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.setAttribute('src','/images/brand/halal-cert.png');}"
                      />
                      <div class="pointer-events-none absolute bottom-1 right-1 sm:bottom-2 sm:right-2 rounded sm:rounded-md bg-accent-900/80 px-1.5 py-0.5 text-[8px] sm:text-[9px] font-bold uppercase tracking-wider text-bg backdrop-blur-sm shadow-sm">
                        Verified
                      </div>
                    </>
                  ) : (
                    <div class={`relative flex flex-col justify-between aspect-[4/3] w-full p-2 sm:p-3 bg-gradient-to-b ${visual.bgTheme} text-center select-none`}>
                      <div class="border-b border-divider/70 pb-1 flex items-center justify-between gap-1 text-left">
                        <div class="min-w-0">
                          <p class="text-[7px] sm:text-[8px] font-bold uppercase tracking-wider text-neutral-500 truncate">{visual.header}</p>
                          <p class="text-[7.5px] sm:text-[8.5px] font-bold text-neutral-800 truncate">{visual.subHeader}</p>
                        </div>
                        <span class="text-xs sm:text-sm shrink-0" aria-hidden="true">{visual.iconEmoji}</span>
                      </div>

                      <div class="my-auto py-0.5 flex flex-col items-center justify-center">
                        <span class={`rounded-full px-1.5 py-0.2 text-[6.5px] sm:text-[7.5px] font-bold uppercase tracking-wider border ${visual.tagClass} mb-0.5 shrink-0`}>
                          {visual.tagText}
                        </span>
                        <p class={`font-heading font-black text-[9px] sm:text-xs tracking-tight ${visual.accentColor} uppercase leading-tight line-clamp-1`}>
                          {visual.docType}
                        </p>
                        <p class="text-[7px] sm:text-[8px] text-neutral-600 mt-0.5 line-clamp-1">
                          {visual.subDocType}
                        </p>
                      </div>

                      <div class="border-t border-divider/70 pt-0.5 flex items-center justify-between gap-1 text-left">
                        <div class="min-w-0">
                          <p class="text-[6.5px] sm:text-[7px] uppercase tracking-wider text-neutral-500 font-semibold">No. Registrasi</p>
                          <p class="font-mono text-[7.5px] sm:text-[9px] font-bold text-accent-900 truncate">{doc.certNumber}</p>
                        </div>
                        <div class={`border border-dashed ${visual.stampBorder} rounded px-1 py-0.2 text-[6px] sm:text-[7px] font-black tracking-wider uppercase rotate-[-2deg] shrink-0 shadow-2xs`}>
                          {visual.stampText}
                        </div>
                      </div>
                    </div>
                  )}
                </div>

                <!-- Hover/Focus Overlay Trigger (Desktop Only) -->
                <div
                  class="hidden sm:flex absolute inset-0 items-center justify-center bg-black/40 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100 text-bg font-heading font-semibold text-xs gap-1.5 touch-manipulation pointer-events-none"
                  aria-hidden="true"
                >
                  <span class="rounded-full bg-accent-900 px-3.5 py-2 shadow-lg flex items-center gap-1.5 hover:bg-accent-700 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                    </svg>
                    <span>Perbesar Dokumen</span>
                  </span>
                </div>
              </div>

              <!-- Document Meta -->
              <div class="mt-2 sm:mt-4">
                <h3 class="font-heading text-xs sm:text-base lg:text-lg font-bold leading-snug text-text group-hover:text-accent-900 transition-colors line-clamp-1" title={doc.title}>
                  {doc.title}
                </h3>
                <p class="mt-0.5 sm:mt-1 text-[10px] sm:text-xs text-neutral-700 line-clamp-1 sm:line-clamp-2" title={doc.issuer}>
                  {doc.issuer}
                </p>
                <div class="mt-1.5 sm:mt-3 flex items-center justify-between gap-1 sm:gap-2 rounded-lg sm:rounded-xl bg-bg px-2 sm:px-3 py-1 sm:py-2 border border-divider/60">
                  <span class="text-[8px] sm:text-[10px] uppercase tracking-wider text-neutral-600 font-medium shrink-0">No. Reg:</span>
                  <span 
                    class="font-mono text-[9px] sm:text-xs font-bold text-accent-900 select-all cursor-text py-0.5 px-1 rounded hover:bg-accent-100/60 truncate" 
                    title="Pilih nomor untuk salin"
                    data-copy-number="true"
                  >
                    {doc.certNumber}
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <div class="mt-2.5 sm:mt-5 border-t border-divider/60 pt-2 sm:pt-3 flex items-center justify-between">
              <span class="hidden sm:inline text-[10px] font-bold uppercase tracking-wider text-neutral-600">
                Dokumen Sah
              </span>
              <span class="sm:hidden text-[9px] font-medium text-neutral-500">
                Resmi
              </span>
              <span
                class="inline-flex min-h-[36px] sm:min-h-[44px] items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1 sm:py-2 rounded-lg sm:rounded-xl text-[11px] sm:text-xs font-bold text-accent-900 group-hover:text-accent-700 group-hover:bg-neutral-100 transition cursor-pointer touch-manipulation ml-auto pointer-events-none"
                aria-hidden="true"
              >
                <span>Lihat</span>
                <span class="hidden sm:inline">Berkas Asli</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  let certGridAbortController = null;

  function initCertGrid() {
    if (certGridAbortController) {
      certGridAbortController.abort();
    }
    certGridAbortController = new AbortController();
    const { signal } = certGridAbortController;

    const filterButtons = document.querySelectorAll('.cert-filter-btn');
    const cards = document.querySelectorAll('.cert-card');

    if (!filterButtons.length && !cards.length) return;

    // Filter Buttons Handling
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-filter');

        // Update button states
        filterButtons.forEach(b => {
          b.classList.remove('active-filter', 'bg-accent-900', 'text-bg', 'border-accent-900');
          b.classList.add('bg-surface', 'text-neutral-800', 'border-divider');
        });
        btn.classList.add('active-filter', 'bg-accent-900', 'text-bg', 'border-accent-900');
        btn.classList.remove('bg-surface', 'text-neutral-800', 'border-divider');

        // Filter cards
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }, { signal });
    });

    // Card Tap & Keyboard Handling (Direct Lightbox Trigger)
    cards.forEach(card => {
      const openModalForCard = (event) => {
        // Allow text selection / copy on the registration number without opening modal
        if (event.target && event.target.closest('[data-copy-number]')) {
          return;
        }

        const rawData = card.getAttribute('data-cert');
        if (!rawData) return;

        try {
          const doc = JSON.parse(rawData);
          if (typeof window.openCertLightbox === 'function') {
            window.openCertLightbox(doc);
          }
        } catch (err) {
          console.error('[CertLightbox] Failed to parse document data', err);
        }
      };

      card.addEventListener('click', openModalForCard, { signal });

      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openModalForCard(event);
        }
      }, { signal });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCertGrid);
  } else {
    initCertGrid();
  }
  document.addEventListener('astro:page-load', initCertGrid);
</script>
