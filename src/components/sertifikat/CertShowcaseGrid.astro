---
// src/components/sertifikat/CertShowcaseGrid.astro
import type { ShowcaseCertificateItem, LegalCardItem } from '../../services/api/certService';

interface Props {
  certificates: ShowcaseCertificateItem[];
  legalDocuments: LegalCardItem[];
  publicApiUrl?: string;
}

const { certificates = [], legalDocuments = [], publicApiUrl = '' } = Astro.props;

// Combine into unified list with clear categories
const allDocuments = [
  ...certificates.map(item => ({
    id: String(item.id),
    title: item.title,
    issuer: item.issuer,
    certNumber: item.certNumber || item.no,
    validUntil: item.validUntil || item.date,
    badge: item.badge || 'RESMI',
    category: 'sertifikat',
    categoryLabel: 'Sertifikasi Mutu & Halal',
    documentUrl: item.documentUrl || item.docUrl || '/images/brand/halal-cert.png',
    fileType: item.fileType || 'image',
    detail: `Dokumen sah diterbitkan oleh ${item.issuer}. Keaslian dapat diverifikasi langsung melalui nomor registrasi resmi.`
  })),
  ...legalDocuments.map(item => ({
    id: String(item.id),
    title: item.label || item.title,
    issuer: item.issuer,
    certNumber: item.certNumber || '-',
    validUntil: item.validUntil || 'Aktif',
    badge: item.status || item.badge || 'LEGAL',
    category: 'legalitas',
    categoryLabel: 'Legalitas Usaha & Pajak',
    documentUrl: item.document_url || item.documentUrl || '/images/brand/halal-cert.png',
    fileType: item.file_type || item.fileType || 'image',
    detail: item.detail || `Legalitas resmi operasional Dzanis Catering untuk jaminan kepatuhan hukum.`
  }))
];
---

<section class="py-5 sm:py-12 bg-bg relative" id="dokumen-resmi">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <!-- Section Header & Filter Tabs -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 sm:gap-6 border-b border-divider pb-2.5 sm:pb-6">
      <div>
        <p class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.22em] text-accent-900">
          DOKUMEN RESMI TERVERIFIKASI
        </p>
        <h2 class="mt-1 sm:mt-2 font-heading text-xl sm:text-3xl lg:text-4xl font-bold text-text">
          Pameran Sertifikat &amp; Kelaikan Hukum
        </h2>
        <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-neutral-700 max-w-xl line-clamp-2 sm:line-clamp-none">
          Seluruh berkas pindaian asli beresolusi tinggi dapat diperiksa langsung untuk memenuhi persyaratan administrasi pengadaan atau keyakinan konsumen.
        </p>
      </div>

      <!-- Category Filter Pills (Rapat dengan grid mt-3 mb-4) -->
      <div class="mt-2.5 mb-1 sm:mt-0 sm:mb-0 flex flex-nowrap overflow-x-auto no-scrollbar gap-1.5 sm:gap-2 pb-1 sm:pb-2 overscroll-x-contain touch-manipulation w-full max-w-full" role="tablist" aria-label="Filter kategori dokumen">
        <button
          type="button"
          data-filter="all"
          class="cert-filter-btn active-filter shrink-0 min-h-[36px] sm:min-h-[44px] px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-semibold tracking-wider transition cursor-pointer border border-accent-900 bg-accent-900 text-bg shadow-sm flex items-center justify-center touch-manipulation"
        >
          Semua Dokumen ({allDocuments.length})
        </button>
        <button
          type="button"
          data-filter="sertifikat"
          class="cert-filter-btn shrink-0 min-h-[36px] sm:min-h-[44px] px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-semibold tracking-wider transition cursor-pointer border border-divider bg-surface text-neutral-800 hover:border-accent-900/40 flex items-center justify-center touch-manipulation"
        >
          Sertifikasi Mutu ({certificates.length})
        </button>
        <button
          type="button"
          data-filter="legalitas"
          class="cert-filter-btn shrink-0 min-h-[36px] sm:min-h-[44px] px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-semibold tracking-wider transition cursor-pointer border border-divider bg-surface text-neutral-800 hover:border-accent-900/40 flex items-center justify-center touch-manipulation"
        >
          Izin Usaha &amp; Pajak ({legalDocuments.length})
        </button>
      </div>
    </div>

    <!-- Document Cards Grid (SSR-First: 2 Kolom Ringkas di Mobile) -->
    <div 
      id="cert-documents-grid" 
      class="mt-3 sm:mt-8 grid grid-cols-2 gap-2.5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6"
      data-api-url={publicApiUrl}
    >
      {allDocuments.map((doc) => {
        const payloadStr = JSON.stringify({
          title: doc.title,
          issuer: doc.issuer,
          certNumber: doc.certNumber,
          validUntil: doc.validUntil,
          badge: doc.badge,
          documentUrl: doc.documentUrl,
          fileType: doc.fileType,
          detail: doc.detail
        });

        const isHalalOrSanitasi = doc.badge.toLowerCase().includes('halal') || doc.badge.toLowerCase().includes('slhs');
        const badgeColorClass = isHalalOrSanitasi
          ? 'bg-accent-2-200 text-accent-2-900 border-accent-2-300'
          : 'bg-accent-200 text-accent-900 border-accent-300';

        return (
          <article 
            class="cert-card group flex flex-col justify-between rounded-2xl sm:rounded-[24px] border border-divider bg-surface p-2.5 sm:p-5 shadow-[var(--shadow-md)] transition-all duration-200 hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] hover:border-accent-900/30 cursor-pointer touch-manipulation"
            data-category={doc.category}
            data-cert={payloadStr}
            tabindex="0"
            role="button"
            aria-label={`Buka pratinjau dokumen ${doc.title}`}
          >
            <!-- Card Upper Section: Badge & Document Framing -->
            <div>
              <div class="flex items-center justify-between gap-1 sm:gap-2">
                <span class={`rounded-full px-2 sm:px-2.5 py-0.5 sm:py-1 text-[8px] sm:text-[10px] font-bold uppercase tracking-wider border ${badgeColorClass} truncate max-w-[62%] sm:max-w-none`}>
                  {doc.badge}
                </span>
                <span class="inline-flex items-center gap-1 sm:gap-1.5 text-[9px] sm:text-[11px] font-medium text-neutral-700 shrink-0">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent-2-700"></span>
                  <span class="truncate max-w-[65px] sm:max-w-none">{doc.validUntil}</span>
                </span>
              </div>

              <!-- Document Preview Thumbnail Canvas (Proporsional aspect-[4/3] framed) -->
              <div class="relative mt-2 sm:mt-4 overflow-hidden rounded-lg sm:rounded-xl border border-divider/70 bg-bg p-1.5 sm:p-3 shadow-inner group-hover:border-accent-900/30 transition">
                <div class="relative flex items-center justify-center aspect-[4/3] w-full overflow-hidden rounded-md sm:rounded-lg bg-neutral-100 border border-neutral-200/80 shadow-xs">
                  <img
                    src={doc.documentUrl}
                    alt={`Pindaian Dokumen Resmi: ${doc.title}`}
                    width="400"
                    height="300"
                    loading="lazy"
                    class="h-full w-full object-contain object-center transition duration-300 group-hover:scale-105"
                  />
                  <!-- Stamp / Watermark Overlay -->
                  <div class="pointer-events-none absolute bottom-1 right-1 sm:bottom-2 sm:right-2 rounded sm:rounded-md bg-accent-900/80 px-1.5 py-0.5 text-[8px] sm:text-[9px] font-bold uppercase tracking-wider text-bg backdrop-blur-sm shadow-sm">
                    Verified
                  </div>
                </div>

                <!-- Hover/Focus Overlay Trigger (Desktop Only) -->
                <div
                  class="hidden sm:flex absolute inset-0 items-center justify-center bg-black/40 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100 text-bg font-heading font-semibold text-xs gap-1.5 touch-manipulation pointer-events-none"
                  aria-hidden="true"
                >
                  <span class="rounded-full bg-accent-900 px-3.5 py-2 shadow-lg flex items-center gap-1.5 hover:bg-accent-700 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                    </svg>
                    <span>Perbesar Dokumen</span>
                  </span>
                </div>
              </div>

              <!-- Document Meta -->
              <div class="mt-2 sm:mt-4">
                <h3 class="font-heading text-xs sm:text-base lg:text-lg font-bold leading-snug text-text group-hover:text-accent-900 transition-colors line-clamp-1" title={doc.title}>
                  {doc.title}
                </h3>
                <p class="mt-0.5 sm:mt-1 text-[10px] sm:text-xs text-neutral-700 line-clamp-1 sm:line-clamp-2" title={doc.issuer}>
                  {doc.issuer}
                </p>
                <div class="mt-1.5 sm:mt-3 flex items-center justify-between gap-1 sm:gap-2 rounded-lg sm:rounded-xl bg-bg px-2 sm:px-3 py-1 sm:py-2 border border-divider/60">
                  <span class="text-[8px] sm:text-[10px] uppercase tracking-wider text-neutral-600 font-medium shrink-0">No. Reg:</span>
                  <span 
                    class="font-mono text-[9px] sm:text-xs font-bold text-accent-900 select-all cursor-text py-0.5 px-1 rounded hover:bg-accent-100/60 truncate" 
                    title="Pilih nomor untuk salin"
                    data-copy-number="true"
                  >
                    {doc.certNumber}
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Action -->
            <div class="mt-2.5 sm:mt-5 border-t border-divider/60 pt-2 sm:pt-3 flex items-center justify-between">
              <span class="hidden sm:inline text-[10px] font-bold uppercase tracking-wider text-neutral-600">
                Dokumen Sah
              </span>
              <span class="sm:hidden text-[9px] font-medium text-neutral-500">
                Resmi
              </span>
              <span
                class="inline-flex min-h-[36px] sm:min-h-[44px] items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1 sm:py-2 rounded-lg sm:rounded-xl text-[11px] sm:text-xs font-bold text-accent-900 group-hover:text-accent-700 group-hover:bg-neutral-100 transition cursor-pointer touch-manipulation ml-auto pointer-events-none"
                aria-hidden="true"
              >
                <span>Lihat</span>
                <span class="hidden sm:inline">Berkas Asli</span>
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  let certGridAbortController = null;

  function initCertGrid() {
    if (certGridAbortController) {
      certGridAbortController.abort();
    }
    certGridAbortController = new AbortController();
    const { signal } = certGridAbortController;

    const filterButtons = document.querySelectorAll('.cert-filter-btn');
    const cards = document.querySelectorAll('.cert-card');

    if (!filterButtons.length && !cards.length) return;

    // Filter Buttons Handling
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-filter');

        // Update button states
        filterButtons.forEach(b => {
          b.classList.remove('active-filter', 'bg-accent-900', 'text-bg', 'border-accent-900');
          b.classList.add('bg-surface', 'text-neutral-800', 'border-divider');
        });
        btn.classList.add('active-filter', 'bg-accent-900', 'text-bg', 'border-accent-900');
        btn.classList.remove('bg-surface', 'text-neutral-800', 'border-divider');

        // Filter cards
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (targetCategory === 'all' || cardCat === targetCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }, { signal });
    });

    // Card Tap & Keyboard Handling (Direct Lightbox Trigger)
    cards.forEach(card => {
      const openModalForCard = (event) => {
        // Allow text selection / copy on the registration number without opening modal
        if (event.target && event.target.closest('[data-copy-number]')) {
          return;
        }

        const rawData = card.getAttribute('data-cert');
        if (!rawData) return;

        try {
          const doc = JSON.parse(rawData);
          if (typeof window.openCertLightbox === 'function') {
            window.openCertLightbox(doc);
          }
        } catch (err) {
          console.error('[CertLightbox] Failed to parse document data', err);
        }
      };

      card.addEventListener('click', openModalForCard, { signal });

      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openModalForCard(event);
        }
      }, { signal });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCertGrid);
  } else {
    initCertGrid();
  }
  document.addEventListener('astro:page-load', initCertGrid);
</script>

