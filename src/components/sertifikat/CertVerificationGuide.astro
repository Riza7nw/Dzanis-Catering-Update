---
// src/components/sertifikat/CertVerificationGuide.astro

const steps = [
  {
    step: '01',
    portal: 'Portal SIHALAL / BPJPH',
    title: 'Validasi Sertifikasi Halal',
    badge: 'Kemenag RI',
    desc: 'Periksa keabsahan nomor registrasi ID3211000123456 pada pangkalan data resmi BPJPH. Pastikan status produk aktif dengan nama pelaku usaha Dzanis Catering.',
    url: 'https://info.halal.go.id/',
    actionLabel: 'Buka Info Halal'
  },
  {
    step: '02',
    portal: 'Sistem OSS RBA BKPM',
    title: 'Cek Legalitas NIB & KBLI',
    badge: 'BKPM / OSS',
    desc: 'Lakukan penelusuran Nomor Induk Berusaha (NIB 1209230045678). Pastikan izin operasional KBLI 56210 (Jasa Boga untuk Suatu Event Tertentu) berstatus aktif.',
    url: 'https://oss.go.id/',
    actionLabel: 'Buka Portal OSS'
  },
  {
    step: '03',
    portal: 'Dinkes Kab. Majalengka',
    title: 'Verifikasi SLHS & Higiene Sanitasi',
    badge: 'Dinkes Daerah',
    desc: 'Sertifikat Laik Higiene Sanitasi (SLHS) menjamin dapur pengolahan, air bersih, serta para penjamah makanan telah lolos inspeksi kesehatan higienis berkala.',
    url: 'https://dinkes.majalengkakab.go.id/',
    actionLabel: 'Portal Dinkes'
  }
];
---

<section class="py-12 bg-surface/60 border-t border-b border-divider relative">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-900">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-900" aria-hidden="true"></span>
        <span>Transparansi Publik</span>
      </div>
      <h2 class="mt-2 font-heading text-2xl font-bold text-text sm:text-3xl lg:text-4xl">
        Cara Cek &amp; Verifikasi Keabsahan Secara Mandiri
      </h2>
      <p class="mt-2 text-sm text-neutral-700 leading-relaxed">
        Kami menjunjung tinggi keterbukaan informasi. Setiap klien instansi pemerintah, BUMN, perbankan, maupun perseorangan berhak memverifikasi langsung seluruh nomor izin kami di portal terkait.
      </p>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {steps.map((item) => (
        <div class="flex flex-col justify-between rounded-[24px] border border-divider bg-bg p-6 shadow-[var(--shadow-md)] transition duration-200 hover:border-accent-900/30">
          <div>
            <div class="flex items-center justify-between border-b border-divider/60 pb-3">
              <span class="font-heading text-2xl font-black text-accent-900/80">
                {item.step}
              </span>
              <span class="rounded-full bg-accent-2-200 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-accent-2-900">
                {item.badge}
              </span>
            </div>

            <p class="mt-4 text-[11px] font-bold uppercase tracking-wider text-accent-900">
              {item.portal}
            </p>
            <h3 class="mt-1 font-heading text-lg font-bold text-text">
              {item.title}
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-neutral-700">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-divider/60">
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-900 hover:text-accent-700 transition"
              aria-label={`Buka ${item.portal} di tab baru`}
            >
              <span>{item.actionLabel}</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
