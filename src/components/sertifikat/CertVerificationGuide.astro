---
// src/components/sertifikat/CertVerificationGuide.astro

const portals = [
  {
    institution: 'BPJPH Kemenag RI',
    title: 'Cek Sertifikat Halal',
    desc: 'Periksa keabsahan registrasi Halal Dzanis Catering secara daring pada pangkalan data produk halal resmi.',
    url: 'https://info.halal.go.id/',
    linkText: 'Portal SIHALAL'
  },
  {
    institution: 'Kementerian Investasi / BKPM',
    title: 'Cek Legalitas NIB OSS',
    desc: 'Verifikasi izin operasional KBLI 56210 (Jasa Boga / Katering Event) berstatus aktif pada sistem OSS-RBA.',
    url: 'https://oss.go.id/',
    linkText: 'Portal OSS.go.id'
  },
  {
    institution: 'Dinas Kesehatan Kab. Majalengka',
    title: 'SLHS & Higiene Sanitasi',
    desc: 'Konfirmasi pemenuhan baku mutu higienis dapur, air bersih, dan sertifikasi penjamah makanan.',
    url: 'https://dinkes.majalengkakab.go.id/',
    linkText: 'Portal Dinkes'
  }
];
---

<section class="py-8 sm:py-12 bg-surface/30 border-y border-divider/60">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-14">
    <!-- Header Ringkas -->
    <div class="max-w-2xl">
      <h2 class="font-heading text-lg sm:text-2xl font-bold text-text">
        Verifikasi Mandiri di Portal Resmi Pemerintah
      </h2>
      <p class="mt-1 text-xs sm:text-sm text-neutral-600 leading-relaxed">
        Seluruh nomor registrasi Dzanis Catering terbuka untuk diperiksa langsung demi transparansi pengadaan dan kepastian pelanggan.
      </p>
    </div>

    <!-- Strip Verifikasi 3 Kolom Ringkas -->
    <div class="mt-5 sm:mt-6 grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
      {portals.map((portal) => (
        <div class="rounded-xl border border-divider/80 bg-surface p-4 sm:p-5 flex flex-col justify-between hover:border-accent-900/30 transition">
          <div>
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-accent-900">
              {portal.institution}
            </span>
            <h3 class="mt-1 font-heading text-sm sm:text-base font-bold text-text">
              {portal.title}
            </h3>
            <p class="mt-1.5 text-xs text-neutral-600 leading-relaxed">
              {portal.desc}
            </p>
          </div>

          <div class="mt-3.5 pt-3 border-t border-divider/50">
            <a
              href={portal.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs font-semibold text-accent-900 hover:text-accent-700 transition"
              aria-label={`Buka ${portal.institution} di tab baru`}
            >
              <span>{portal.linkText}</span>
              <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
