---

<!-- Sticky / Bottom Summary Bar -->
<div
  id="builder-summary-bar"
  class="fixed bottom-0 inset-x-0 w-full max-w-full z-40 bg-surface/95 backdrop-blur-md border-t border-divider p-4 sm:p-6 shadow-2xl"
>
  <div class="mx-auto max-w-[1280px] w-full min-w-0 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-6">
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 sm:gap-6 text-center md:text-left">
      <div>
        <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Item Terpilih</span>
        <span id="summary-item-count" aria-live="polite" role="status" class="font-heading text-xl sm:text-2xl font-bold text-neutral-900">0 macam</span>
      </div>
      <div class="h-8 w-px bg-divider hidden sm:block"></div>
      <div>
        <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Harga per Box</span>
        <span id="summary-subtotal" aria-live="polite" role="status" class="font-heading text-xl sm:text-2xl font-bold text-accent-700">Rp0</span>
      </div>
      <div class="h-8 w-px bg-divider hidden sm:block"></div>
      <div>
        <span class="text-xs uppercase tracking-wider text-neutral-500 font-semibold block">Estimasi Total</span>
        <span id="summary-total" aria-live="polite" role="status" class="font-heading text-xl sm:text-2xl font-bold text-neutral-900">Rp0</span>
      </div>
    </div>

    <button
      type="button"
      id="builder-order-btn"
      class="btn btn-primary min-h-[48px] sm:min-h-[50px] px-6 sm:px-8 text-sm sm:text-base font-semibold w-full md:w-auto shadow-md hover:shadow-lg transition-shadow cursor-pointer touch-manipulation disabled:opacity-50 disabled:cursor-not-allowed"
      disabled
    >
      Pesan Paket Rakitan Ini &rarr;
    </button>
  </div>
</div>
