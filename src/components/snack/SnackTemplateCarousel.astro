---
import type { SnackTemplatePackage } from '../../types/catalog';
import { formatRupiah } from '../../data/snack';
import { buildSnackTemplateWaUrl } from '../../utils/whatsappFormatter';

interface Props {
  snackTemplates: SnackTemplatePackage[];
  totalSnackItems: number;
}

const { snackTemplates, totalSnackItems } = Astro.props;
---

<!-- ================= PANEL 1: PAKET TEMPLATE & KUSTOMISASI KOLOM ================= -->
<div id="panel-template" class="w-full max-w-full min-w-0 space-y-8">
  <div class="rounded-3xl border border-divider bg-bg p-6 lg:p-8 shadow-sm w-full max-w-full min-w-0">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-divider pb-4">
      <div>
        <h2 class="font-heading text-2xl text-neutral-900">Paket Template Siap Saji</h2>
        <p class="text-sm text-neutral-600">Pesan langsung paket template rekomendasi chef atau sesuaikan isian per kolom.</p>
      </div>
      <span class="text-xs bg-accent-100/60 text-accent-700 font-semibold px-3 py-1.5 rounded-full border border-accent/20">
        {snackTemplates.length} Paket Tersedia
      </span>
    </div>

    <!-- PERINGATAN: jangan beri overflow-hidden pada panel induk; panah menjorok 22px ke padding panel -->
    <div id="snack-carousel" class="group/carousel w-full max-w-full min-w-0" data-scrollable="false">
      <!-- (a) Bingkai posisi panah: hanya berisi panah + grid, supaya top-1/2 tidak dipengaruhi tinggi dots -->
      <div class="relative w-full max-w-full min-w-0">
        <button
          id="snack-prev"
          type="button"
          aria-label="Paket sebelumnya"
          class="hidden md:group-data-[scrollable=true]/carousel:flex absolute left-0 top-[calc(50%-0.5rem)] -translate-x-1/2 -translate-y-1/2 z-20 size-11 items-center justify-center rounded-full bg-white/95 backdrop-blur border border-divider shadow-md hover:shadow-xl aria-disabled:opacity-40 aria-disabled:cursor-not-allowed aria-disabled:hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer transition-all touch-manipulation"
        >
          <svg class="size-5 text-neutral-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="w-full max-w-full min-w-0 overflow-hidden">
          <div
            id="snack-grid"
            tabindex="0"
            role="region"
            aria-roledescription="carousel"
            aria-label="Katalog paket template snack box"
            data-dragging="false"
            class="flex gap-4 overflow-x-auto no-scrollbar w-full max-w-full min-w-0 px-4 py-2 overscroll-x-contain snap-x snap-mandatory motion-safe:scroll-smooth md:cursor-grab data-[dragging=true]:cursor-grabbing md:data-[dragging=true]:cursor-grabbing rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            {snackTemplates.map((pkg, pIdx) => {
              const slots = pkg.custom_slots && pkg.custom_slots.length > 0
                ? pkg.custom_slots
                : pkg.items.map((it, i) => ({ name: `Kolom ${i + 1}`, default_item: it, options: it }));

              const templateWaUrl = buildSnackTemplateWaUrl({
                nama: pkg.name,
                harga: pkg.price_per_pax,
                items: slots.map((s) => ({
                  kategori: s.name,
                  nama: s.default_item,
                })),
              });

              return (
                <div
                  class="snack-template-card w-[270px] sm:w-[320px] max-w-[80vw] shrink-0 snap-start flex flex-col justify-between rounded-2xl border border-divider bg-surface/40 hover:bg-surface hover:shadow-md transition-all p-5"
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${pkg.name} (${pIdx + 1} dari ${snackTemplates.length})`}
                  data-package-id={pkg.id}
                  data-package-name={pkg.name}
                  data-price={pkg.price_per_pax}
                  data-min-pax={pkg.min_pax}
                  data-slots-json={JSON.stringify(slots)}
                >
                  <div>
                    <!-- Image & Badge -->
                    <div class="relative aspect-video w-full rounded-xl overflow-hidden mb-4 bg-neutral-100">
                      <img
                        src={pkg.image || pkg.foto || '/images/menu/snack-puding-buah.webp'}
                        alt={pkg.name}
                        width="400"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                      />
                      {pkg.badge && (
                        <span class="absolute top-2.5 left-2.5 bg-accent text-bg text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
                          {pkg.badge}
                        </span>
                      )}
                    </div>

                    <!-- Name & Description -->
                    <h3 class="font-heading text-xl font-bold text-neutral-900 mb-1">
                      {pkg.name}
                    </h3>
                    <p class="text-xs text-neutral-600 mb-3 leading-relaxed">
                      {pkg.description || 'Kombinasi jajanan pilihan higienis dan lezat untuk berbagai acara.'}
                    </p>

                    <!-- Price & Min Pax -->
                    <div class="flex items-baseline justify-between mb-4 border-b border-divider pb-3">
                      <div>
                        <span class="text-xs text-neutral-500">Harga: </span>
                        <span class="font-heading text-xl font-bold text-accent-700">
                          {formatRupiah(pkg.price_per_pax)}
                        </span>
                        <span class="text-xs text-neutral-500">/box</span>
                      </div>
                      <span class="text-xs text-neutral-500 font-medium">
                        Min. {pkg.min_pax} box
                      </span>
                    </div>

                    <!-- Kolom / Isian Template Preview -->
                    <div class="space-y-2 mb-4">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-neutral-500 block">
                        {slots.length > 6 ? `Pilihan ${slots.length - 1} Menu Tradisional Termasuk:` : 'Kolom & Isian Default:'}
                      </span>
                      <div class={slots.length > 6 ? "grid grid-cols-2 gap-1.5" : "space-y-1.5"}>
                        {slots.map((slot, sIdx) => (
                          <div class={`flex items-center gap-1.5 text-neutral-800 bg-white/70 rounded-lg border border-divider/60 ${slots.length > 6 ? 'p-1.5 text-[11px]' : 'p-2 text-xs'}`}>
                            <span class={`rounded-full bg-accent/10 text-accent font-bold flex items-center justify-center shrink-0 ${slots.length > 6 ? 'size-4 text-[9px]' : 'size-5 text-[10px] mt-0.5'}`}>
                              {sIdx + 1}
                            </span>

                            <div class="min-w-0 flex-1 truncate">
                              {slots.length <= 6 && (
                                <span class="font-semibold text-neutral-900 block truncate">{slot.name}:</span>
                              )}
                              <span class={`slot-display-item font-medium truncate block ${slots.length > 6 ? 'text-neutral-900 text-[11px]' : 'text-accent-700'}`}>
                                {slot.default_item || '-'}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  <!-- Action Button: Pesan Paket Ini -->
                  <div class="pt-2 border-t border-divider">
                    <a
                      href={templateWaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-order-template-direct w-full min-h-[44px] py-2.5 px-4 rounded-xl bg-accent text-bg text-xs font-semibold hover:bg-accent-700 transition shadow-xs flex items-center justify-center gap-1.5 cursor-pointer touch-manipulation no-underline"
                      data-package-name={pkg.name}
                      data-price={pkg.price_per_pax}
                      data-min-pax={pkg.min_pax}
                      data-wa-url={templateWaUrl}
                      aria-label={`Pesan ${pkg.name} via WhatsApp`}
                    >
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                      </svg>
                      <span>Pesan Paket Ini</span>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <button
          id="snack-next"
          type="button"
          aria-label="Paket berikutnya"
          class="hidden md:group-data-[scrollable=true]/carousel:flex absolute right-0 top-[calc(50%-0.5rem)] translate-x-1/2 -translate-y-1/2 z-20 size-11 items-center justify-center rounded-full bg-white/95 backdrop-blur border border-divider shadow-md hover:shadow-xl aria-disabled:opacity-40 aria-disabled:cursor-not-allowed aria-disabled:hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer transition-all touch-manipulation"
        >
          <svg class="size-5 text-neutral-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- (b) Dots: sibling di bawah bingkai, masih di dalam root agar variant group-data berlaku -->
      <div id="snack-dots" class="mt-2 flex items-center justify-center group-data-[scrollable=false]/carousel:hidden"></div>
    </div>

    <!-- Banner Transisi ke Rakit Custom Sendiri -->
    <div class="mt-8 rounded-2xl bg-surface/80 border border-divider p-5 lg:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="size-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-base font-bold text-neutral-900">Ingin Kombinasi Jajanan Sendiri?</h3>
          <p class="text-xs text-neutral-600">Pilih bebas dari {totalSnackItems} aneka jajanan di bawah ini sesuai selera dan anggaran acara Anda.</p>
        </div>
      </div>
      <a
        href="#custom"
        class="btn btn-secondary min-h-[44px] text-xs font-semibold py-2.5 px-5 rounded-full shrink-0 flex items-center gap-1.5 transition cursor-pointer hover:border-accent touch-manipulation"
      >
        <span>Rakit Custom Sendiri</span>
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>
</div>
