---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import OrderModal from '../components/interactive/OrderModal.astro';
import { ClientRouter } from 'astro:transitions';
import { company } from '../data/company';
import { generateWebSiteSchema } from '../data/schema';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  useTransitions?: boolean;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = company.description,
  schema,
  useTransitions = true,
  image = '/images/menu/hero-nasi-kotak.jpg',
  canonicalUrl,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://dzanis-catering-update.vercel.app';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const hasWebSiteSchema = Array.isArray(schema)
  ? schema.some((item) => (item as Record<string, unknown>)?.['@type'] === 'WebSite')
  : (schema as Record<string, unknown> | undefined)?.['@type'] === 'WebSite';
const shouldRenderWebSiteSchema = isHomePage && !hasWebSiteSchema;
---

<!doctype html>
<html lang="id" class="scroll-smooth w-full max-w-full overflow-x-clip relative m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Application / Branding Metadata -->
    <meta name="application-name" content="Dzanis Catering" />
    <meta name="apple-mobile-web-app-title" content="Dzanis Catering" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {useTransitions && <ClientRouter />}

    <!-- Network Optimization: Preconnect & Preload API Backend -->
    <link rel="preconnect" href="https://dzaniez-back.ethiodeploy.app" crossorigin />
    <link rel="dns-prefetch" href="https://dzaniez-back.ethiodeploy.app" />
    <link rel="preload" href="https://dzaniez-back.ethiodeploy.app/api/menu" as="fetch" crossorigin="anonymous" />

    <!-- Early Eager Prefetch: Jalankan request API katalog di <head> sebelum DOM/gambar selesai -->
    <script is:inline>
      (function() {
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var h = window.location.hostname;
          var isLocal = h === 'localhost' || h === '127.0.0.1' || h.indexOf('192.168.') === 0 || h.indexOf('10.') === 0 || h.slice(-6) === '.local';
          var defLocal = window.location.protocol + '//' + (h || '127.0.0.1') + ':8000';
          var api = urlParams.get('apiUrl') || (isLocal ? defLocal : 'https://dzaniez-back.ethiodeploy.app');
          
          window.__DZANIS_MENU_PROMISE__ = fetch(api + '/api/menu', {
            headers: { 'Accept': 'application/json' }
          }).then(function(r) {
            return (r && r.ok) ? r.json() : null;
          }).catch(function() { return null; });
        } catch(e) {}
      })();
    </script>

    <!-- Google Site Name Structured Data (Schema.org WebSite) -->
    {shouldRenderWebSiteSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(generateWebSiteSchema(siteUrl), null, 2)}
      />
    )}

    <!-- Page Specific Structured Data (FoodEstablishment / Product / etc) -->
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema, null, 2)}
      />
    )}

  </head>
  <body class="w-full max-w-full overflow-x-clip relative m-0 p-0 min-h-screen bg-bg text-text antialiased">
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[400] focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-bg"
    >
      Lompat ke konten utama
    </a>
    <div class="w-full max-w-full min-w-0 overflow-x-clip flex flex-col min-h-screen">
      <slot />
    </div>
    <OrderModal />
  </body>
</html>
