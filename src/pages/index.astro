---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/organic/Navbar.astro';
import Hero from '../components/organic/Hero.astro';
import Angka from '../components/organic/Angka.astro';
import LayananLain from '../components/organic/LayananLain.astro';
import Paket from '../components/organic/Paket.astro';
import SnackBox from '../components/organic/SnackBox.astro';
import CaraPesan from '../components/organic/CaraPesan.astro';
import Faq from '../components/organic/Faq.astro';
import CtaBesar from '../components/organic/CtaBesar.astro';
import Footer from '../components/organic/Footer.astro';
import { generateFoodEstablishmentSchema, DEFAULT_SITE_URL } from '../utils/schema';
import { getMenuCatalog } from '../services/api/menuService';

const menuKatalog = await getMenuCatalog();
const schema = generateFoodEstablishmentSchema(DEFAULT_SITE_URL, menuKatalog);
---

<BaseLayout
  title="Dzanis Catering | Jasa Catering & Katering Ciayumajakuning"
  description="Jasa catering & katering Majalengka dan Ciayumajakuning. Sedia prasmanan acara kantor, nasi kotak, snack box, hingga tumpeng. Pesan menu lezat sekarang!"
  schema={schema}
>
  <Navbar />
  <main id="konten" class="w-full max-w-full min-w-0 flex-1 overflow-x-clip">
    <Hero />
    <Paket />
    <SnackBox />
    <CtaBesar />
    <LayananLain />
    <CaraPesan />
    <Angka />
    <Faq />
  </main>
  <Footer />
</BaseLayout>
