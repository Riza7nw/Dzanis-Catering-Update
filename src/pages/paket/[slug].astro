---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/organic/Navbar.astro';
import Footer from '../../components/organic/Footer.astro';
import { DAFTAR_PAKET, type Paket } from '../../data/paket';
import { waPhoneNumber } from '../../data/company';

export async function getStaticPaths() {
  return DAFTAR_PAKET.map((paket) => ({
    params: { slug: paket.slug },
    props: { paket },
  }));
}

interface Props {
  paket: Paket;
}

const { paket } = Astro.props;
const { slug } = Astro.params;

const pageTitle = `${paket.nama} | Dzanis Catering`;
const pageDescription = paket.deskripsiSingkat;

const tomorrow = new Date();
tomorrow.setDate(tomorrow.getDate() + 1);
const minEventDateString = [
  tomorrow.getFullYear(),
  String(tomorrow.getMonth() + 1).padStart(2, '0'),
  String(tomorrow.getDate()).padStart(2, '0'),
].join('-');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main id="konten" class="bg-bg">
    <!-- Breadcrumb Navigation -->
    <div class="border-b border-divider bg-surface/50">
      <div class="mx-auto max-w-[1280px] px-4 py-3 sm:px-6 lg:px-14">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-neutral-600">
          <a
            href="/"
            class="font-medium transition-colors hover:text-accent-700"
          >
            Beranda
          </a>
          <span class="text-neutral-400" aria-hidden="true">/</span>
          <a
            href="/#paket"
            class="font-medium transition-colors hover:text-accent-700"
          >
            Paket Nasi Kotak
          </a>
          <span class="text-neutral-400" aria-hidden="true">/</span>
          <span class="font-semibold text-neutral-900 truncate" aria-current="page">
            {paket.nama}
          </span>
        </nav>
      </div>
    </div>

    <!-- Main Detail Section -->
    <div class="mx-auto max-w-[1280px] px-4 py-8 sm:px-6 sm:py-12 lg:px-14 lg:py-16">
      <div class="mb-6">
        <a
          href="/#paket"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-accent-700 hover:text-accent-900 transition-colors"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Kembali ke Daftar Paket</span>
        </a>
      </div>

      <!-- Quick Package Switcher Navigation (Zero-JS) -->
      <nav aria-label="Pilihan Paket Nasi Kotak" class="mb-8 lg:mb-10 w-full max-w-full">
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <span class="inline-block size-2 rounded-full bg-[#C04A27]" aria-hidden="true"></span>
            <h2 class="font-heading text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-700">
              Pilihan Paket Nasi Kotak
            </h2>
          </div>
          <span class="text-[11px] text-neutral-500 hidden sm:inline-block">
            Beralih antar paket tanpa kembali ke beranda
          </span>
          <span class="text-[11px] font-medium text-neutral-500 sm:hidden flex items-center gap-1">
            <span>Geser pilihan</span>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </div>

        <!-- Horizontal scroll container on mobile, 3-column grid on desktop -->
        <div class="w-full max-w-full overflow-x-auto overflow-y-hidden overscroll-x-contain pb-2 pt-1 -mb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          <div class="flex sm:grid sm:grid-cols-3 gap-3 min-w-full w-max sm:w-full snap-x snap-mandatory">
            {DAFTAR_PAKET.map((item) => {
              const isCurrent = item.slug === paket.slug;
              return (
                <a
                  href={`/paket/${item.slug}`}
                  aria-current={isCurrent ? "page" : undefined}
                  tabindex={isCurrent ? -1 : 0}
                  class:list={[
                    "snap-start flex-none w-[260px] sm:w-auto rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
                    isCurrent
                      ? "bg-[#C04A27] text-white border-[#C04A27] shadow-sm pointer-events-none cursor-default"
                      : "bg-white hover:bg-surface/50 text-neutral-900 border-neutral-200/90 hover:border-accent/40 shadow-2xs group"
                  ]}
                >
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="flex items-center gap-1.5 min-w-0">
                      {isCurrent && (
                        <span class="inline-flex items-center justify-center size-4 rounded-full bg-white/20 text-white text-[10px] font-bold flex-none" aria-hidden="true">
                          ✓
                        </span>
                      )}
                      <span class:list={[
                        "font-heading text-sm sm:text-base font-bold tracking-tight truncate",
                        isCurrent ? "text-white" : "text-neutral-900 group-hover:text-accent-700"
                      ]}>
                        {item.nama}
                      </span>
                    </div>

                    {item.badge ? (
                      <span class:list={[
                        "text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full flex-none shadow-2xs",
                        isCurrent
                          ? "bg-white text-[#C04A27]"
                          : "bg-accent/10 text-accent border border-accent/20"
                      ]}>
                        Favorit
                      </span>
                    ) : isCurrent ? (
                      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/20 text-white flex-none">
                        Sedang Dilihat
                      </span>
                    ) : null}
                  </div>

                  <div class="flex items-baseline justify-between gap-2 pt-2 border-t border-current/10 mt-2">
                    <span class:list={[
                      "font-heading text-xs sm:text-sm font-bold",
                      isCurrent ? "text-white" : "text-neutral-700 group-hover:text-accent-700"
                    ]}>
                      Rp {item.harga.toLocaleString("id-ID")}
                      <span class:list={[
                        "text-[10px] font-normal",
                        isCurrent ? "text-white/80" : "text-neutral-500"
                      ]}> / porsi</span>
                    </span>

                    <span class:list={[
                      "text-xs font-semibold flex items-center gap-1 transition-transform",
                      isCurrent
                        ? "text-white/90"
                        : "text-accent-700 group-hover:translate-x-0.5"
                    ]}>
                      {isCurrent ? (
                        <span>Aktif</span>
                      ) : (
                        <>
                          <span>Pilih</span>
                          <span aria-hidden="true">&rarr;</span>
                        </>
                      )}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </nav>

      <!-- 2-Column Responsive Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Column: Media & Operational Badges (lg:col-span-5) -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <!-- Main Photo Card -->
          <div class="relative aspect-[16/10] sm:aspect-[4/3] w-full overflow-hidden rounded-3xl border border-neutral-200/80 bg-surface shadow-sm">
            <img
              src={paket.foto}
              alt={paket.fotoAlt || paket.nama}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
            />
            {paket.badge && (
              <span class="absolute top-3.5 left-3.5 rounded-full bg-accent px-3 py-1 font-heading text-xs tracking-wider text-white font-bold uppercase shadow-md">
                {paket.badge}
              </span>
            )}
          </div>

          <!-- Specs Pill Tags -->
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-2xl border border-neutral-200 bg-white p-3.5 shadow-sm">
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-500">
                Kemasan
              </span>
              <span class="mt-0.5 block text-xs sm:text-sm font-bold text-neutral-900">
                {paket.kemasan}
              </span>
            </div>

            <div class="rounded-2xl border border-neutral-200 bg-white p-3.5 shadow-sm">
              <span class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-500">
                Minimum Order
              </span>
              <span class="mt-0.5 block text-xs sm:text-sm font-bold text-neutral-900">
                {paket.minOrder} Porsi / Box
              </span>
            </div>
          </div>

          <!-- Operational Notice Box -->
          <div class="rounded-2xl border border-neutral-200/90 bg-surface/60 p-5 text-neutral-800">
            <h4 class="font-heading text-sm font-bold text-neutral-900 mb-3 uppercase tracking-wide">
              Ketentuan Pemesanan
            </h4>
            <ul class="space-y-2 text-xs leading-relaxed text-neutral-700">
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Cutoff H-2 / H-3:</strong> Disarankan memesan minimal H-3 agar persiapan bahan baku optimal.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>100% Halal:</strong> Menggunakan bahan pilihan berkualitas dengan dapur higienis rumahan Majalengka.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Area Pengantaran:</strong> Melayani seluruh Ciayumajakuning (Cirebon, Indramayu, Majalengka, Kuningan).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Alat Makan:</strong> Sudah termasuk sendok, tisu, dan tusuk gigi steril dalam setiap box.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Right Column: Detail, Composition, Menu Selection & Calculator (lg:col-span-7) -->
        <div class="lg:col-span-7 flex flex-col gap-8">
          <!-- Header & Price -->
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="rounded-full bg-accent-2-200 text-accent-2-900 px-3 py-0.5 text-xs font-semibold">
                Nasi Kotak Higienis
              </span>
              {paket.badge && (
                <span class="rounded-full bg-accent/10 text-accent px-3 py-0.5 text-xs font-bold uppercase tracking-wider">
                  {paket.badge}
                </span>
              )}
            </div>

            <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 tracking-tight">
              {paket.nama}
            </h1>

            <div class="mt-3 flex items-baseline gap-2">
              <span class="font-heading text-xl text-neutral-500 font-semibold">Rp</span>
              <span class="font-heading text-3xl sm:text-4xl font-bold text-accent-700 leading-none">
                {paket.harga.toLocaleString("id-ID")}
              </span>
              <span class="text-sm font-medium text-neutral-600">/ porsi</span>
            </div>

            <p class="mt-4 text-sm sm:text-base text-neutral-700 leading-relaxed">
              {paket.deskripsiLengkap}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {paket.tags.map((tag) => (
                <span class="inline-flex items-center rounded-full bg-white border border-neutral-200 px-3 py-1 text-xs font-semibold text-neutral-800 shadow-2xs">
                  ✓ {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Structured Menu Breakdown -->
          <div class="border-t border-divider pt-6">
            <h3 class="font-heading text-lg sm:text-xl font-bold text-neutral-900 mb-4">
              Komposisi & Menu Sajian
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="text-base" aria-hidden="true">🍗</span>
                  <h4 class="font-heading text-xs font-bold uppercase tracking-wider text-neutral-900">
                    Menu Utama
                  </h4>
                </div>
                <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-700">
                  {paket.menuUtama.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent font-bold flex-none">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="text-base" aria-hidden="true">🥗</span>
                  <h4 class="font-heading text-xs font-bold uppercase tracking-wider text-neutral-900">
                    Lauk Pendamping
                  </h4>
                </div>
                <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-700">
                  {paket.laukPendamping.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent font-bold flex-none">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="text-base" aria-hidden="true">🌶️</span>
                  <h4 class="font-heading text-xs font-bold uppercase tracking-wider text-neutral-900">
                    Sambal & Lalapan
                  </h4>
                </div>
                <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-700">
                  {paket.sambalLalapan.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent font-bold flex-none">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="text-base" aria-hidden="true">🍱</span>
                  <h4 class="font-heading text-xs font-bold uppercase tracking-wider text-neutral-900">
                    Pelengkap & Kemasan
                  </h4>
                </div>
                <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-700">
                  {paket.pelengkap.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent font-bold flex-none">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          {paket.canSelectMainMenu && paket.selectableMainMenus && paket.selectableSideDishes && (
            <div class="border-t border-divider pt-6">
              <h3 class="font-heading text-lg sm:text-xl font-bold text-neutral-900 mb-5">
                Pilih Menu Anda
              </h3>

              <div class="space-y-6">
                <div>
                  <label class="block text-sm font-bold text-neutral-900 mb-3">
                    🍗 Pilih Menu Utama
                  </label>
                  <div class="space-y-2">
                    {paket.selectableMainMenus!.map((menu, idx) => (
                      <label class="flex items-center gap-3 p-3 rounded-2xl border border-neutral-200 cursor-pointer hover:bg-accent/5 hover:border-accent/40 transition group">
                        <input
                          type="radio"
                          name="main-menu"
                          value={menu}
                          data-menu-id={`main-menu-${idx}`}
                          class="w-4 h-4 cursor-pointer accent-accent"
                          checked={idx === 0}
                        />
                        <span class="text-sm font-medium text-neutral-800 group-hover:text-accent-700 transition">
                          {menu}
                        </span>
                      </label>
                    ))}
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-3">
                    <label class="block text-sm font-bold text-neutral-900">
                      🥗 Pilih {paket.sideDishesSelectMin}-{paket.sideDishesSelectMax} Lauk Pendamping
                    </label>
                    <span class="text-xs font-medium text-neutral-500" id="side-count">
                      0 / {paket.sideDishesSelectMax} pilihan
                    </span>
                  </div>
                  <div class="space-y-2">
                    {paket.selectableSideDishes!.map((dish, idx) => (
                      <label class="flex items-center gap-3 p-3 rounded-2xl border border-neutral-200 cursor-pointer hover:bg-accent/5 hover:border-accent/40 transition group has-[:checked]:bg-accent/10 has-[:checked]:border-accent/40">
                        <input
                          type="checkbox"
                          name="side-dishes"
                          value={dish}
                          data-dish-id={`side-dish-${idx}`}
                          class="w-4 h-4 cursor-pointer accent-accent"
                          data-min={paket.sideDishesSelectMin}
                          data-max={paket.sideDishesSelectMax}
                        />
                        <span class="text-sm font-medium text-neutral-800 group-hover:text-accent-700 transition">
                          {dish}
                        </span>
                      </label>
                    ))}
                  </div>
                  <p class="text-xs text-neutral-500 mt-3">
                    Pilih minimal {paket.sideDishesSelectMin} dan maksimal {paket.sideDishesSelectMax} lauk pendamping.
                  </p>
                </div>

                <div class="rounded-2xl border border-accent/20 bg-accent/5 p-4">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-600 mb-2">
                    Ringkasan Pilihan Anda:
                  </h4>
                  <div class="text-sm text-neutral-800">
                    <p id="menu-summary-main" class="font-medium text-accent-700">
                      Menu: {paket.selectableMainMenus![0]}
                    </p>
                    <p id="menu-summary-sides" class="text-neutral-700 text-xs mt-1">
                      Lauk: —
                    </p>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Interactive Portion Calculator -->
          <div class="rounded-3xl border border-neutral-200 bg-surface/50 p-6 sm:p-7 shadow-sm">
            <div class="mb-5">
              <h3 class="font-heading text-xl font-bold text-neutral-900">
                Kalkulator Porsi & Pemesanan
              </h3>
              <p class="text-xs sm:text-sm text-neutral-600 mt-1">
                Tentukan jumlah porsi yang dibutuhkan untuk menghitung estimasi biaya dan membuat format pesan WhatsApp otomatis.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
              <div class="sm:col-span-5">
                <label for="portion-input" class="block text-xs font-bold uppercase tracking-wider text-neutral-800 mb-1.5">
                  Jumlah Porsi (Min. {paket.minOrder})
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="portion-input"
                    min={paket.minOrder}
                    step="5"
                    value={paket.minOrder}
                    class="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-base sm:text-lg font-bold text-neutral-900 focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none transition shadow-2xs"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-semibold text-neutral-500 pointer-events-none">
                    porsi
                  </span>
                </div>
              </div>

              <div class="sm:col-span-7 rounded-2xl border border-neutral-200 bg-white p-3.5 sm:p-4 shadow-2xs flex flex-col justify-center">
                <span class="text-[11px] font-bold uppercase tracking-wider text-neutral-500">
                  Estimasi Total Biaya:
                </span>
                <span
                  id="subtotal-display"
                  class="font-heading text-2xl sm:text-3xl font-bold text-accent-700 leading-none mt-1"
                >
                  Rp {(paket.harga * paket.minOrder).toLocaleString("id-ID")}
                </span>
              </div>
            </div>

            <div class="mt-4">
              <label for="event-date-input" class="block text-xs font-bold uppercase tracking-wider text-neutral-800 mb-1.5">
                Tanggal Acara
              </label>
              <input
                type="date"
                id="event-date-input"
                min={minEventDateString}
                required
                class="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-base font-medium text-neutral-900 focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none transition shadow-2xs"
              />
              <p class="text-xs text-neutral-500 mt-2">
                Pilih tanggal acara Anda untuk memudahkan proses pemesanan.
              </p>
            </div>

            <div class="mt-5">
              <a
                id="wa-checkout-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2.5 rounded-full bg-accent py-3.5 px-6 text-sm font-bold uppercase tracking-wider text-white shadow-md hover:bg-accent-700 transition duration-200"
              >
                <svg class="size-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>Pesan Sekarang via WhatsApp</span>
              </a>
              {paket.canSelectMainMenu && (
                <p class="mt-2 text-center text-xs text-neutral-500" id="validation-message">
                  Pastikan Anda telah memilih menu dan lauk pendamping sebelum memesan.
                </p>
              )}
              {!paket.canSelectMainMenu && (
                <p class="mt-2 text-center text-xs text-neutral-500">
                  Format pesan WhatsApp akan otomatis terisi dengan rincian paket dan jumlah porsi.
                </p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline define:vars={{ basePrice: paket.harga, packageName: paket.nama, minOrder: paket.minOrder, phone: waPhoneNumber, hasMenuSelection: Boolean(paket.canSelectMainMenu), sideDishesMin: paket.sideDishesSelectMin ?? 0, sideDishesMax: paket.sideDishesSelectMax ?? 0 }}>
  function initPortionCalculator() {
    const input = document.getElementById('portion-input');
    const display = document.getElementById('subtotal-display');
    const btn = document.getElementById('wa-checkout-btn');
    const eventDateInput = document.getElementById('event-date-input');

    if (!input || !display || !btn) return;

    let selectedMainMenu = null;
    let selectedSideDishes = [];
    let selectedEventDate = null;

    function calculateClampedQty() {
      let rawVal = parseInt(input.value, 10);
      if (isNaN(rawVal) || rawVal < minOrder) {
        return minOrder;
      }
      return rawVal;
    }

    if (hasMenuSelection) {
      const mainMenuRadios = document.querySelectorAll('input[name="main-menu"]');
      const sideDishCheckboxes = document.querySelectorAll('input[name="side-dishes"]');

      if (mainMenuRadios.length > 0) {
        selectedMainMenu = mainMenuRadios[0].value;
      }

      mainMenuRadios.forEach((radio) => {
        radio.addEventListener('change', (e) => {
          if (e.target.checked) {
            selectedMainMenu = e.target.value;
            updateSummary();
            updateCheckout();
          }
        });
      });

      sideDishCheckboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', (e) => {
          const maxSelections = parseInt(e.target.dataset.max, 10);
          const allCheckboxes = document.querySelectorAll('input[name="side-dishes"]');
          const checkedCount = Array.from(allCheckboxes).filter(cb => cb.checked).length;

          if (e.target.checked && checkedCount > maxSelections) {
            e.target.checked = false;
            alert(`Maksimal pilihan adalah ${maxSelections} lauk pendamping`);
            return;
          }

          selectedSideDishes = Array.from(allCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

          const sideCount = document.getElementById('side-count');
          if (sideCount) {
            sideCount.textContent = `${checkedCount} / ${maxSelections} pilihan`;
          }

          updateSummary();
          updateCheckout();
        });
      });

      if (mainMenuRadios.length > 0) {
        mainMenuRadios[0].checked = true;
      }
    }

    function updateSummary() {
      const summaryMain = document.getElementById('menu-summary-main');
      const summarySides = document.getElementById('menu-summary-sides');

      if (summaryMain && selectedMainMenu) {
        summaryMain.textContent = `Menu: ${selectedMainMenu}`;
      }

      if (summarySides && selectedSideDishes.length > 0) {
        summarySides.textContent = `Lauk: ${selectedSideDishes.join(', ')}`;
      } else if (summarySides) {
        summarySides.textContent = 'Lauk: —';
      }
    }

    function validateMenuSelection() {
      if (!hasMenuSelection) {
        return { valid: true };
      }

      const validationMessage = document.getElementById('validation-message');
      let errors = [];

      if (!selectedMainMenu) {
        errors.push('Pilih satu menu utama');
      }

      if (selectedSideDishes.length < sideDishesMin) {
        errors.push(`Pilih minimal ${sideDishesMin} lauk pendamping`);
      }

      if (selectedSideDishes.length > sideDishesMax) {
        errors.push(`Maksimal ${sideDishesMax} lauk pendamping`);
      }

      if (errors.length > 0) {
        const errorMsg = errors.join('\n');
        if (validationMessage) {
          validationMessage.textContent = '❌ ' + errors.join(' & ');
          validationMessage.classList.add('text-red-600');
        }
        alert('Mohon lengkapi pilihan menu:\n\n' + errorMsg);
        return { valid: false };
      }

      if (validationMessage) {
        validationMessage.textContent = '✓ Pilihan menu Anda sudah lengkap';
        validationMessage.classList.remove('text-red-600');
      }

      return { valid: true };
    }

    function updateCheckout() {
      const qty = calculateClampedQty();
      const total = qty * basePrice;

      display.textContent = new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
      }).format(total);

      let messageLines = [
        `Halo Dzanis Catering, saya ingin memesan *${packageName}* sebanyak *${qty} porsi*.`,
      ];

      if (hasMenuSelection) {
        if (selectedMainMenu) {
          messageLines.push(`Menu Utama: ${selectedMainMenu}`);
        }
        if (selectedSideDishes.length > 0) {
          messageLines.push(`Lauk Pendamping: ${selectedSideDishes.join(', ')}`);
        }
      }

      if (selectedEventDate) {
        const dateObj = new Date(selectedEventDate);
        const formattedDate = dateObj.toLocaleDateString('id-ID', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        messageLines.push(`Tanggal Acara: ${formattedDate}`);
      }

      messageLines.push(
        `Total estimasi: Rp ${total.toLocaleString('id-ID')}.`,
        `Mohon konfirmasi ketersediaan. Terima kasih!`
      );

      const rawMessage = messageLines.join('\n');
      btn.dataset.waMessage = rawMessage;
    }

    btn.addEventListener('click', (e) => {
      if (hasMenuSelection) {
        const validation = validateMenuSelection();
        if (!validation.valid) {
          e.preventDefault();
          return;
        }
      }

      if (eventDateInput && !eventDateInput.value) {
        e.preventDefault();
        alert('Mohon pilih tanggal acara minimal hari berikutnya.');
        return;
      }

      if (eventDateInput && eventDateInput.value) {
        const selectedDate = new Date(`${eventDateInput.value}T00:00:00`);
        const minSelectableDate = new Date(`${minEventDateString}T00:00:00`);

        if (selectedDate < minSelectableDate) {
          e.preventDefault();
          alert('Tanggal acara tidak bisa dipilih hari ini atau hari sebelumnya. Minimal pilih tanggal besok.');
          return;
        }
      }

      const waMessage = btn.dataset.waMessage;
      if (waMessage) {
        btn.href = `https://wa.me/${phone}?text=${encodeURIComponent(waMessage)}`;
      }
    });

    input.addEventListener('input', updateCheckout);

    input.addEventListener('blur', () => {
      let val = parseInt(input.value, 10);
      if (isNaN(val) || val < minOrder) {
        input.value = minOrder.toString();
        updateCheckout();
      }
    });

    if (eventDateInput) {
      eventDateInput.addEventListener('change', (e) => {
        selectedEventDate = e.target.value;
        updateCheckout();
      });
    }

    updateCheckout();
    if (hasMenuSelection) {
      updateSummary();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortionCalculator);
  } else {
    initPortionCalculator();
  }
  document.addEventListener('astro:page-load', initPortionCalculator);
</script>
