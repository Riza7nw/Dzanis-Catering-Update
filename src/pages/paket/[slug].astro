---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/organic/Navbar.astro';
import Footer from '../../components/organic/Footer.astro';
import PackageSelector from '../../components/interactive/PackageSelector.astro';
import PackageHeader from '../../components/paket/PackageHeader.astro';
import PackageGallery from '../../components/paket/PackageGallery.astro';
import PackageAccordion from '../../components/paket/PackageAccordion.astro';
import PackageMenuCustomizer from '../../components/paket/PackageMenuCustomizer.astro';
import PackageOrderBar from '../../components/paket/PackageOrderBar.astro';
import { DAFTAR_PAKET, type Paket, formatNamaPaket } from '../../data/paket';
import { waPhoneNumber } from '../../data/company';
import { generateProductSchema } from '../../utils/schema';
import { getMenuCatalog } from '../../services/api/menuService';

export async function getStaticPaths() {
  const catalog = await getMenuCatalog();
  const allPackagesMap = new Map<string, Paket>();

  // 1. Base master packages
  for (const p of DAFTAR_PAKET) {
    allPackagesMap.set(p.slug, p);
  }

  // 2. Overlay & sertakan paket baru dari database backend
  for (const p of catalog) {
    if (!p.slug) continue;
    const existing = allPackagesMap.get(p.slug);
    if (existing) {
      allPackagesMap.set(p.slug, {
        ...existing,
        nama: p.nama || existing.nama,
        harga: p.harga || existing.harga,
        badge: p.badge !== undefined ? p.badge : existing.badge,
        foto: p.foto || existing.foto,
        deskripsiSingkat: p.deskripsiSingkat || existing.deskripsiSingkat,
        minOrder: p.minOrder || existing.minOrder,
      });
    } else {
      allPackagesMap.set(p.slug, p);
    }
  }

  return Array.from(allPackagesMap.values()).map((paket) => ({
    params: { slug: paket.slug },
    props: { paket },
  }));
}

interface Props {
  paket: Paket;
}

const { paket } = Astro.props;

// Ambil pembaruan terkini dari database jika backend online (harga, nama, badge, foto, items)
const catalog = await getMenuCatalog();
const backendPkg = catalog.find((p) => p.slug === paket.slug || p.id === paket.id);

const activePaket: Paket = backendPkg
  ? {
      ...paket,
      nama: backendPkg.nama || paket.nama,
      harga: backendPkg.harga || paket.harga,
      badge: backendPkg.badge !== undefined ? backendPkg.badge : paket.badge,
      foto: backendPkg.foto || paket.foto,
      deskripsiSingkat: backendPkg.deskripsiSingkat || paket.deskripsiSingkat,
      minOrder: backendPkg.minOrder || paket.minOrder,
      menuUtama: backendPkg.menuUtama && backendPkg.menuUtama.length > 0 ? backendPkg.menuUtama : paket.menuUtama,
      laukPendamping: backendPkg.laukPendamping && backendPkg.laukPendamping.length > 0 ? backendPkg.laukPendamping : paket.laukPendamping,
    }
  : paket;

const pageTitle = `${formatNamaPaket(activePaket.nama)} | Dzanis Catering`;
const pageDescription = activePaket.deskripsiSingkat;
const productSchema = generateProductSchema(activePaket);

const tomorrow = new Date();
tomorrow.setDate(tomorrow.getDate() + 1);
const minEventDateString = [
  tomorrow.getFullYear(),
  String(tomorrow.getMonth() + 1).padStart(2, '0'),
  String(tomorrow.getDate()).padStart(2, '0'),
].join('-');

const defaultMainMenu = activePaket.selectableMainMenus?.[0] || activePaket.menuUtama[0] || '';
const defaultSideDishes =
  activePaket.canSelectMainMenu && activePaket.laukPendamping && activePaket.laukPendamping.length > 0
    ? activePaket.laukPendamping.slice(0, activePaket.sideDishesSelectMax ?? 3)
    : activePaket.laukPendamping;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={productSchema}
  useTransitions={true}
>
  <Navbar />

  <main id="konten" class="bg-bg w-full max-w-full min-w-0 flex-1 overflow-x-clip">
    <!-- Main Detail Section -->
    <div
      id="package-detail-root"
      data-base-price={activePaket.harga}
      data-package-name={formatNamaPaket(activePaket.nama)}
      data-min-order={activePaket.minOrder}
      data-min-order-weekend={activePaket.minOrderWeekend || 40}
      data-max-order={activePaket.maxOrder || 500}
      data-phone={waPhoneNumber}
      data-has-menu-selection={String(Boolean(activePaket.canSelectMainMenu))}
      data-side-dishes-min={activePaket.sideDishesSelectMin ?? 0}
      data-side-dishes-max={activePaket.sideDishesSelectMax ?? 0}
      data-default-main-menu={defaultMainMenu}
      data-default-side-dishes={JSON.stringify(defaultSideDishes)}
      data-min-event-date={minEventDateString}
      class="mx-auto max-w-[1280px] px-4 pt-6 sm:pt-8 lg:pt-10 pb-12 sm:pb-16 lg:pb-20 sm:px-6 lg:px-14"
    >
      <div class="mb-6">
        <a
          href="/#paket"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 hover:text-accent-900 transition-colors"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Kembali ke Daftar Paket</span>
        </a>
      </div>

      <!-- Scalable Package Selector (Trigger Button with Bottom Sheet / Dropdown) -->
      <PackageSelector currentPaket={activePaket} packages={catalog.length > 0 ? catalog : DAFTAR_PAKET} />

      <!-- Responsive Breakdown: Mobile (Stacked: Tulisan -> Gambar -> Specs -> Form) & Desktop (2-Column Berjejeran) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-x-12 lg:gap-y-8 items-start">
        <PackageHeader paket={activePaket} />
        <PackageGallery paket={activePaket} />
        <PackageAccordion paket={activePaket} />

        <!-- 4. Interactive Form, Menu Selection & Calculator (Mobile: 4th / Desktop: Right Column Row 2) -->
        <div class="lg:col-span-7 lg:col-start-6 lg:row-start-2 flex flex-col gap-8">
          <PackageMenuCustomizer
            paket={activePaket}
            defaultMainMenu={defaultMainMenu}
            defaultSideDishes={defaultSideDishes}
          />
          <PackageOrderBar
            paket={activePaket}
            minEventDateString={minEventDateString}
          />
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { initPackageOrderController } from '../../scripts/package-order-controller';
  initPackageOrderController();
</script>

<script is:inline>
  // Dynamic Real-time Client Sync dengan Database Backend (/api/menu)
  (async function syncPackageDetailWithApi() {
    try {
      const root = document.getElementById('package-detail-root');
      if (!root) return;
      const pathname = window.location.pathname.replace(/\/$/, '');
      const slug = pathname.split('/').pop();
      if (!slug) return;

      const hostname = window.location.hostname;
      const isLocal = hostname === 'localhost' || hostname === '127.0.0.1' || hostname.startsWith('192.168.') || hostname.startsWith('10.') || hostname.endsWith('.local');
      const defaultLocalApi = `${window.location.protocol}//${hostname || '127.0.0.1'}:8000`;
      const queryApi = (new URLSearchParams(window.location.search)).get('apiUrl');
      const apiUrl = queryApi || (isLocal ? defaultLocalApi : 'https://alkalize-rewire-scruffy.ngrok-free.dev');
      if (!apiUrl) return;

      const res = await fetch(`${apiUrl}/api/menu`, {
        headers: { 'ngrok-skip-browser-warning': 'true', 'Accept': 'application/json' }
      });
      if (!res.ok) return;

      const contentType = res.headers.get('content-type') || '';
      if (!contentType.includes('application/json')) return;

      const data = await res.json();
      const packages = Array.isArray(data)
        ? data
        : (Array.isArray(data?.packages) ? data.packages : (Array.isArray(data?.data) ? data.data : []));

      const livePkg = packages.find((p) => p.slug === slug || p.id === slug || (p.name && p.name.toLowerCase().includes(slug.replace(/-/g, ' '))));
      if (!livePkg) return;

      const newPrice = Number(livePkg.price_per_pax || livePkg.harga);
      if (newPrice && !isNaN(newPrice) && newPrice > 0) {
        root.dataset.basePrice = String(newPrice);
        const priceEls = document.querySelectorAll('.package-live-price');
        priceEls.forEach((el) => {
          el.textContent = newPrice.toLocaleString('id-ID');
        });

        // Trigger input event to recalculate portion total
        const portionInput = document.getElementById('portion-input');
        if (portionInput) {
          portionInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    } catch (err) {
      console.warn('[Dzanis Detail] Sinkronisasi harga runtime terlewat:', err);
    }
  })();
</script>
