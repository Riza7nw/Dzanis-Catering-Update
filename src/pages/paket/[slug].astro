---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/organic/Navbar.astro';
import Footer from '../../components/organic/Footer.astro';
import PackageSelector from '../../components/interactive/PackageSelector.astro';
import { DAFTAR_PAKET, type Paket, formatNamaPaket } from '../../data/paket';
import { waPhoneNumber } from '../../data/company';
import { generateProductSchema } from '../../utils/schema';

export async function getStaticPaths() {
  return DAFTAR_PAKET.map((paket) => ({
    params: { slug: paket.slug },
    props: { paket },
  }));
}

interface Props {
  paket: Paket;
}

const { paket } = Astro.props;

const pageTitle = `${formatNamaPaket(paket.nama)} | Dzanis Catering`;
const pageDescription = paket.deskripsiSingkat;
const productSchema = generateProductSchema(paket);

const tomorrow = new Date();
tomorrow.setDate(tomorrow.getDate() + 1);
const minEventDateString = [
  tomorrow.getFullYear(),
  String(tomorrow.getMonth() + 1).padStart(2, '0'),
  String(tomorrow.getDate()).padStart(2, '0'),
].join('-');

const defaultMainMenu = paket.selectableMainMenus?.[0] || paket.menuUtama[0] || '';
const defaultSideDishes = paket.selectableSideDishes?.slice(0, paket.sideDishesSelectMin ?? 2) || paket.laukPendamping.slice(0, 2);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={productSchema}
  useTransitions={true}
>
  <Navbar />

  <main id="konten" class="bg-bg">
    <!-- Main Detail Section -->
    <div
      id="package-detail-root"
      data-base-price={paket.harga}
      data-package-name={formatNamaPaket(paket.nama)}
      data-min-order={paket.minOrder}
      data-phone={waPhoneNumber}
      data-has-menu-selection={String(Boolean(paket.canSelectMainMenu))}
      data-side-dishes-min={paket.sideDishesSelectMin ?? 0}
      data-side-dishes-max={paket.sideDishesSelectMax ?? 0}
      data-default-main-menu={defaultMainMenu}
      data-default-side-dishes={JSON.stringify(defaultSideDishes)}
      data-min-event-date={minEventDateString}
      class="mx-auto max-w-[1280px] px-4 pt-6 sm:pt-8 lg:pt-10 pb-12 sm:pb-16 lg:pb-20 sm:px-6 lg:px-14"
    >
      <div class="mb-6">
        <a
          href="/#paket"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 hover:text-accent-900 transition-colors"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Kembali ke Daftar Paket</span>
        </a>
      </div>

      <!-- Scalable Package Selector (Trigger Button with Bottom Sheet / Dropdown) -->
      <PackageSelector currentPaket={paket} />

      <!-- Responsive Breakdown: Mobile (Stacked: Tulisan -> Gambar -> Specs -> Form) & Desktop (2-Column Berjejeran) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-x-12 lg:gap-y-8 items-start">
        <!-- 1. Header & Price (Mobile: 1st / Desktop: Right Column Row 1) -->
        <div class="lg:col-span-7 lg:col-start-6 lg:row-start-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="rounded-full bg-accent-2-200 text-accent-2-900 px-3 py-0.5 text-sm font-semibold">
              Nasi Kotak Higienis
            </span>
            {paket.badge && (
              <span class="rounded-full bg-accent/10 text-accent px-3 py-0.5 text-sm font-bold uppercase tracking-wider">
                {paket.badge}
              </span>
            )}
          </div>

          <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 tracking-tight">
            {formatNamaPaket(paket.nama)}
          </h1>

          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-heading text-xl text-neutral-500 font-semibold">Rp</span>
            <span class="font-heading text-3xl sm:text-4xl font-bold text-accent-700 leading-none">
              {paket.harga.toLocaleString("id-ID")}
            </span>
            <span class="text-sm font-medium text-neutral-600">/ porsi</span>
          </div>

          <p class="mt-4 text-sm sm:text-base text-neutral-900 leading-relaxed">
            {paket.deskripsiLengkap}
          </p>

          <!-- Specs Cards: Kemasan & Minimum Order -->
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="rounded-2xl border border-neutral-200 bg-white p-3.5 shadow-sm">
              <span class="block text-[13px] font-semibold uppercase tracking-wider text-neutral-500">
                Kemasan
              </span>
              <span class="mt-0.5 block text-sm font-bold text-neutral-900">
                {paket.kemasan}
              </span>
            </div>

            <div class="rounded-2xl border border-neutral-200 bg-white p-3.5 shadow-sm">
              <span class="block text-[13px] font-semibold uppercase tracking-wider text-neutral-500">
                Minimum Order
              </span>
              <span class="mt-0.5 block text-sm font-bold text-neutral-900">
                {paket.minOrder} Porsi / Box
              </span>
            </div>
          </div>
        </div>

        <!-- 2. Main Photo Card (Mobile: 2nd / Desktop: Left Column Row 1) -->
        <div class="lg:col-span-5 lg:col-start-1 lg:row-start-1">
          <div class="relative aspect-[16/10] sm:aspect-[4/3] w-full overflow-hidden rounded-3xl border border-neutral-200/80 bg-surface shadow-sm">
            <img
              src={paket.foto}
              alt={formatNamaPaket(paket.fotoAlt || paket.nama)}
              loading="eager"
              fetchpriority="high"
              width="600"
              height="450"
              decoding="async"
              class="h-full w-full object-cover"
            />
            {paket.badge && (
              <span class="absolute top-3.5 left-3.5 rounded-full bg-accent px-3 py-1 font-heading text-sm tracking-wider text-white font-bold uppercase shadow-md">
                {paket.badge}
              </span>
            )}
          </div>
        </div>

        <!-- 3. Left Column Row 2: Komposisi & Ketentuan Pemesanan -->
        <div class="lg:col-span-5 lg:col-start-1 lg:row-start-2 flex flex-col gap-6">

          <!-- Collapsible Komposisi & Menu Sajian -->
          <div id="composition-collapsible-section">
            <button
              type="button"
              id="composition-toggle-btn"
              aria-expanded="false"
              aria-controls="composition-content"
              class="w-full flex items-center justify-between gap-3 p-4 sm:p-4.5 rounded-2xl bg-white hover:bg-surface/70 border border-neutral-200/90 hover:border-accent/40 shadow-2xs transition-all duration-200 group cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="size-9 sm:size-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-none group-hover:scale-105 transition-transform duration-200">
                  <svg class="size-4.5 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </div>
                <div class="text-left min-w-0">
                  <h3 class="font-heading text-sm sm:text-base font-bold text-neutral-900 group-hover:text-accent-700 transition-colors truncate">
                    Lihat Komposisi & Menu Sajian
                  </h3>
                  <p class="text-sm text-neutral-500 mt-0.5 truncate">
                    Rincian menu utama, lauk pendamping, sambal & pelengkap
                  </p>
                </div>
              </div>
              <div class="size-8 rounded-full bg-surface border border-neutral-200 flex items-center justify-center text-neutral-600 group-hover:text-accent-700 group-hover:border-accent/40 shadow-2xs flex-none transition-colors">
                <svg
                  id="composition-chevron"
                  class="size-4.5 transition-transform duration-300 ease-in-out"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </div>
            </button>

            <!-- Animated Collapsible Content (CSS Grid Transition) -->
            <div
              id="composition-content"
              class="akordeon-panel"
              data-buka="false"
            >
              <div class="overflow-hidden">
                <div class="pt-4">
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3.5">
                    <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                      <div class="flex items-center gap-2 mb-2.5">
                        <span class="text-base" aria-hidden="true">🍗</span>
                        <h4 class="font-heading text-sm font-bold uppercase tracking-wider text-neutral-900">
                          Menu Utama
                        </h4>
                      </div>
                      <ul class="space-y-1.5 text-sm text-neutral-900">
                        {paket.menuUtama.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="text-accent font-bold flex-none">•</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                      <div class="flex items-center gap-2 mb-2.5">
                        <span class="text-base" aria-hidden="true">🥗</span>
                        <h4 class="font-heading text-sm font-bold uppercase tracking-wider text-neutral-900">
                          Lauk Pendamping
                        </h4>
                      </div>
                      <ul class="space-y-1.5 text-sm text-neutral-900">
                        {paket.laukPendamping.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="text-accent font-bold flex-none">•</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                      <div class="flex items-center gap-2 mb-2.5">
                        <span class="text-base" aria-hidden="true">🌶️</span>
                        <h4 class="font-heading text-sm font-bold uppercase tracking-wider text-neutral-900">
                          Sambal & Lalapan
                        </h4>
                      </div>
                      <ul class="space-y-1.5 text-sm text-neutral-900">
                        {paket.sambalLalapan.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="text-accent font-bold flex-none">•</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-2xs">
                      <div class="flex items-center gap-2 mb-2.5">
                        <span class="text-base" aria-hidden="true">🍱</span>
                        <h4 class="font-heading text-sm font-bold uppercase tracking-wider text-neutral-900">
                          Pelengkap & Kemasan
                        </h4>
                      </div>
                      <ul class="space-y-1.5 text-sm text-neutral-900">
                        {paket.pelengkap.map((item) => (
                          <li class="flex items-start gap-2">
                            <span class="text-accent font-bold flex-none">•</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Operational Notice Box -->
          <div class="rounded-2xl border border-neutral-200/90 bg-surface/60 p-5 text-neutral-800">
            <h4 class="font-heading text-sm font-bold text-neutral-900 mb-3 uppercase tracking-wide">
              Ketentuan Pemesanan
            </h4>
            <ul class="space-y-2 text-sm leading-relaxed text-neutral-900">
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Cutoff H-2 / H-3:</strong> Disarankan memesan minimal H-3 agar persiapan bahan baku optimal.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>100% Halal:</strong> Menggunakan bahan pilihan berkualitas dengan dapur higienis rumahan Majalengka.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Area Pengantaran:</strong> Melayani seluruh Ciayumajakuning (Cirebon, Indramayu, Majalengka, Kuningan).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-bold">✓</span>
                <span><strong>Alat Makan:</strong> Sudah termasuk sendok, tisu, dan tusuk gigi steril dalam setiap box.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- 4. Interactive Form, Menu Selection & Calculator (Mobile: 4th / Desktop: Right Column Row 2) -->
        <div class="lg:col-span-7 lg:col-start-6 lg:row-start-2 flex flex-col gap-8">
          {paket.canSelectMainMenu && paket.selectableMainMenus && paket.selectableSideDishes && (
            <div id="section-pilihan-menu">
              <div class="mb-4">
                <h3 class="font-heading text-lg sm:text-xl font-bold text-neutral-900">
                  Pilihan Menu Sajian
                </h3>
                <p class="text-[13px] sm:text-sm text-neutral-600 mt-1">
                  Pilih menu standar rekomendasi kami atau racik kombinasi lauk sesuai selera Anda.
                </p>
              </div>

              <!-- 2 Tombol Pilihan Jalur Pemesanan -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                <!-- Tombol 1: Pesan Paket Default -->
                <button
                  type="button"
                  id="btn-order-default"
                  class="flex items-center justify-between p-3.5 sm:p-4 rounded-2xl border-2 border-accent bg-accent/8 hover:bg-accent/12 transition-all duration-200 cursor-pointer text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent shadow-2xs group"
                  aria-pressed="true"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div id="icon-order-default" class="size-9 rounded-xl bg-accent text-white flex items-center justify-center flex-none font-bold shadow-xs transition-colors">
                      <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <span class="block font-heading text-sm sm:text-base font-bold text-neutral-900 truncate">
                        Pesan Paket Default
                      </span>
                      <span class="block text-[13px] text-neutral-600 mt-0.5 truncate">
                        Menu bawaan standar (terfavorit)
                      </span>
                    </div>
                  </div>
                  <span id="badge-order-default" class="text-[13px] font-bold text-accent bg-white border border-accent/30 px-2.5 py-1 rounded-full flex-none shadow-2xs">
                    Aktif
                  </span>
                </button>

                <!-- Tombol 2: Racik Menu Sendiri -->
                <button
                  type="button"
                  id="btn-order-custom"
                  aria-expanded="false"
                  aria-controls="custom-menu-collapsible"
                  class="flex items-center justify-between p-3.5 sm:p-4 rounded-2xl border-2 border-neutral-200/90 bg-white hover:bg-surface/80 hover:border-neutral-300 transition-all duration-200 cursor-pointer text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent shadow-2xs group"
                  aria-pressed="false"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div id="icon-order-custom" class="size-9 rounded-xl bg-surface border border-neutral-200 text-neutral-600 flex items-center justify-center flex-none group-hover:border-accent/40 group-hover:text-accent transition-colors">
                      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20h9"/>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <span class="block font-heading text-sm sm:text-base font-bold text-neutral-900 group-hover:text-accent-700 transition-colors truncate">
                        Racik Menu Sendiri
                      </span>
                      <span class="block text-[13px] text-neutral-600 mt-0.5 truncate">
                        Kustomisasi menu & lauk
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 flex-none">
                    <span id="badge-order-custom" class="hidden text-[13px] font-bold text-accent bg-white border border-accent/30 px-2.5 py-1 rounded-full shadow-2xs">
                      Aktif
                    </span>
                    <span class="size-7 rounded-lg bg-surface flex items-center justify-center text-neutral-500 group-hover:text-accent-700 transition-colors">
                      <svg
                        id="custom-menu-chevron"
                        class="size-4.5 transition-transform duration-300 ease-in-out"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                  </div>
                </button>
              </div>

              <!-- Default Preset Information Box (Tampil saat default aktif) -->
              <div
                id="default-preset-box"
                class="rounded-2xl border border-accent/20 bg-accent/5 p-4 sm:p-4.5 mb-4 transition-all duration-200"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1.5">
                      <span class="inline-flex items-center justify-center size-5 rounded-full bg-accent text-white text-xs font-bold" aria-hidden="true">✓</span>
                      <h4 class="font-heading text-sm sm:text-base font-bold text-neutral-900">
                        Menu Bawaan Rekomendasi Terpasang
                      </h4>
                    </div>
                    <p class="text-sm text-neutral-900">
                      <span class="font-semibold text-accent-700">Menu Utama:</span> {defaultMainMenu}
                    </p>
                    <p class="text-sm text-neutral-900 mt-0.5">
                      <span class="font-semibold text-neutral-800">Lauk Pendamping:</span> {defaultSideDishes.join(', ')}
                    </p>
                  </div>
                  <span class="text-[13px] font-semibold text-neutral-500 bg-white/90 border border-neutral-200/90 px-2.5 py-1 rounded-lg flex-none shadow-2xs hidden sm:inline-block">
                    Preset Bawaan
                  </span>
                </div>
              </div>

              <!-- Collapsible Custom Menu Container (Akordeon CSS Grid Transition) -->
              <div
                id="custom-menu-collapsible"
                class="akordeon-panel mb-2"
                data-buka="false"
              >
                <div class="overflow-hidden">
                  <div class="pt-2 pb-4 space-y-6">
                    <div>
                      <div class="flex items-center justify-between mb-3">
                        <span class="block text-sm font-bold text-neutral-900">
                          🍗 Pilih Menu Utama
                        </span>
                        <span class="text-[13px] text-neutral-500">Pilih 1 menu</span>
                      </div>
                      <div class="space-y-2">
                        {paket.selectableMainMenus!.map((menu, idx) => {
                          const inputId = `main-menu-${idx}`;
                          return (
                            <label
                              for={inputId}
                              class="flex items-center gap-3 p-3 rounded-2xl border border-neutral-200 bg-white cursor-pointer hover:bg-accent/5 hover:border-accent/40 transition group has-[:checked]:border-accent has-[:checked]:bg-accent/5 shadow-2xs"
                            >
                              <input
                                type="radio"
                                id={inputId}
                                name="main-menu"
                                value={menu}
                                class="w-4 h-4 cursor-pointer accent-accent"
                                checked={idx === 0}
                              />
                              <span class="text-sm font-medium text-neutral-800 group-hover:text-accent-700 transition">
                                {menu}
                              </span>
                            </label>
                          );
                        })}
                      </div>
                    </div>

                    <div>
                      <div class="flex items-center justify-between mb-3">
                        <span class="block text-sm font-bold text-neutral-900">
                          🥗 Pilih {paket.sideDishesSelectMin}-{paket.sideDishesSelectMax} Lauk Pendamping
                        </span>
                        <span class="text-sm font-medium text-neutral-500" id="side-count" aria-live="polite">
                          {defaultSideDishes.length} / {paket.sideDishesSelectMax} pilihan
                        </span>
                      </div>
                      <div class="space-y-2">
                        {paket.selectableSideDishes!.map((dish, idx) => {
                          const inputId = `side-dish-${idx}`;
                          return (
                            <label
                              for={inputId}
                              class="flex items-center gap-3 p-3 rounded-2xl border border-neutral-200 bg-white cursor-pointer hover:bg-accent/5 hover:border-accent/40 transition group has-[:checked]:bg-accent/10 has-[:checked]:border-accent/40 shadow-2xs"
                            >
                              <input
                                type="checkbox"
                                id={inputId}
                                name="side-dishes"
                                value={dish}
                                class="w-4 h-4 cursor-pointer accent-accent"
                                data-min={paket.sideDishesSelectMin}
                                data-max={paket.sideDishesSelectMax}
                                checked={idx < (paket.sideDishesSelectMin ?? 2)}
                              />
                              <span class="text-sm font-medium text-neutral-800 group-hover:text-accent-700 transition">
                                {dish}
                              </span>
                            </label>
                          );
                        })}
                      </div>
                      <p class="text-sm text-neutral-500 mt-3">
                        Pilih minimal {paket.sideDishesSelectMin} dan maksimal {paket.sideDishesSelectMax} lauk pendamping.
                      </p>
                    </div>

                    <div class="rounded-2xl border border-accent/20 bg-accent/5 p-4">
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <h4 class="text-sm font-bold uppercase tracking-wider text-neutral-600">
                          Ringkasan Pilihan Anda:
                        </h4>
                        <span id="validation-indicator" class="text-xs font-semibold text-accent-700">
                          ✓ Pilihan Siap
                        </span>
                      </div>
                      <div class="text-sm text-neutral-800 space-y-1">
                        <p id="menu-summary-main" class="font-medium text-accent-700">
                          Menu: {defaultMainMenu}
                        </p>
                        <p id="menu-summary-sides" class="text-neutral-900 text-sm">
                          Lauk: {defaultSideDishes.join(', ')}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Interactive Portion Calculator -->
          <div class="rounded-3xl border border-neutral-200 bg-surface/50 p-6 sm:p-7 shadow-sm">
            <div class="mb-5">
              <h3 class="font-heading text-xl font-bold text-neutral-900">
                Kalkulator Porsi & Pemesanan
              </h3>
              <p class="text-sm text-neutral-600 mt-1">
                Tentukan jumlah porsi yang dibutuhkan untuk menghitung estimasi biaya dan membuat format pesan WhatsApp otomatis.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
              <div class="sm:col-span-5">
                <label for="portion-input" class="block text-sm font-bold uppercase tracking-wider text-neutral-800 mb-1.5">
                  Jumlah Porsi (Min. {paket.minOrder})
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="portion-input"
                    min={paket.minOrder}
                    step="5"
                    value={paket.minOrder}
                    class="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-base sm:text-lg font-bold text-neutral-900 focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none transition shadow-2xs"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-semibold text-neutral-500 pointer-events-none">
                    porsi
                  </span>
                </div>
              </div>

              <div class="sm:col-span-7 rounded-2xl border border-neutral-200 bg-white p-3.5 sm:p-4 shadow-2xs flex flex-col justify-center">
                <span class="text-[13px] font-bold uppercase tracking-wider text-neutral-500">
                  Estimasi Total Biaya:
                </span>
                <span
                  id="subtotal-display"
                  aria-live="polite"
                  role="status"
                  class="font-heading text-2xl sm:text-3xl font-bold text-accent-700 leading-none mt-1"
                >
                  Rp {(paket.harga * paket.minOrder).toLocaleString("id-ID")}
                </span>
              </div>
            </div>

            <div class="mt-4">
              <label for="event-date-input" class="block text-sm font-bold uppercase tracking-wider text-neutral-800 mb-1.5">
                Tanggal Acara
              </label>
              <input
                type="date"
                id="event-date-input"
                min={minEventDateString}
                required
                class="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-base font-medium text-neutral-900 focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none transition shadow-2xs"
              />
              <p class="text-sm text-neutral-500 mt-2">
                Pilih tanggal acara Anda untuk memudahkan proses pemesanan.
              </p>
            </div>

            <div class="mt-5">
              <a
                id="wa-checkout-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2.5 rounded-full bg-accent py-3.5 px-6 text-sm font-bold uppercase tracking-wider text-white shadow-md hover:bg-accent-700 transition duration-200"
              >
                <svg class="size-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>Pesan Sekarang via WhatsApp</span>
              </a>
              {paket.canSelectMainMenu && (
                <p class="mt-2 text-center text-sm text-neutral-500" id="validation-message" role="alert" aria-live="assertive">
                  Pastikan Anda telah memilih menu dan lauk pendamping sebelum memesan.
                </p>
              )}
              {!paket.canSelectMainMenu && (
                <p class="mt-2 text-center text-sm text-neutral-500">
                  Format pesan WhatsApp akan otomatis terisi dengan rincian paket dan jumlah porsi.
                </p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface PackageConfig {
    basePrice: number;
    packageName: string;
    minOrder: number;
    phone: string;
    hasMenuSelection: boolean;
    sideDishesMin: number;
    sideDishesMax: number;
    defaultMainMenu: string;
    defaultSideDishes: string[];
    minEventDateString: string;
  }

  let detailPageAbortController: AbortController | null = null;

  function initPortionCalculator(config: PackageConfig, signal: AbortSignal) {
    const input = document.getElementById('portion-input') as HTMLInputElement | null;
    const display = document.getElementById('subtotal-display');
    const btn = document.getElementById('wa-checkout-btn') as HTMLAnchorElement | null;
    const eventDateInput = document.getElementById('event-date-input') as HTMLInputElement | null;

    if (!input || !display || !btn) return;
    const checkoutBtn = btn;
    const portionInput = input;

    const {
      basePrice,
      packageName,
      minOrder,
      phone,
      hasMenuSelection,
      sideDishesMin,
      sideDishesMax,
      defaultMainMenu,
      defaultSideDishes,
      minEventDateString,
    } = config;

    // Order Mode State: 'default' | 'custom'
    let orderMode: 'default' | 'custom' = 'default';
    const btnOrderDefault = document.getElementById('btn-order-default');
    const btnOrderCustom = document.getElementById('btn-order-custom');
    const iconOrderDefault = document.getElementById('icon-order-default');
    const iconOrderCustom = document.getElementById('icon-order-custom');
    const badgeOrderDefault = document.getElementById('badge-order-default');
    const badgeOrderCustom = document.getElementById('badge-order-custom');
    const customMenuChevron = document.getElementById('custom-menu-chevron');
    const customMenuCollapsible = document.getElementById('custom-menu-collapsible') as HTMLElement | null;
    const defaultPresetBox = document.getElementById('default-preset-box');

    let selectedMainMenu = defaultMainMenu;
    let selectedSideDishes = Array.isArray(defaultSideDishes) ? [...defaultSideDishes] : [];
    let selectedEventDate: string | null = null;

    function calculateClampedQty() {
      let rawVal = parseInt(input?.value || '', 10);
      if (isNaN(rawVal) || rawVal < minOrder) {
        return minOrder;
      }
      return rawVal;
    }

    function syncActiveCustomInputs() {
      const activeRadio = document.querySelector('input[name="main-menu"]:checked') as HTMLInputElement | null;
      if (activeRadio) {
        selectedMainMenu = activeRadio.value;
      }
      const checkedCheckboxes = document.querySelectorAll('input[name="side-dishes"]:checked') as NodeListOf<HTMLInputElement>;
      selectedSideDishes = Array.from(checkedCheckboxes).map(cb => cb.value);

      const sideCount = document.getElementById('side-count');
      if (sideCount && sideDishesMax) {
        sideCount.textContent = `${selectedSideDishes.length} / ${sideDishesMax} pilihan`;
      }
    }

    function setOrderMode(mode: 'default' | 'custom', updateUrl = true) {
      if (mode === 'default') {
        orderMode = 'default';

        // Button Default Active
        btnOrderDefault?.setAttribute('aria-pressed', 'true');
        btnOrderDefault?.classList.add('border-accent', 'bg-accent/8', 'text-neutral-900', 'shadow-2xs');
        btnOrderDefault?.classList.remove('border-neutral-200/90', 'bg-white', 'text-neutral-900');
        if (iconOrderDefault) {
          iconOrderDefault.className = 'size-9 rounded-xl bg-accent text-white flex items-center justify-center flex-none font-bold shadow-xs transition-colors';
        }
        badgeOrderDefault?.classList.remove('hidden');

        // Button Custom Inactive
        btnOrderCustom?.setAttribute('aria-pressed', 'false');
        btnOrderCustom?.setAttribute('aria-expanded', 'false');
        btnOrderCustom?.classList.remove('border-accent', 'bg-accent/8', 'text-neutral-900', 'shadow-2xs');
        btnOrderCustom?.classList.add('border-neutral-200/90', 'bg-white', 'text-neutral-900');
        if (iconOrderCustom) {
          iconOrderCustom.className = 'size-9 rounded-xl bg-surface border border-neutral-200 text-neutral-600 flex items-center justify-center flex-none group-hover:border-accent/40 group-hover:text-accent transition-colors';
        }
        badgeOrderCustom?.classList.add('hidden');

        // Collapsible closed
        customMenuChevron?.classList.remove('rotate-180');
        if (customMenuCollapsible) {
          customMenuCollapsible.setAttribute('data-buka', 'false');
          customMenuCollapsible.style.gridTemplateRows = '0fr';
        }

        // Preset box shown
        defaultPresetBox?.classList.remove('hidden');

        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          let changed = false;
          if (nextUrl.searchParams.has('mode')) {
            nextUrl.searchParams.delete('mode');
            changed = true;
          }
          if (nextUrl.hash === '#racik' || nextUrl.hash === '#custom') {
            nextUrl.hash = '';
            changed = true;
          }
          if (changed) {
            window.history.replaceState(null, '', nextUrl.pathname + (nextUrl.search ? nextUrl.search : '') + nextUrl.hash);
          }
        }

        updateCheckout();
      } else if (mode === 'custom') {
        orderMode = 'custom';

        // Button Custom Active
        btnOrderCustom?.setAttribute('aria-pressed', 'true');
        btnOrderCustom?.setAttribute('aria-expanded', 'true');
        btnOrderCustom?.classList.add('border-accent', 'bg-accent/8', 'text-neutral-900', 'shadow-2xs');
        btnOrderCustom?.classList.remove('border-neutral-200/90', 'bg-white', 'text-neutral-900');
        if (iconOrderCustom) {
          iconOrderCustom.className = 'size-9 rounded-xl bg-accent text-white flex items-center justify-center flex-none font-bold shadow-xs transition-colors';
        }
        badgeOrderCustom?.classList.remove('hidden');

        // Button Default Inactive
        btnOrderDefault?.setAttribute('aria-pressed', 'false');
        btnOrderDefault?.classList.remove('border-accent', 'bg-accent/8', 'text-neutral-900', 'shadow-2xs');
        btnOrderDefault?.classList.add('border-neutral-200/90', 'bg-white', 'text-neutral-900');
        if (iconOrderDefault) {
          iconOrderDefault.className = 'size-9 rounded-xl bg-surface border border-neutral-200 text-neutral-600 flex items-center justify-center flex-none group-hover:border-accent/40 group-hover:text-accent transition-colors';
        }
        badgeOrderDefault?.classList.add('hidden');

        // Collapsible open
        customMenuChevron?.classList.add('rotate-180');
        if (customMenuCollapsible) {
          customMenuCollapsible.setAttribute('data-buka', 'true');
          customMenuCollapsible.style.gridTemplateRows = '1fr';
        }
        defaultPresetBox?.classList.add('hidden');

        syncActiveCustomInputs();
        updateSummary();
        updateCheckout();

        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          if (nextUrl.searchParams.get('mode') !== 'custom') {
            nextUrl.searchParams.set('mode', 'custom');
            window.history.replaceState(null, '', nextUrl.pathname + nextUrl.search + nextUrl.hash);
          }
        }
      }
    }

    if (btnOrderDefault) {
      btnOrderDefault.addEventListener('click', () => {
        setOrderMode('default', true);
        portionInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, { signal });
    }

    if (btnOrderCustom) {
      btnOrderCustom.addEventListener('click', () => {
        setOrderMode('custom', true);
      }, { signal });
    }

    // Sync from URL (Single Source of Truth)
    function syncModeFromUrl(updateUrl = false) {
      const urlParams = new URLSearchParams(window.location.search);
      const urlMode = urlParams.get('mode');
      const hash = window.location.hash;

      if (urlMode === 'custom' || hash === '#racik' || hash === '#custom') {
        setOrderMode('custom', updateUrl);
      } else {
        setOrderMode('default', updateUrl);
      }
    }

    window.addEventListener('popstate', () => {
      syncModeFromUrl(false);
    }, { signal });

    if (hasMenuSelection) {
      const mainMenuRadios = document.querySelectorAll<HTMLInputElement>('input[name="main-menu"]');
      const sideDishCheckboxes = document.querySelectorAll<HTMLInputElement>('input[name="side-dishes"]');

      mainMenuRadios.forEach((radio) => {
        radio.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          if (target.checked) {
            selectedMainMenu = target.value;
            updateSummary();
            updateCheckout();
          }
        }, { signal });
      });

      sideDishCheckboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          const maxSelections = parseInt(target.dataset.max || '0', 10);
          const allCheckboxes = document.querySelectorAll<HTMLInputElement>('input[name="side-dishes"]');
          const checkedCount = Array.from(allCheckboxes).filter(cb => cb.checked).length;

          if (target.checked && checkedCount > maxSelections) {
            target.checked = false;
            alert(`Maksimal pilihan adalah ${maxSelections} lauk pendamping`);
            return;
          }

          selectedSideDishes = Array.from(allCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

          const sideCount = document.getElementById('side-count');
          if (sideCount) {
            sideCount.textContent = `${checkedCount} / ${maxSelections} pilihan`;
          }

          updateSummary();
          updateCheckout();
        }, { signal });
      });
    }

    function updateSummary() {
      const summaryMain = document.getElementById('menu-summary-main');
      const summarySides = document.getElementById('menu-summary-sides');
      const validationIndicator = document.getElementById('validation-indicator');

      if (summaryMain && selectedMainMenu) {
        summaryMain.textContent = `Menu: ${selectedMainMenu}`;
      }

      if (summarySides && selectedSideDishes.length > 0) {
        summarySides.textContent = `Lauk: ${selectedSideDishes.join(', ')}`;
      } else if (summarySides) {
        summarySides.textContent = 'Lauk: — (Belum dipilih)';
      }

      if (validationIndicator) {
        if (selectedSideDishes.length >= sideDishesMin && selectedSideDishes.length <= sideDishesMax && selectedMainMenu) {
          validationIndicator.textContent = '✓ Pilihan Siap';
          validationIndicator.className = 'text-xs font-semibold text-accent-700';
        } else {
          validationIndicator.textContent = `Pilih min. ${sideDishesMin} lauk`;
          validationIndicator.className = 'text-xs font-semibold text-amber-600';
        }
      }
    }

    function validateMenuSelection(): { valid: boolean } {
      if (!hasMenuSelection || orderMode === 'default') {
        return { valid: true };
      }

      let errors: string[] = [];

      if (!selectedMainMenu) {
        errors.push('Pilih satu menu utama');
      }

      if (selectedSideDishes.length < sideDishesMin) {
        errors.push(`Pilih minimal ${sideDishesMin} lauk pendamping`);
      }

      if (selectedSideDishes.length > sideDishesMax) {
        errors.push(`Maksimal ${sideDishesMax} lauk pendamping`);
      }

      if (errors.length > 0) {
        const errorMsg = errors.join('\n');
        alert('Mohon lengkapi racikan menu Anda:\n\n' + errorMsg + '\n\nAtau klik tombol "Pesan Paket Default" jika ingin menggunakan racikan menu standar.');
        return { valid: false };
      }

      return { valid: true };
    }

    function updateCheckout() {
      const qty = calculateClampedQty();
      const total = qty * basePrice;

      if (display) {
        display.textContent = new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          maximumFractionDigits: 0,
        }).format(total);
      }

      let messageLines = [
        `Halo Dzanis Catering, saya ingin memesan *${packageName}* sebanyak *${qty} porsi*.`,
      ];

      if (hasMenuSelection) {
        if (orderMode === 'default') {
          messageLines.push(`Pilihan Paket: Default (Menu Standar)`);
          messageLines.push(`Menu Utama: ${defaultMainMenu}`);
          messageLines.push(`Lauk Pendamping: ${Array.isArray(defaultSideDishes) ? defaultSideDishes.join(', ') : defaultSideDishes}`);
        } else {
          messageLines.push(`Pilihan Paket: Racik Menu Sendiri`);
          if (selectedMainMenu) {
            messageLines.push(`Menu Utama: ${selectedMainMenu}`);
          }
          if (selectedSideDishes.length > 0) {
            messageLines.push(`Lauk Pendamping: ${selectedSideDishes.join(', ')}`);
          }
        }
      }

      if (selectedEventDate) {
        const dateObj = new Date(selectedEventDate);
        const formattedDate = dateObj.toLocaleDateString('id-ID', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        messageLines.push(`Tanggal Acara: ${formattedDate}`);
      }

      messageLines.push(
        `Total estimasi: Rp ${total.toLocaleString('id-ID')}.`,
        `Mohon konfirmasi ketersediaan. Terima kasih!`
      );

      const rawMessage = messageLines.join('\n');
      checkoutBtn.dataset.waMessage = rawMessage;
    }

    checkoutBtn.addEventListener('click', (e) => {
      if (hasMenuSelection) {
        const validation = validateMenuSelection();
        if (!validation.valid) {
          e.preventDefault();
          return;
        }
      }

      if (eventDateInput && !eventDateInput.value) {
        e.preventDefault();
        alert('Mohon pilih tanggal acara minimal hari berikutnya.');
        return;
      }

      if (eventDateInput && eventDateInput.value) {
        const selectedDate = new Date(`${eventDateInput.value}T00:00:00`);
        const minSelectableDate = minEventDateString ? new Date(`${minEventDateString}T00:00:00`) : null;

        if (minSelectableDate && selectedDate < minSelectableDate) {
          e.preventDefault();
          alert('Tanggal acara tidak bisa dipilih hari ini atau hari sebelumnya. Minimal pilih tanggal besok.');
          return;
        }
      }

      const waMessage = checkoutBtn.dataset.waMessage;
      if (waMessage) {
        checkoutBtn.href = `https://wa.me/${phone}?text=${encodeURIComponent(waMessage)}`;
      }
    }, { signal });

    portionInput.addEventListener('input', updateCheckout, { signal });

    portionInput.addEventListener('blur', () => {
      let val = parseInt(portionInput.value, 10);
      if (isNaN(val) || val < minOrder) {
        portionInput.value = minOrder.toString();
        updateCheckout();
      }
    }, { signal });

    if (eventDateInput) {
      eventDateInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        selectedEventDate = target.value;
        updateCheckout();
      }, { signal });
    }

    // Initial state sync from URL / defaults
    syncModeFromUrl(false);
    updateCheckout();
    if (hasMenuSelection) {
      updateSummary();
    }
  }

  function initCompositionToggle(signal: AbortSignal) {
    const btn = document.getElementById('composition-toggle-btn');
    const content = document.getElementById('composition-content') as HTMLElement | null;
    const chevron = document.getElementById('composition-chevron');
    if (!btn || !content || !chevron) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      btn.setAttribute('aria-expanded', String(nextState));

      if (nextState) {
        content.setAttribute('data-buka', 'true');
        content.style.gridTemplateRows = '1fr';
        chevron.classList.add('rotate-180');
      } else {
        content.setAttribute('data-buka', 'false');
        content.style.gridTemplateRows = '0fr';
        chevron.classList.remove('rotate-180');
      }
    }, { signal });
  }

  function initDetailPage() {
    if (detailPageAbortController) {
      detailPageAbortController.abort();
      detailPageAbortController = null;
    }

    const root = document.getElementById('package-detail-root');
    if (!root) return;

    const basePrice = Number(root.dataset.basePrice) || 0;
    const packageName = root.dataset.packageName || '';
    const minOrder = Number(root.dataset.minOrder) || 1;
    const phone = root.dataset.phone || '';
    const hasMenuSelection = root.dataset.hasMenuSelection === 'true';
    const sideDishesMin = Number(root.dataset.sideDishesMin) || 0;
    const sideDishesMax = Number(root.dataset.sideDishesMax) || 0;
    const defaultMainMenu = root.dataset.defaultMainMenu || '';
    let defaultSideDishes: string[] = [];
    try {
      defaultSideDishes = JSON.parse(root.dataset.defaultSideDishes || '[]');
    } catch {
      defaultSideDishes = [];
    }
    const minEventDateString = root.dataset.minEventDate || '';

    const config: PackageConfig = {
      basePrice,
      packageName,
      minOrder,
      phone,
      hasMenuSelection,
      sideDishesMin,
      sideDishesMax,
      defaultMainMenu,
      defaultSideDishes,
      minEventDateString,
    };

    detailPageAbortController = new AbortController();
    const { signal } = detailPageAbortController;

    initPortionCalculator(config, signal);
    initCompositionToggle(signal);
  }

  let isDetailPageLoaded = false;

  document.addEventListener('astro:page-load', () => {
    isDetailPageLoaded = true;
    initDetailPage();
  });

  document.addEventListener('astro:before-swap', () => {
    if (detailPageAbortController) {
      detailPageAbortController.abort();
      detailPageAbortController = null;
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if (!isDetailPageLoaded) {
        initDetailPage();
      }
    }, { once: true });
  } else if (!isDetailPageLoaded) {
    initDetailPage();
  }
</script>
