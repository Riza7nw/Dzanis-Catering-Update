---
// src/pages/sertifikat.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/organic/Navbar.astro';
import Footer from '../components/organic/Footer.astro';
import CertHero from '../components/sertifikat/CertHero.astro';
import CertShowcaseGrid from '../components/sertifikat/CertShowcaseGrid.astro';
import CertVerificationGuide from '../components/sertifikat/CertVerificationGuide.astro';
import CertB2BProcurementCta from '../components/sertifikat/CertB2BProcurementCta.astro';
import CertLightboxModal from '../components/sertifikat/CertLightboxModal.astro';
import { getShowcaseCertificates, getLegalDocuments } from '../services/api/certService';

const publicApiUrl = import.meta.env.PUBLIC_API_URL || '';
const [showcaseCerts, legalDocs] = await Promise.all([
  getShowcaseCertificates(),
  getLegalDocuments(),
]);
---

<BaseLayout 
  title="Sertifikat & Legalitas Resmi | Dzanis Catering Majalengka"
  description="Bukti nyata komitmen kualitas dan keamanan pangan Dzanis Catering: Sertifikat Halal BPJPH, SLHS Dinas Kesehatan Majalengka, dan Izin Usaha NIB OSS-RBA resmi."
>
  <Navbar />

  <main id="konten" class="bg-bg text-text min-h-screen w-full max-w-full min-w-0 flex-1 overflow-x-clip">
    <!-- 1. Hero & Trust Metric Matrix -->
    <CertHero />

    <!-- 2. Primary Showcase Grid (SSR-First & Filterable) -->
    <CertShowcaseGrid 
      certificates={showcaseCerts} 
      legalDocuments={legalDocs} 
      publicApiUrl={publicApiUrl}
    />

    <!-- 3. Verification Guide (Cek Mandiri di Portal Resmi) -->
    <CertVerificationGuide />

    <!-- 4. Flow-to-Action for B2B/B2G & Procurement Consultation -->
    <CertB2BProcurementCta />
  </main>

  <Footer />

  <!-- Single Source of Truth Lightbox Modal -->
  <CertLightboxModal />

  <!-- Real-time synchronization client script if backend updates -->
  <script is:inline define:vars={{ publicApiUrl }}>
    (async function syncDynamicCerts() {
      try {
        const hostname = window.location.hostname;
        const isLocal = hostname === 'localhost' || hostname === '127.0.0.1' || hostname.startsWith('192.168.') || hostname.startsWith('10.') || hostname.endsWith('.local');
        const defaultLocalApi = `${window.location.protocol}//${hostname || '127.0.0.1'}:8000`;
        const apiUrl = publicApiUrl || (isLocal ? defaultLocalApi : '');
        if (!apiUrl) return;

        const res = await fetch(`${apiUrl}/api/certifications?active=true`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) return;

        const contentType = res.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) return;

        const data = await res.json();
        const certs = Array.isArray(data)
          ? data
          : (Array.isArray(data.certifications) ? data.certifications : (Array.isArray(data.data) ? data.data : []));

        if (!certs || certs.length === 0) return;
        console.log('[Dzanis Certs] Sinkronisasi aktif:', certs.length, 'dokumen termutakhir.');
      } catch (err) {
        // Fallback senyap ke SSR data
      }
    })();
  </script>
</BaseLayout>
